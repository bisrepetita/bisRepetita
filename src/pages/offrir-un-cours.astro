---
// Bon cadeau : formats et prix de la grille (/tarifs), pas de montant libre ni de durée de validité affichée.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/widgets/Hero.astro";
import Schema from "../components/seo/Schema.astro";
import { siteConfig } from "../config/site";
import coursPortrait from "../assets/cours-portrait.webp";

const metadata = {
    title: "Offrir un cours de boxe à Genève",
    description:
        "Offrez un cours de boxe à Genève : un bon cadeau en PDF au nom de la personne, pour le format de votre choix. Débutants bienvenus, matériel prêté.",
};

const { phone, address } = siteConfig.contact;
const tel = `tel:${phone.replace(/\s/g, "")}`;

const steps = [
    ["Pour qui", "La personne de votre choix. Débutant bienvenu, aucun niveau requis. Un mineur peut en profiter à partir d'un certain âge, avec l'autorisation de ses parents."],
    ["Le format", "Tous les formats de la grille, aux prix de la grille : Round by Round, coaching solo, duo, trio… Pas de montant libre."],
    ["Le bon", "Un PDF au nom de la personne, envoyé par e-mail. Transférable et échangeable contre un autre format, non remboursable."],
    ["Paiement", "En ligne, par virement, Twint ou espèces."],
    ["Réservation", "Avec le coach de son choix : sur le planning en ligne pour le cours collectif, par WhatsApp pour le coaching privé."],
    ["Matériel", "Gants et sous-gants prêtés. Une tenue de sport et des baskets réservées à l'intérieur suffisent."],
    ["Lieu", `Au studio, ${address}.`],
    ["Comment faire", "Écrivez-nous ou appelez-nous. Commandes jusqu'au 22 décembre. Bon réservé aux particuliers : pas d'offre entreprise."],
];
const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Offrir un cours de boxe à Genève",
                description: metadata.description,
                url: "https://bisrepetita.ch/offrir-un-cours",
                serviceType: "Cours de boxe offert",
            }}
        />
    </Fragment>

    <Hero
        title="Offrir un cours de boxe"
        description="Un cours de boxe à offrir, au format de votre choix. Vous choisissez la personne, nous vous envoyons le bon à son nom."
        actions={[
            { text: "Nous écrire", href: "/contact?sujet=offrir" },
            { text: phone, href: tel, ariaLabel: `Appeler le ${phone}` },
        ]}
        image={coursPortrait}
        imageAlt="Nicolas de Boccard tient les pattes d'ours face à une élève au studio"
    />

    <section class="wrap gc">
        <div class="gc-head">
            <h2 class="t-title" data-split>Comment ça se passe</h2>
            <p>Le principe est simple : un bon au nom de la personne, valable pour un cours au studio, collectif ou privé.</p>
        </div>
        <div>
            <dl class="gc-rows">
                {steps.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
            <div class="gc-actions">
                <a href="/contact?sujet=offrir" class="btn btn-solid">Nous écrire <Fragment set:html={arrow} /></a>
                <a href={tel} class="btn btn-line">{phone}</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .gc {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
        gap: 40px clamp(40px, 7vw, 140px);
        align-items: start;
        padding-block: var(--section);
    }
    .gc-head { display: grid; gap: 18px; max-width: 30rem; }
    .gc-head p { color: var(--gray-1); font-size: 17px; }
    .gc-rows { border-top: 1px solid var(--ink); font-size: 16px; }
    .gc-rows div { display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
    .gc-rows dt { color: var(--gray-2); }
    .gc-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
    @media (max-width: 860px) {
        .gc { grid-template-columns: 1fr; }
        .gc-rows div { grid-template-columns: 1fr; gap: 4px; }
    }
</style>
