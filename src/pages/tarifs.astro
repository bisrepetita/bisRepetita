---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/widgets/Hero.astro";
import PricingNav from "../components/widgets/PricingNav.astro";
import QuizFormule from "../components/widgets/QuizFormule.astro";
import FAQ from "../components/widgets/FAQ.astro";
import Schema from "../components/seo/Schema.astro";
import heroImage from "../assets/studio-interior.webp";

const metadata = {
    title: "Tarifs Coaching Boxe Genève",
    description:
        "Transparence et flexibilité. Découvrez les tarifs des coachings solo, duo et cours collectifs à Genève. Studio privé près de la place des Nations.",
};

// --- Nav items ---
const navItems = [
    { label: "Solo", anchorId: "solo" },
    { label: "Duo & Trio", anchorId: "duo-trio" },
    { label: "Small Group", anchorId: "small-group" },
    { label: "Round by Round", anchorId: "boxe-groupe" },
    { label: "À domicile", anchorId: "domicile" },
    { label: "Corporate", anchorId: "corporate" },
];

const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;

// --- Carte des prix (source : docs/tarifs-reference.md) ---
// pack: null = pas de pack 10 pour cette formule.
const sections = [
    {
        id: "solo",
        title: "Coaching privé : tarifs des séances individuelles à Genève",
        text: "Chaque séance inclut un suivi personnalisé et s'adapte à votre état du jour.",
        link: { href: "/services/coaching-solo", text: "Le coaching solo" },
        rows: [{ f: "Solo", d: "1 personne · 60 min", s: "CHF 120", p: "CHF 1’100" }],
    },
    {
        id: "duo-trio",
        title: "Duo & Trio : tarifs du coaching partagé",
        text: "La qualité du privé, à deux ou à trois. Prix total de la séance, à partager.",
        link: { href: "/services/coaching-duo-trio", text: "Le coaching duo & trio" },
        rows: [
            { f: "Duo", d: "2 personnes · 60 min", s: "CHF 140", p: "CHF 1’300" },
            { f: "Trio", d: "3 personnes · 60 min", s: "CHF 160", p: "CHF 1’500" },
        ],
    },
    {
        id: "small-group",
        title: "Small Group Training : tarifs petit groupe",
        text: "De 2 à 8 personnes, en groupe stable, pour que Nicolas puisse corriger chaque mouvement. Prix du groupe pour la séance, à partager.",
        link: { href: "/services/small-group-training", text: "Le small group training" },
        rows: [{ f: "Small Group", d: "2 à 8 personnes · 60 min · prix du groupe", s: "CHF 200", p: "CHF 1’800" }],
    },
    {
        id: "boxe-groupe",
        title: "Cours collectifs Round by Round : tarifs boxe Genève",
        text: "Ouvert à tous les niveaux, sans combat ni prérequis. Un coach, 8 personnes au plus. Première séance offerte ; packs et abonnements disponibles, écrivez-nous.",
        link: { href: "/services/round-by-round", text: "Le cours Round by Round" },
        rows: [{ f: "Round by Round", d: "1 coach · 50 min · 8 personnes au plus · prix à la séance", s: "CHF 40", p: "sur demande" }],
    },
    {
        id: "domicile",
        title: "Coaching de boxe à domicile",
        text: "Le coach et le matériel viennent chez vous, dans le canton de Genève. Au-delà, sur devis.",
        link: { href: "/services/coaching-boxe-domicile", text: "Le coaching à domicile" },
        rows: [
            { f: "Solo", d: "1 personne", s: "dès CHF 150", p: null },
            { f: "Duo", d: "2 personnes", s: "dès CHF 170", p: null },
            { f: "Trio", d: "3 personnes", s: "dès CHF 190", p: null },
        ],
    },
];

const corporate = [
    ["Pour", "Team building, bien-être, cohésion d'équipe"],
    ["Lieu", "Au studio ou dans vos locaux, jusqu'à 30 km autour du canton de Genève (pas en France)"],
    ["Formats", "Séance unique, programme récurrent ou événement"],
    ["Matériel", "Fourni pour tous les participants"],
    ["Tarif", "Entre CHF 220 et 600 la séance selon le format, devis sous 48 h"],
    ["Facturation", "Facture entreprise, paiement avant la séance"],
];

// Conditions (essai gratuit : Round by Round seulement, voir FAQ).
const conditions = [
    ["Matériel", "Gants (12 et 14 oz) et sous-gants prêtés. Venez en tenue de sport, avec des baskets réservées à l'intérieur."],
    ["Vestiaires", "Deux vestiaires, femmes et hommes, avec une douche dans chacun."],
    ["Suivi", "Un programme adapté à vos objectifs, à votre niveau et à vos contraintes."],
    ["Packs", "Valables 6 mois dès la date d'achat. Sans abonnement."],
    ["Annulation", "Gratuite jusqu'à 24 h avant la séance."],
    ["Paiement", "Virement bancaire, Twint ou espèces."],
    ["Prix", "En CHF, TTC."],
    ["Studio", "La Voie-Creuse 16, 1202 Genève."],
];

// --- FAQ enrichie ---
const faqs = [
    {
        question: "Proposez-vous une séance d'essai ?",
        answer: "Oui, pour Round by Round : votre première séance est offerte, vous réservez directement un créneau, sans prérequis. <a href='/#planning' class='link-line'>Voir le planning</a>. En coaching privé, il n'y a pas d'essai gratuit : la première séance se paie au tarif du format et commence par un échange sur vos objectifs, votre passé sportif et vos blessures éventuelles.",
    },
    {
        question: "Les packs ont-ils une date d'expiration ?",
        answer: "Les packs de séances sont valables 6 mois à compter de la date d'achat. Ce délai permet de maintenir une régularité d'entraînement tout en restant flexible.",
    },
    {
        question: "Peut-on partager un pack avec son conjoint ou un ami ?",
        answer: "Les packs de coaching privé sont nominatifs. Pour vous entraîner ensemble, optez pour les séances Duo ou Trio qui offrent un tarif groupé avantageux.",
    },
    {
        question: "Quels modes de paiement acceptez-vous ?",
        answer: "Nous acceptons les paiements par virement bancaire, Twint et espèces. Pour les entreprises, la facture est réglée avant la séance.",
    },
    {
        question: "Comment fonctionne la facturation corporate ?",
        answer: "Les <a href='/services/corporate' class='text-primary hover:underline'>programmes corporate</a> font l'objet d'un devis personnalisé, envoyé sous 48 h : entre CHF 220 et 600 la séance selon le format. La facture est réglée avant la séance. <a href='/contact' class='text-primary hover:underline'>Contactez-nous</a> pour en discuter.",
    },
    {
        question: "Les séances de coaching sont-elles déductibles des impôts ou prises en charge par l'assurance à Genève ?",
        answer: "À Genève, les frais de coaching sportif ne sont généralement pas déductibles des impôts pour les particuliers. Bis Repetita n'a pas de label reconnu par les assurances complémentaires : ne comptez pas sur une prise en charge, et vérifiez auprès de votre assureur.",
    },
    {
        question: "Quelle est votre politique d'annulation ?",
        answer: "Toute annulation effectuée au moins 24 heures à l'avance est gratuite. En cas d'annulation tardive (moins de 24h) ou de no-show, la séance est décomptée du pack. Nous comprenons les imprévus — contactez-nous en cas de circonstances exceptionnelles.",
    },
    {
        question: "Où se situe le studio ? Est-il facile d'accès depuis les Eaux-Vives, Plainpalais ou Cologny ?",
        answer: "Le studio Bis Repetita est situé à La Voie-Creuse 16, 1202 Genève. Facilement accessible en transports publics depuis les Eaux-Vives, Plainpalais, Cologny et Carouge (arrêt à proximité). Parking disponible à quelques minutes à pied. <a href='/contact#map' class='text-primary hover:underline'>Voir le plan d'accès</a>.",
    },
];

// --- OfferCatalog data ---
const offers = [
    { name: "Coaching Privé 1:1", description: "Séances individuelles de boxe avec programme personnalisé à Genève.", url: "/services/coaching-solo" },
    { name: "Coaching Duo & Trio", description: "Coaching privé partagé à 2 ou 3 personnes.", url: "/services/coaching-duo-trio" },
    { name: "Small Group Training", description: "Coaching en petit groupe stable, de 2 à 8 personnes.", url: "/services/small-group-training" },
    { name: "Round by Round", description: "Cours collectifs de boxe accessibles à tous, sans combat.", url: "/services/round-by-round" },
    { name: "Programme Corporate", description: "Boxe en entreprise à Genève — team building et bien-être au travail.", url: "/services/corporate" },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema type="FAQPage" data={{ faqs: faqs.map(f => ({ question: f.question, answer: f.answer.replace(/<[^>]*>/g, '') })) }} />
        <Schema type="OfferCatalog" data={{ offers }} />
        <Schema type="BreadcrumbList" data={{ breadcrumbs: [{ name: "Accueil", href: "/" }, { name: "Tarifs", href: "/tarifs" }] }} />
    </Fragment>

    <Hero
        title={`Tarifs et <span class="text-primary">Formules</span>`}
        description="Des prix clairs pour chaque format : coaching privé, duo, petit groupe, cours collectif, à domicile ou en entreprise."
        actions={[
            { text: "Réserver une séance", href: "/#planning" },
            { text: "Trouver ma formule", href: "#quiz" },
        ]}
        image={heroImage}
        imageAlt="La salle du studio Bis Repetita à Genève"
    />

    <PricingNav items={navItems} />

    <QuizFormule />

    {sections.map((sec) => (
        <section id={sec.id} class="wrap tf-sec">
            <div class="tf-head">
                <h2 class="t-subtitle" data-split>{sec.title}</h2>
                <p>{sec.text}</p>
                <a href={sec.link.href} class="link-line tf-more">{sec.link.text}</a>
            </div>
            <table class="tf-table">
                <thead>
                    <tr><th scope="col">Formule</th><th scope="col">Séance</th><th scope="col">Pack 10</th></tr>
                </thead>
                <tbody>
                    {sec.rows.map((r) => (
                        <tr>
                            <th scope="row"><span class="tf-f">{r.f}</span><span class="tf-d">{r.d}</span></th>
                            <td>{r.s}</td>
                            <td>{r.p ?? <><span aria-hidden="true">—</span><span class="sr-only">Pas de pack</span></>}</td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </section>
    ))}

    <section id="corporate" class="wrap tf-sec">
        <div class="tf-head">
            <h2 class="t-subtitle" data-split>Programme corporate : boxe en entreprise à Genève</h2>
            <p>Des cours de boxe construits pour vos collaborateurs.</p>
            <a href="/services/corporate" class="link-line tf-more">Les programmes corporate</a>
        </div>
        <div>
            <dl class="tf-rows">
                {corporate.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
            <a href="/contact?sujet=devis-corporate" class="btn btn-solid tf-btn">Demander un devis <Fragment set:html={arrow} /></a>
        </div>
    </section>

    <section class="wrap tf-sec">
        <div class="tf-head">
            <h2 class="t-subtitle" data-split>Inclus dans chaque formule</h2>
            <p>Et les conditions, pour tous les formats.</p>
        </div>
        <dl class="tf-rows">
            {conditions.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
    </section>

    <FAQ
        title="Questions fréquentes sur les tarifs"
        subtitle="Formules, packs, paiement et conditions."
        items={faqs}
    />

    <section class="wrap tf-end">
        <h2 class="t-title" data-split>Prêt à commencer ?</h2>
        <div class="tf-end-side">
            <p>Choisissez un créneau dans le planning, ou écrivez-nous pour trouver le bon format.</p>
            <div class="tf-actions">
                <a href="/#planning" class="btn btn-solid">Réserver une séance <Fragment set:html={arrow} /></a>
                <a href="/contact" class="btn btn-line">Nous écrire</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .tf-sec {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
        gap: 40px clamp(40px, 7vw, 140px);
        align-items: start;
        padding-block: clamp(48px, 6vw, 88px);
        border-top: 1px solid var(--line);
        scroll-margin-top: calc(var(--nav-h) + 48px);
    }
    .tf-head { display: grid; gap: 14px; justify-items: start; max-width: 30rem; }
    .tf-head p { color: var(--gray-1); font-size: 16px; }
    .tf-more { font-size: 14px; }

    .tf-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
    .tf-table thead th {
        font-size: 13px;
        font-weight: 400;
        color: var(--gray-2);
        text-align: right;
        padding: 0 0 12px 16px;
        white-space: nowrap;
        border-bottom: 1px solid var(--ink);
    }
    .tf-table thead th:first-child { text-align: left; padding-left: 0; }
    .tf-table tbody th, .tf-table td { padding: 22px 0 22px 16px; border-bottom: 1px solid var(--line); vertical-align: baseline; }
    .tf-table tbody th { text-align: left; font-weight: 400; padding-left: 0; }
    .tf-table td { text-align: right; white-space: nowrap; font-size: clamp(1.125rem, 1.6vw, 1.375rem); font-weight: 500; letter-spacing: -0.02em; width: 9.5em; }
    .tf-f { display: block; font-size: clamp(1.125rem, 1.6vw, 1.375rem); font-weight: 500; letter-spacing: -0.02em; }
    .tf-d { display: block; margin-top: 4px; font-size: 14px; color: var(--gray-2); }

    .tf-rows { border-top: 1px solid var(--ink); font-size: 15px; }
    .tf-rows div { display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .tf-rows dt { color: var(--gray-2); }
    .tf-btn { margin-top: 32px; }

    .tf-end {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 32px clamp(40px, 7vw, 140px);
        align-items: end;
        padding-block: var(--section);
        border-top: 1px solid var(--line);
    }
    .tf-end-side { display: grid; gap: 22px; max-width: 30rem; }
    .tf-end-side p { color: var(--gray-1); font-size: 17px; }
    .tf-actions { display: flex; flex-wrap: wrap; gap: 10px; }

    @media (max-width: 860px) {
        .tf-sec, .tf-end { grid-template-columns: 1fr; }
        .tf-table td { width: auto; }
        .tf-rows div { grid-template-columns: minmax(0, 7rem) minmax(0, 1fr); }
    }
</style>

