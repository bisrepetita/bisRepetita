---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/widgets/Hero.astro";
import EquipmentPanels from "../components/widgets/EquipmentPanels.astro";
import FAQ from "../components/widgets/FAQ.astro";
import RelatedArticles from "../components/widgets/RelatedArticles.astro";
import CTABanner from "../components/widgets/CTABanner.astro";
import Schema from "../components/seo/Schema.astro";
import { siteConfig } from "../config/site";

import { Image } from "astro:assets";
import studioHero from "../assets/studio-hero.webp";
import coursPortrait from "../assets/cours-portrait.webp";
import salle1 from "../assets/salle-1.webp";
import cours2Landscape from "../assets/cours-2-landscape.webp";
import imageCta from "../assets/image-cta.webp";
import lionelNicolas from "../assets/lionel-nicolas-boxe.webp";
import ambianceBis from "../assets/ambiance-bis-repetita.webp";

const metadata = {
    title: "Salle de Boxe à Genève — Studio Privé La Voie-Creuse | Bis Repetita",
    description:
        "Visitez notre salle de boxe au cœur de Genève : ring professionnel, 150 m² d'espace, vestiaires haut de gamme. La Voie-Creuse 16, 1202 Genève. Horaires et accès.",
    ignoreTitleTemplate: true,
};

const phone = siteConfig.contact.phone;
const contactRows = [
    { k: "Adresse", v: siteConfig.contact.address },
    { k: "Téléphone", v: phone, href: `tel:${phone.replace(/\s/g, "")}` },
    { k: "E-mail", v: siteConfig.contact.email, href: `mailto:${siteConfig.contact.email}` },
    { k: "Bus", v: "1, 25, arrêt Sécheron" },
    { k: "Tram", v: "15, arrêt France" },
    { k: "Parking", v: "À proximité (Sécheron)" },
];

// TODO: confirmer les horaires avec Nicolas
const hours = [
    { k: "Lundi à vendredi", v: "7 h – 21 h" },
    { k: "Samedi", v: "9 h – 17 h" },
    { k: "Dimanche", v: "Fermé" },
];

const partners = [
    { name: "Improov Studio", address: "Ruelle du Couchant 11, Genève", href: "https://www.improov.ch" },
    { name: "Fancy Studio", address: "Rue des Chaudronniers 8, Genève", href: "https://www.fancy.yoga/" },
];

const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;

const faqs = [
    {
        question: "Où se situe le studio Bis Repetita à Genève ?",
        answer: "Le studio est situé au <strong>La Voie-Creuse 16, 1202 Genève</strong>, à proximité de la gare Cornavin et des transports publics. Un parking est disponible à proximité.",
    },
    {
        question: "Faut-il un niveau minimum pour s'inscrire ?",
        answer: "Aucun niveau n'est requis. Que vous soyez débutant ou confirmé, nos programmes s'adaptent à vous : <a href='/services/coaching-prive' class='link-line'>coaching privé</a> pour un suivi personnalisé ou <a href='/services/round-by-round' class='link-line'>cours collectifs Round by Round</a> pour une expérience en groupe.",
    },
    {
        question: "Quel équipement dois-je apporter ?",
        answer: "Venez simplement avec une tenue de sport confortable et une bouteille d'eau. Les gants, bandes et tout le matériel d'entraînement sont fournis par le studio.",
    },
    {
        question: "Comment réserver une séance ?",
        answer: "Vous pouvez réserver directement via notre <a href='/contact' class='link-line'>formulaire de contact</a> ou par téléphone. Nous vous recommandons de commencer par une séance découverte pour vous familiariser avec le studio.",
    },
    {
        question: "Proposez-vous des programmes pour les entreprises ?",
        answer: "Oui, nous proposons des <a href='/services/corporate' class='link-line'>programmes corporate</a> sur mesure : team building, séances bien-être et événements d'entreprise dans notre studio à Genève.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema type="SportsActivityLocation" data={{ image: studioHero.src, url: "/studio" }} />
        <Schema type="FAQPage" data={{ faqs: faqs.map(f => ({ question: f.question, answer: f.answer.replace(/<[^>]*>/g, '') })) }} />
    </Fragment>

    <Hero
        title={`La salle de <span class="text-primary">boxe d'exception</span><br/>de Genève`}
        description="Une salle privée dédiée à la boxe, au cœur de Genève. Un ring, des sacs, des vestiaires avec douches."
        image={studioHero}
        imageAlt="Travail aux pattes d'ours dans la salle du studio Bis Repetita"
        locationBadge={{ text: "La Voie-Creuse 16, 1202 Genève" }}
        actions={[
            { text: "Réserver une séance", href: "/#planning" },
            { text: "Venir au studio", href: "#acces" },
        ]}
    />

    <section class="section wrap about">
        <h2 class="t-title" data-split>Un espace conçu pour la boxe</h2>
        <div class="about-text">
            <p class="t-lead">
                Le studio se trouve dans le quartier de Sécheron.
                <span class="soft">Une salle réservée à la boxe : un ring, des sacs de frappe, un espace d'entraînement et des vestiaires.</span>
            </p>
            <p>Un cadre privé, à l'écart des salles bondées. Le coach s'occupe de vous, pas d'une foule.</p>
        </div>
    </section>

    <section id="acces" class="section wrap rule-t access">
        <div class="access-head">
            <h2 class="t-title" data-split>Un studio principal, des espaces partenaires</h2>
            <p>Notre base est à La Voie-Creuse 16 : un espace privé, avec un ring, pensé pour l'entraînement.</p>
            <p>Pour ceux qui préfèrent un lieu en centre-ville, nous travaillons aussi dans deux studios partenaires.</p>
        </div>
        <div class="access-grid">
            <div class="access-map">
                <iframe
                    src={siteConfig.maps.embedUrl}
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Bis Repetita — Studio de boxe à Genève"
                ></iframe>
            </div>
            <div class="access-info">
                <h3 class="t-meta">Adresse et accès</h3>
                <dl class="rows">
                    {contactRows.map((r) => (
                        <div><dt>{r.k}</dt><dd>{r.href ? <a href={r.href} class="link-line">{r.v}</a> : r.v}</dd></div>
                    ))}
                </dl>
                <h3 class="t-meta">Horaires</h3>
                <dl class="rows">
                    {hours.map((r) => (
                        <div><dt>{r.k}</dt><dd>{r.v}</dd></div>
                    ))}
                </dl>
            </div>
        </div>
        <ul class="partners">
            {partners.map((p) => (
                <li>
                    <a href={p.href} target="_blank" rel="noopener noreferrer" class="partner-row">
                        <span class="pr-t">{p.name}</span>
                        <span class="pr-d">{p.address}</span>
                        <span class="pr-a">Découvrir le studio <Fragment set:html={arrow} /></span>
                    </a>
                </li>
            ))}
            <li>
                <a href="/contact" class="partner-row">
                    <span class="pr-t">Un autre lieu ?</span>
                    <span class="pr-d">Nous avons accès à d'autres espaces à Genève.</span>
                    <span class="pr-a">Contactez-nous <Fragment set:html={arrow} /></span>
                </a>
            </li>
        </ul>
    </section>

    <section class="wrap gallery" aria-label="Photos du studio">
        <div class="g-a nb" data-photo-reveal>
            <Image src={cours2Landscape} alt="Cours collectif dans la salle du studio Bis Repetita" widths={[800, 1200, 1600]} sizes="(max-width: 860px) 100vw, 64vw" loading="lazy" />
        </div>
        <div class="g-b nb" data-photo-reveal>
            <Image src={coursPortrait} alt="Nicolas de Boccard aux pattes d'ours face à une élève" widths={[500, 800]} sizes="(max-width: 860px) 100vw, 32vw" loading="lazy" />
        </div>
        <div class="g-c nb" data-photo-reveal>
            <Image src={ambianceBis} alt="Échauffement à la corde à sauter au studio" widths={[500, 800]} sizes="(max-width: 860px) 100vw, 32vw" loading="lazy" />
        </div>
        <div class="g-d nb" data-photo-reveal>
            <Image src={imageCta} alt="Travail aux pattes d'ours entre deux boxeurs" widths={[800, 1200, 1600]} sizes="(max-width: 860px) 100vw, 64vw" loading="lazy" />
        </div>
    </section>

    <EquipmentPanels
        title="Un studio équipé pour la boxe"
        subtitle="Le matériel qu'il faut pour s'entraîner, au cœur de Genève."
        panels={[
            {
                title: "Un ring",
                description: "Pour le travail aux pattes, le sparring encadré, le coaching privé et les cours Round by Round.",
                image: lionelNicolas,
                alt: "Deux coachs font le point au bord du ring du studio",
            },
            {
                title: "Sacs et matériel",
                description: "Sacs de frappe, pattes d'ours, speed bags et matériel de renforcement.",
                image: imageCta,
                alt: "Travail aux pattes d'ours au studio",
            },
            {
                title: "Vestiaires",
                description: "Douches, casiers et serviettes.",
                image: salle1,
                alt: "Serviettes pliées au vestiaire du studio",
            },
            {
                title: "Espace d'entraînement",
                description: "Des zones pour l'échauffement, le renforcement, le travail au sac et le ring.",
                image: cours2Landscape,
                alt: "Cours collectif dans l'espace d'entraînement du studio",
            },
        ]}
    />

    <section class="section wrap rule-t programs">
        <h2 class="t-title" data-split>S'entraîner à La Voie-Creuse</h2>
        <div class="programs-side">
            <p>Coaching privé, cours collectifs Round by Round ou séances corporate : tous nos programmes ont lieu dans ce studio.</p>
            <a href="/services" class="link-line">Découvrir tous nos programmes</a>
        </div>
    </section>

    <RelatedArticles title="Studio privé vs salle classique : le match" />

    <FAQ
        title="Questions fréquentes"
        subtitle="Notre studio de boxe à Genève, en pratique."
        items={faqs}
    />

    <CTABanner
        title="Venir s'entraîner au studio"
        cta={{ text: "Réserver une séance", href: "/#planning" }}
        variant="brushed-full"
    />
</BaseLayout>

<style>
    .about, .programs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 32px clamp(40px, 8vw, 160px); align-items: start; }
    .about-text { display: grid; gap: 24px; }
    .about-text > p:last-child, .programs-side p, .access-head p { color: var(--gray-1); max-width: 52ch; }
    .programs-side { display: grid; gap: 20px; justify-items: start; }

    .access-head { display: grid; gap: 16px; max-width: 760px; margin-bottom: clamp(40px, 5vw, 72px); }
    .access-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 32px clamp(32px, 5vw, 96px); }
    .access-map { min-height: 420px; background: var(--surface); }
    .access-map iframe { display: block; width: 100%; height: 100%; min-height: 420px; filter: grayscale(1); }
    .access-info { display: grid; gap: 16px; align-content: start; }
    .access-info .rows + h3 { margin-top: 24px; }
    .rows { border-top: 1px solid var(--line); font-size: 14px; }
    .rows div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .rows dt { color: var(--gray-2); flex-shrink: 0; }
    .rows dd { text-align: right; overflow-wrap: anywhere; }

    .partners { margin-top: clamp(48px, 6vw, 88px); border-top: 1px solid var(--ink); }
    .partner-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) auto;
        gap: 8px 24px;
        align-items: baseline;
        padding: 22px 0;
        border-bottom: 1px solid var(--line);
    }
    .pr-t { font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 500; letter-spacing: var(--track-title); }
    .pr-d { color: var(--gray-1); font-size: 15px; }
    .pr-a { display: inline-flex; gap: 8px; align-items: center; font-size: 14px; }

    .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 24px); padding-bottom: var(--section); }
    .gallery > div { position: relative; overflow: hidden; background: var(--surface); }
    .gallery :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .g-a, .g-d { grid-column: span 2; aspect-ratio: 16 / 10; }
    .g-b :global(img), .g-c :global(img) { position: absolute; inset: 0; }

    @media (max-width: 860px) {
        .about, .programs, .access-grid, .gallery { grid-template-columns: 1fr; }
        .g-a, .g-d { grid-column: auto; }
        .g-b, .g-c { aspect-ratio: 4 / 5; }
        .partner-row { grid-template-columns: 1fr; }
    }
</style>
