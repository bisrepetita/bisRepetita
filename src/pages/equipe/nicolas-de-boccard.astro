---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import RelatedArticles from "../../components/widgets/RelatedArticles.astro";
import Schema from "../../components/seo/Schema.astro";
import { getAuthor } from "../../config/authors";
import portrait from "../../assets/nicolas-de-boccard.webp";
import coursPortrait from "../../assets/cours-portrait.webp";

const nicolas = getAuthor("Nicolas de Boccard");
if (!nicolas) {
    throw new Error("Profil 'Nicolas de Boccard' introuvable dans src/config/authors.ts");
}

const metadata = {
    title:
        "Nicolas de Boccard — Head Coach & Fondateur de Bis Repetita | Boxe Genève",
    description:
        "Nicolas de Boccard, fondateur de Bis Repetita à Genève. 20 ans de pratique de la boxe, 100+ élèves accompagnés. Découvrez son parcours et son approche.",
    ignoreTitleTemplate: true,
};

// Seule formulation autorisée pour les durées : « 20 ans de pratique » (durée à la tête du studio inconnue : ne pas en écrire).
const facts = [
    { k: "Discipline", v: "Boxe anglaise" },
    { k: "Pratique", v: "20 ans de pratique" },
    { k: "Formation", v: "Cercle des Sports de Genève" },
    { k: "Rôle", v: "Head Coach et fondateur" },
    { k: "Adresse", v: "La Voie-Creuse 16, Genève" },
];

// Bio écrite ici plutôt que authors.longBio, qui contient encore des formulations retirées
// (« plus de 20 ans », « une centaine d'élèves »).
const bio = [
    "Genevois, Nicolas compte 20 ans de pratique de la boxe anglaise. Une discipline découverte jeune, qui a façonné sa rigueur, sa patience et sa lecture du corps en mouvement.",
    "Il a fondé Bis Repetita à La Voie-Creuse, à Genève, pour offrir un studio à la hauteur de la discipline : exigeant sur la technique, attentif à la progression de chacun, soigné dans son cadre.",
    "Sa méthode associe le travail technique de la boxe anglaise, une préparation physique adaptée à l'âge et au profil de chaque élève, et une attention au mental : la séance sert à reprendre la main sur son corps, son souffle et sa concentration.",
    "Au studio, il accompagne des profils très différents : cadres et dirigeants qui cherchent un sport qui décompresse vraiment, femmes qui veulent reprendre confiance dans leur corps, débutants complets. Le cadre reste le même pour tous : net, exigeant et bienveillant.",
];

const pillars = [
    {
        title: "La base technique",
        description:
            "Posture, déplacements, lecture de la garde adverse : la base se travaille à chaque séance, à n'importe quel niveau.",
    },
    {
        title: "Préparation physique adaptée",
        description:
            "Charge de travail calibrée selon l'âge, le profil et l'objectif. Pas de programme générique recyclé.",
    },
    {
        title: "Le mental comme outil",
        description:
            "La séance sert à reprendre la main sur son corps, son souffle et sa concentration. La confiance suit, pas l'inverse.",
    },
    {
        title: "Une progression suivie",
        description:
            "Le studio reçoit des profils très différents. Chaque progression est suivie individuellement, séance après séance.",
    },
];

const faqs = [
    {
        question: "Comment Nicolas adapte-t-il une séance pour un débutant complet ?",
        answer: "La première séance commence par les fondamentaux : garde, déplacements, premier direct. Pas de sparring, pas de matériel imposé. Le rythme s'adapte au souffle et à la coordination du jour, pas à un planning figé. Les détails techniques arrivent quand la base tient debout.",
    },
    {
        question: "Quel format choisir entre coaching solo, duo ou collectif ?",
        answer: "Le <a href='/services/coaching-solo' class='text-primary hover:underline'>coaching solo</a> est le format le plus précis pour progresser vite. Le <a href='/services/coaching-duo-trio' class='text-primary hover:underline'>duo ou trio</a> garde l'attention privée tout en partageant les exercices. Les <a href='/services/round-by-round' class='text-primary hover:underline'>cours collectifs Round by Round</a> conviennent quand l'énergie de groupe motive plus que le suivi individuel.",
    },
    {
        question: "Coache-t-il aussi des compétiteurs amateurs ?",
        answer: "Oui. Nicolas accompagne plusieurs compétiteurs amateurs en préparation : travail technique pied-poing, sparring contrôlé sur le ring du studio, préparation physique spécifique. Le <a href='/services/coaching-prive' class='text-primary hover:underline'>coaching privé</a> est le format adapté à ce niveau d'exigence.",
    },
    {
        question: "Travaille-t-il avec des entreprises et des équipes ?",
        answer: "Le studio propose des <a href='/services/corporate' class='text-primary hover:underline'>programmes corporate</a> : team building, séances bien-être, événements d'entreprise. Nicolas anime personnellement la majorité de ces sessions à La Voie-Creuse ou en intervention sur site.",
    },
    {
        question: "Comment réserver une séance avec Nicolas ?",
        answer: "Le plus simple : passer par le <a href='/contact' class='text-primary hover:underline'>formulaire de contact</a> ou directement par téléphone. En <a href='/services/round-by-round' class='text-primary hover:underline'>Round by Round</a>, la première séance est offerte et sans prérequis. En coaching privé, la première séance commence par un échange sur vos objectifs, au <a href='/tarifs' class='text-primary hover:underline'>tarif du format</a>.",
    },
];

const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;

const sameAs = [
    nicolas.socialLinks.linkedin,
    nicolas.socialLinks.instagram,
].filter((u): u is string => Boolean(u));
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Person"
            data={{
                title: nicolas.name,
                description: nicolas.shortBio,
                image: nicolas.image.src,
                pageUrl: nicolas.pageUrl,
                jobTitle: nicolas.jobTitle,
                sameAs,
                knowsAbout: nicolas.expertise,
            }}
        />
        <Schema
            type="FAQPage"
            data={{
                faqs: faqs.map((f) => ({
                    question: f.question,
                    answer: f.answer.replace(/<[^>]*>/g, ""),
                })),
            }}
        />
    </Fragment>

    <section class="nb-hero">
        <div class="wrap nb-head">
            <h1 class="t-display nb-title" data-split>Nicolas <span class="text-primary">de Boccard</span></h1>
            <div class="nb-side">
                <p>Head Coach et fondateur de Bis Repetita, à Genève. 20 ans de pratique.</p>
                <a href="/#planning" class="btn btn-solid">Réserver une séance <Fragment set:html={arrow} /></a>
            </div>
        </div>
    </section>

    <section class="wrap nb-bio">
        <div class="nb-photo nb" data-photo-reveal>
            <Image
                src={portrait}
                alt="Portrait de Nicolas de Boccard, Head Coach et fondateur de Bis Repetita"
                widths={[480, 800, 1024]}
                sizes="(max-width: 860px) 100vw, 45vw"
                loading="eager"
                fetchpriority="high"
            />
        </div>
        <div class="nb-text">
            <h2 class="t-title" data-split>Une boxe <span class="text-primary">technique, exigeante et accessible</span></h2>
            <div class="nb-prose">
                {bio.map((p) => <p>{p}</p>)}
            </div>
            <dl class="nb-facts">
                {facts.map((f) => (
                    <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
                ))}
            </dl>
            {(nicolas.socialLinks.linkedin || nicolas.socialLinks.instagram) && (
                <p class="nb-links">
                    {nicolas.socialLinks.linkedin && (
                        <a href={nicolas.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="link-line" aria-label={`LinkedIn de ${nicolas.name}`}>LinkedIn</a>
                    )}
                    {nicolas.socialLinks.instagram && (
                        <a href={nicolas.socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="link-line" aria-label="Instagram du studio Bis Repetita">Instagram du studio</a>
                    )}
                </p>
            )}
        </div>
    </section>

    <section class="section wrap nb-approach">
        <div>
            <h2 class="t-title" data-split>Quatre piliers, une méthode</h2>
            <div class="nb-photo-sm nb" data-photo-reveal>
                <Image
                    src={coursPortrait}
                    alt="Nicolas de Boccard tient les pattes d'ours face à une élève au studio"
                    widths={[480, 800]}
                    sizes="(max-width: 860px) 100vw, 35vw"
                    loading="lazy"
                />
            </div>
        </div>
        <ol class="nb-pillars">
            {pillars.map((p) => (
                <li><h3>{p.title}</h3><p>{p.description}</p></li>
            ))}
        </ol>
    </section>

    {/* 5. Articles signés */}
    <RelatedArticles title="Articles signés Nicolas" maxItems={3} />

    {/* 6. FAQ */}
    <FAQ
        title="Questions fréquentes"
        subtitle={`Tout ce qu'on demande le plus souvent à Nicolas avant de s'inscrire.`}
        items={faqs}
    />

    <section class="section wrap nb-end">
        <h2 class="t-title" data-split>Boxer avec Nicolas</h2>
        <div class="nb-end-side">
            <p>Une première séance pour faire le point sur vos objectifs et choisir le format qui vous convient.</p>
            <div class="nb-end-actions">
                <a href="/#planning" class="btn btn-solid">Réserver une séance <Fragment set:html={arrow} /></a>
                <a href="/contact" class="btn btn-line">Nous écrire</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .nb-hero { padding-top: clamp(48px, 7vw, 112px); padding-bottom: clamp(48px, 6vw, 96px); }
    .nb-head {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        gap: 32px clamp(32px, 6vw, 120px);
        align-items: end;
    }
    .nb-side { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; max-width: 440px; font-size: 17px; line-height: 1.5; color: var(--gray-1); }

    .nb-bio {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 48px clamp(40px, 7vw, 128px);
        align-items: start;
    }
    .nb-photo { aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); }
    .nb-photo :global(img), .nb-photo-sm :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .nb-text { padding-top: clamp(0px, 2vw, 32px); max-width: 66ch; }
    .nb-text h2 { max-width: 16ch; }
    .nb-prose { margin-top: clamp(32px, 4vw, 48px); font-size: 18px; line-height: 1.6; }
    .nb-prose p + p { margin-top: 1.1em; }
    .nb-facts { margin-top: 48px; border-top: 1px solid var(--line); }
    .nb-facts div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
    .nb-facts dt { color: var(--gray-2); }
    .nb-facts dd { text-align: right; }
    .nb-links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 24px; font-size: 15px; }

    .nb-approach {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
        gap: 48px clamp(40px, 7vw, 128px);
    }
    .nb-approach h2 { max-width: 12ch; }
    .nb-photo-sm { margin-top: 48px; aspect-ratio: 4 / 5; max-width: 420px; overflow: hidden; background: var(--surface); }
    .nb-pillars { border-top: 1px solid var(--line); align-self: start; }
    .nb-pillars li {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 8px 32px;
        padding: 24px 0;
        border-bottom: 1px solid var(--line);
    }
    .nb-pillars h3 { font-size: 19px; line-height: 1.3; letter-spacing: -0.02em; }
    .nb-pillars p { font-size: 16px; line-height: 1.55; color: var(--gray-1); }

    .nb-end {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        gap: 32px clamp(32px, 6vw, 120px);
        align-items: end;
    }
    .nb-end-side { display: flex; flex-direction: column; gap: 24px; font-size: 17px; line-height: 1.5; color: var(--gray-1); max-width: 440px; }
    .nb-end-actions { display: flex; flex-wrap: wrap; gap: 10px; }

    @media (max-width: 860px) {
        .nb-head, .nb-bio, .nb-approach, .nb-end { grid-template-columns: 1fr; }
        .nb-head, .nb-end { align-items: start; }
        .nb-pillars li { grid-template-columns: 1fr; }
    }
</style>
