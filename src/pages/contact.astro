---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/widgets/ContactForm.astro";
import ZenamuCalendar from "../components/widgets/ZenamuCalendar.astro";
import LocationMap from "../components/widgets/LocationMap.astro";

const metadata = {
    title: "Contact & Devis | Studio de Boxe Genève",
    description:
        "Contactez Bis Repetita pour réserver votre séance de boxe à Genève. Coaching privé, duo, trio ou corporate. Demandez votre devis.",
};
---

<BaseLayout {metadata}>
    <ContactForm />

    <ZenamuCalendar />

    <section id="map" class="wrap map-head">
        <h2 class="t-title" data-split>Où trouver le studio <span class="text-primary">Bis Repetita</span> ?</h2>
    </section>
    <LocationMap classes={{ container: "pt-0!" }} />
</BaseLayout>

<style>
    .map-head { padding-top: var(--section); padding-bottom: clamp(32px, 4vw, 56px); scroll-margin-top: var(--nav-h); border-top: 1px solid var(--line); }
    .map-head h2 { max-width: 16ch; }
</style>
