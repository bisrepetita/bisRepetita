---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/widgets/Hero.astro";
import EquipmentPanels from "../components/widgets/EquipmentPanels.astro";
import FAQ from "../components/widgets/FAQ.astro";
import CTABanner from "../components/widgets/CTABanner.astro";
import RelatedArticles from "../components/widgets/RelatedArticles.astro";
import Schema from "../components/seo/Schema.astro";
import coursPortrait from "../assets/cours-portrait.webp";
import cours2Landscape from "../assets/cours-2-landscape.webp";
import ambianceBis from "../assets/ambiance-bis-repetita.webp";
import imageCta from "../assets/image-cta.webp";
import homepage from "../assets/homepage.webp";

const metadata = {
    title: "Cours de Boxe à Genève | Guide Complet 2026",
    description: "Tout savoir sur les cours de boxe à Genève : formats, tarifs, profils, premiers pas. Guide complet par Bis Repetita, studio de boxe sur mesure.",
};

const facts = [
    { k: "Formats", v: "Solo, duo, petit groupe, collectif" },
    { k: "Âge", v: "Aucune limite pour débuter" },
    { k: "Niveau requis", v: "Aucun" },
    { k: "Matériel", v: "Gants et sous-gants prêtés" },
    { k: "Studio", v: "La Voie-Creuse 16, Genève" },
];

const profilPanels = [
    {
        title: "Le débutant curieux",
        description: "Vous n'avez jamais mis les gants ? C'est le profil le plus fréquent chez nous. On part de zéro, sans jugement, à votre rythme.",
        image: coursPortrait,
        alt: "Nicolas de Boccard aux pattes d'ours face à une élève débutante",
        ctaText: "Voir une première séance",
        ctaHref: "#premiere-seance",
    },
    {
        title: "Les femmes qui débutent",
        description: "Cadre privé, intensité ajustée, aucun contact imposé. Pour se tonifier, gagner en cardio et prendre confiance dans le geste.",
        image: cours2Landscape,
        alt: "Cours de boxe au studio Bis Repetita à Genève",
        ctaText: "Lire le guide boxe femme",
        ctaHref: "/blog/boxe-femme-geneve-guide-complet",
    },
    {
        title: "Le sportif en reconversion",
        description: "Coureur, crossfiteur, nageur : vous cherchez un sport technique pour compléter votre pratique. La boxe travaille la coordination, le cardio et la lecture de l'adversaire.",
        image: ambianceBis,
        alt: "Échauffement à la corde à sauter au studio",
    },
    {
        title: "Le compétiteur amateur",
        description: "Vous voulez progresser en sparring encadré, viser la licence SwissBoxing, préparer un combat. Parlons-en avant de commencer.",
        image: imageCta,
        alt: "Travail aux pattes d'ours entre deux boxeurs",
    },
];

const typesDePratique = [
    {
        title: "Boxe fitness et cardio",
        description: "Se dépenser, se tonifier, gagner en cardio. Le travail au sac et aux pattes d'ours, sans aucun contact. Le format le plus simple pour commencer.",
    },
    {
        title: "Boxe technique et progression",
        description: "Les fondamentaux : garde, déplacements, jab, direct, crochet, esquives. Un coach corrige chaque geste, séance après séance.",
    },
    {
        title: "Boxe compétition et sparring",
        description: "Pour ceux qui veulent monter sur le ring. Sparring encadré, préparation physique et mentale, en vue d'un combat amateur.",
    },
];

const firstSession = [
    { t: "Échauffement", d: "Corde à sauter, mobilité, shadow boxing léger. Le coach observe votre posture, votre coordination et votre souffle." },
    { t: "Technique de base", d: "La garde, le jab, le direct arrière, le déplacement latéral. Le coach décompose chaque geste et corrige : appuis, rotation du buste, retour de la main." },
    { t: "Travail aux pattes d'ours", d: "Le coach tient les pattes, vous enchaînez les combinaisons. Vous dosez la puissance et coordonnez bras et jambes." },
    { t: "Retour au calme", d: "Étirements, gainage léger, bilan. Le coach vous donne un ou deux points à travailler la prochaine fois." },
];

const objections = [
    { t: "« Je vais prendre des coups »", d: "Non, et jamais sans votre accord. Un cours débutant se concentre sur la technique : posture, garde, déplacements, frappes au sac et aux pattes d'ours. Le sparring n'existe qu'en séance privée : le coach peut le proposer s'il vous estime prêt, et vous demande si cela vous intéresse." },
    { t: "« J'ai 35 ans, c'est trop tard »", d: "Commencer à 30, 35 ou 40 ans est courant. Vous n'êtes pas là pour devenir champion, mais pour progresser et vous sentir bien. Le coach adapte la séance à votre corps." },
    { t: "« Je n'ai pas le physique »", d: "Personne ne l'a en arrivant. La condition physique se construit avec la pratique. Les premières séances partent de votre niveau réel." },
    { t: "« L'ambiance des clubs me fait peur »", d: "Les clubs associatifs ont parfois une atmosphère compétitive qui ne convient pas à tout le monde. C'est une des raisons d'être du {link} : un espace fermé, un coaching individualisé." },
];

const formats = [
    { t: "Coaching privé", d: "Le format historique de Bis Repetita : un coach, votre rythme, votre programme. Regroupe le solo, le duo, le trio et le petit groupe.", href: "/services/coaching-prive" },
    { t: "Coaching solo", d: "Séance individuelle avec Nicolas de Boccard. 60 minutes, toute l'attention du coach sur votre technique.", href: "/services/coaching-solo" },
    { t: "Coaching duo & trio", d: "Le coaching privé à deux ou trois : même encadrement, coût partagé. Pour les couples, amis ou collègues.", href: "/services/coaching-duo-trio" },
    { t: "Small Group Training", d: "De 2 à 8 personnes, en groupe stable. Entre coaching privé et cours collectif : l'énergie du groupe, un suivi technique précis.", href: "/services/small-group-training" },
    { t: "Coaching à domicile", d: "Le coach vient chez vous, partout dans le canton de Genève, avec le matériel (gants, pattes d'ours, tapis, corde). À Cologny, Versoix, Champel ou Carouge.", href: "/services/coaching-boxe-domicile" },
    { t: "Round by Round", d: "Cours collectif structuré en rounds chronométrés. 8 personnes au plus, un coach, 50 minutes, CHF 40 la séance.", href: "/services/round-by-round" },
    { t: "Corporate et team building", d: "Pour les entreprises genevoises : team building, séances bien-être, masterclass technique. Au studio ou dans vos locaux, de CHF 220 à 600 la séance.", href: "/services/corporate" },
    { t: "Boxe femme", d: "Cadre privé, intensité ajustée, aucun contact imposé. Pour débuter la boxe à Genève en solo, en duo ou en petit groupe.", href: "/services/boxe-femme" },
];

const faqs = [
    {
        question: "Combien coûte un cours de boxe à Genève ?",
        answer: "Les tarifs varient selon le format. Chez Bis Repetita : CHF 40.- pour un cours collectif Round by Round (8 pers. max), CHF 120.- pour un coaching solo, CHF 140.- pour un duo. <a href='/tarifs' class='link-line'>Voir tous les tarifs</a>.",
    },
    {
        question: "À quel âge peut-on commencer la boxe ?",
        answer: "Il n'y a pas d'âge limite pour débuter. La plupart de nos débutants ont entre 27 et 50 ans. La boxe éducative s'adapte à chaque condition physique — l'important est d'être encadré par un professionnel qui ajuste l'intensité.",
    },
    {
        question: "Quel équipement faut-il pour débuter ?",
        answer: "Pour votre première séance : une tenue de sport confortable et des baskets réservées à l'intérieur suffisent. Le studio prête les gants (12 et 14 oz, désinfectés après chaque séance), les sous-gants et tout le matériel technique. Si vous souhaitez acheter vos propres gants par la suite, comptez entre CHF 50 et 80.",
    },
    {
        question: "La boxe est-elle dangereuse pour un débutant ?",
        answer: "Non. La boxe éducative se pratique sans contact entre participants. Tout le travail se fait au sac et aux pattes d'ours tenues par le coach. Le sparring n'existe qu'en séance privée : le coach peut le proposer s'il vous estime prêt, et vous demande si cela vous intéresse. C'est progressif et encadré. <a href='/services/corporate#faq' class='link-line'>En savoir plus sur la sécurité</a>.",
    },
    {
        question: "Combien de séances par semaine pour progresser ?",
        answer: "Deux séances par semaine est le rythme idéal pour un débutant : assez pour progresser, pas assez pour s'épuiser.",
    },
    {
        question: "Comment se passe un premier cours de boxe ?",
        answer: "On commence par un échauffement doux (corde, mobilité), puis on passe aux fondamentaux : position de garde, déplacements, premiers coups sur les pattes d'ours. Le coach ajuste tout en temps réel à votre niveau. <a href='/#planning' class='link-line'>Réserver une séance</a>.",
    },
    {
        question: "Y a-t-il du contact dès le premier cours ?",
        answer: "Non. Nos séances sont sans contact par défaut. Vous frappez le sac et les pattes d'ours, jamais une autre personne. Le sparring n'existe qu'en séance privée : le coach peut le proposer s'il vous estime prêt, et vous demande si cela vous intéresse.",
    },
    {
        question: "La boxe fait-elle maigrir ?",
        answer: "La boxe sollicite tout le corps et le cardio. Combinée à une alimentation équilibrée, elle peut accompagner une perte de poids et aider à se tonifier. La dépense varie selon l'intensité et la personne.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="FAQPage"
            data={{
                faqs: faqs.map((f) => ({
                    question: f.question,
                    answer: f.answer.replace(/<[^>]*>/g, ""),
                })),
            }}
        />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Cours de Boxe à Genève", href: "/cours-de-boxe-geneve" },
                ],
            }}
        />
    </Fragment>

    <Hero
        title={`Cours de Boxe à <span class="text-primary">Genève</span>`}
        description="Le guide pour choisir votre cours de boxe à Genève : formats, profils, tarifs, premiers pas. Par les coachs de Bis Repetita."
        image={homepage}
        imageAlt="Travail aux pattes d'ours au studio Bis Repetita à Genève"
        actions={[
            { text: "Découvrir nos formules", href: "/services" },
            { text: "Lire le guide", href: "#profils" },
        ]}
    />

    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            Genève compte de nombreux clubs et studios de boxe.
            <span class="soft">Du club associatif au studio privé : ce guide vous aide à choisir selon votre profil, vos objectifs et votre budget.</span>
        </p>
        <dl class="rows">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>

    <EquipmentPanels
        id="profils"
        title="4 profils, 4 parcours de boxe à Genève"
        panels={profilPanels}
    />

    <section class="section wrap split">
        <h2 class="t-title" data-split>Trois manières de pratiquer la boxe à Genève</h2>
        <ul class="list">
            {typesDePratique.map((f) => (
                <li>
                    <h3 class="t-subtitle">{f.title}</h3>
                    <p>{f.description}</p>
                </li>
            ))}
        </ul>
    </section>

    <section id="premiere-seance" class="section method">
        <div class="wrap split">
            <div class="split-head">
                <h2 class="t-title" data-split>Votre première séance de boxe, étape par étape</h2>
                <p>Vous arrivez au studio, La Voie-Creuse 16. Deux vestiaires, femmes et hommes, avec une douche dans chacun : vous venez en tenue de sport, le reste est sur place. Voici une première séance type, sans sparring ni mise en situation de combat. Chaque séance privée est ensuite construite sur mesure.</p>
            </div>
            <ol class="list steps">
                {firstSession.map((s, i) => (
                    <li>
                        <span class="step-n">{i + 1}</span>
                        <h3 class="t-subtitle">{s.t}</h3>
                        <p>{s.d}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section id="freins" class="section wrap split">
        <h2 class="t-title" data-split>Les freins les plus courants, et pourquoi ils ne tiennent pas</h2>
        <ul class="list">
            {objections.map((o) => {
                const [before, after] = o.d.split("{link}");
                return (
                    <li>
                        <h3 class="t-subtitle">{o.t}</h3>
                        <p>{before}{after !== undefined && <><a href="/blog/studio-boxe-prive-vs-salle-classique-geneve" class="link-line">studio privé</a>{after}</>}</p>
                    </li>
                );
            })}
        </ul>
    </section>

    <section id="formats" class="section wrap rule-t">
        <div class="formats-head">
            <h2 class="t-title" data-split>7 formats pour pratiquer la boxe à Genève</h2>
            <p>Solo, duo, petit groupe, collectif, à domicile, en entreprise ou pensé pour les femmes : chaque format répond à un besoin précis.</p>
        </div>
        <ul class="formats">
            {formats.map((f) => (
                <li>
                    <a href={f.href} class="format-row">
                        <h3 class="fr-t">{f.t}</h3>
                        <p class="fr-d">{f.d}</p>
                        <span class="fr-a" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 14 14"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </section>

    <RelatedArticles
        title="Nos articles sur la boxe à Genève"
        maxItems={6}
        excludePostIds={["boxe-femme-geneve-guide-complet"]}
    />

    <FAQ
        title="Questions fréquentes sur les cours de boxe à Genève"
        subtitle="Les réponses aux questions les plus posées par les débutants."
        items={faqs}
    />

    <CTABanner
        variant="brushed-full"
        title="Prêt à commencer ?"
        cta={{ text: "Voir les formules", href: "/services" }}
    />
</BaseLayout>

<style>
    .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro-lead { max-width: 24ch; }
    .rows { border-top: 1px solid var(--line); font-size: 14px; }
    .rows div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .rows dt { color: var(--gray-2); }
    .rows dd { text-align: right; }

    .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 40px clamp(40px, 8vw, 160px); align-items: start; }
    .split-head { display: grid; gap: 20px; align-self: start; position: sticky; top: calc(var(--nav-h) + 32px); }
    .split-head p { color: var(--gray-1); max-width: 44ch; }
    .list { border-top: 1px solid var(--line); }
    .list li { display: grid; gap: 8px; padding: clamp(24px, 3vw, 40px) 0; border-bottom: 1px solid var(--line); }
    .list p { color: var(--gray-1); max-width: 52ch; }

    .method { background: var(--surface); }
    .steps li { grid-template-columns: 48px minmax(0, 1fr); column-gap: 16px; }
    .steps p { grid-column: 2; }
    .step-n { grid-row: span 2; font-size: 14px; color: var(--gray-2); font-variant-numeric: tabular-nums; padding-top: 6px; }

    .formats-head { display: grid; gap: 16px; max-width: 760px; margin-bottom: clamp(32px, 4vw, 56px); }
    .formats-head p { color: var(--gray-1); }
    .formats { border-top: 1px solid var(--ink); }
    .format-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) 20px;
        gap: 8px 24px;
        align-items: baseline;
        padding: 22px 0;
        border-bottom: 1px solid var(--line);
        transition: padding 0.6s var(--ease-out-expo);
    }
    .format-row:hover, .format-row:focus-visible { padding-left: 14px; }
    .fr-t { font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 500; letter-spacing: var(--track-title); line-height: 1.1; }
    .fr-d { color: var(--gray-1); font-size: 15px; }
    .fr-a { justify-self: end; }

    @media (max-width: 860px) {
        .intro, .split { grid-template-columns: 1fr; }
        .split-head { position: static; }
        .format-row { grid-template-columns: 1fr; }
        .fr-a { display: none; }
    }
</style>
