---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import PostItem from "../../../components/blog/PostItem.astro";
import { slugify } from "../../../utils/slugify";
import { isPublished } from "../../../utils/blog";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", isPublished);
  const posts = allPosts.filter((post) => post.data && post.data.pubDate);

  const tags = new Set<string>();
  posts.forEach((post) => {
    post.data.tags?.forEach((tag) => tags.add(tag));
  });

  return Array.from(tags).map((tag) => {
    return {
      params: { tag: slugify(tag) },
      props: {
        tag,
        posts: posts
          .filter((post) => post.data.tags?.includes(tag))
          .sort(
            (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
          ),
      },
    };
  });
}

const { tag, posts } = Astro.props;

const metadata = {
  title: `#${tag} — Blog Bis Repetita`,
  description: `Articles tagges "${tag}". Conseils et actualites par Bis Repetita Geneve.`,
  // Pages d'agrégation thin : noindex pour éviter la cannibalisation des vraies pages
  // (elles rankaient sur des queries commerciales type "boxe femme genève"). Liens suivis.
  noindex: true,
};
---

<BaseLayout metadata={metadata}>
  <section class="tag-hero">
    <div class="wrap tag-grid">
      <h1 class="t-display" data-split>#{tag}</h1>
      <div class="tag-side">
        <p>{posts.length} article{posts.length === 1 ? "" : "s"} avec ce mot-clé.</p>
        <a href="/blog" class="link-line">Tous les articles</a>
      </div>
    </div>
  </section>

  <div class="wrap blog-list">
    {
      posts.length === 0 ? (
        <p class="py-20 text-gray-1">Aucun article avec ce mot-clé.</p>
      ) : (
        <div class="post-grid">
          {posts.map((post) => (
            <PostItem post={post} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .blog-list { padding-bottom: var(--section); }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(48px, 5vw, 72px) clamp(24px, 2.4vw, 40px);
    padding-top: clamp(40px, 4vw, 64px);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 1023px) { .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .post-grid { grid-template-columns: 1fr; } }
  .tag-hero { padding-top: clamp(48px, 7vw, 112px); padding-bottom: clamp(40px, 5vw, 72px); }
  .tag-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 24px clamp(32px, 6vw, 120px); align-items: end; }
  .tag-grid h1 { overflow-wrap: anywhere; }
  .tag-side { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; font-size: 17px; color: var(--gray-1); }
  .tag-side a { color: var(--ink); font-size: 15px; }
  @media (max-width: 860px) { .tag-grid { grid-template-columns: 1fr; } }
</style>
