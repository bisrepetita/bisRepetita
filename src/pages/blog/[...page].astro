---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogHero from "../../components/blog/BlogHero.astro";
import PostFeatured from "../../components/blog/PostFeatured.astro";
import PostItem from "../../components/blog/PostItem.astro";
import { isPublished } from "../../utils/blog";
import type { GetStaticPathsOptions } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const blogEntries = await getCollection("blog", isPublished);
  const sortedPosts = blogEntries
    .filter((post) => post.data && post.data.pubDate)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(sortedPosts, { pageSize: 9 });
}

const { page } = Astro.props;
const allPosts = page.data;
const isFirstPage = page.currentPage === 1;

const featuredPost = isFirstPage && allPosts.length > 0 ? allPosts[0] : null;
const gridPosts = isFirstPage ? allPosts.slice(1) : allPosts;

const allBlogEntries = await getCollection("blog", isPublished);
const allCategories = allBlogEntries
  .map((p) => p.data.category)
  .filter((c): c is string => !!c);

const arrowLeft = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M13 7H1M6 2 1 7l5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
const arrowRight = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;

const metadata = {
  title: "Blog Boxe et Coaching à Genève",
  description:
    "Articles et conseils sur la boxe, l'entraînement et le bien-être par le studio Bis Repetita à Genève. Techniques, nutrition et mental.",
};
---

<BaseLayout metadata={metadata}>
  <BlogHero categories={allCategories} />

  <div class="wrap blog-list">
    {
      allPosts.length === 0 ? (
        <p class="py-20 text-gray-1">Aucun article pour le moment.</p>
      ) : (
        <>
          {featuredPost && <PostFeatured post={featuredPost} />}

          {gridPosts.length > 0 && (
            <div class="post-grid">
              {gridPosts.map((post) => (
                <PostItem post={post} />
              ))}
            </div>
          )}

          {(page.url.prev || page.url.next) && (
            <nav class="pager" aria-label="Pagination">
              {page.url.prev ? (
                <a href={page.url.prev} class="pager-link" rel="prev">
                  <Fragment set:html={arrowLeft} /> Précédent
                </a>
              ) : <span />}
              <span class="pager-count">Page {page.currentPage} sur {page.lastPage}</span>
              {page.url.next ? (
                <a href={page.url.next} class="pager-link" rel="next">
                  Suivant <Fragment set:html={arrowRight} />
                </a>
              ) : <span />}
            </nav>
          )}
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .blog-list { padding-bottom: var(--section); }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(48px, 5vw, 72px) clamp(24px, 2.4vw, 40px);
    margin-top: clamp(64px, 7vw, 112px);
    padding-top: clamp(40px, 4vw, 64px);
    border-top: 1px solid var(--line);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: clamp(64px, 7vw, 112px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .pager-link { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); }
  .pager-link:hover { color: var(--gray-1); }
  .pager > :last-child { justify-self: end; }
  .pager-count { color: var(--gray-2); }
  @media (max-width: 1023px) { .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .post-grid { grid-template-columns: 1fr; } }
</style>
