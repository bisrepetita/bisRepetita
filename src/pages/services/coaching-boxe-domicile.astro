---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/widgets/Hero.astro";
import SplitShowcase from "../../components/widgets/SplitShowcase.astro";
import ContentShowcase from "../../components/widgets/ContentShowcase.astro";
import Features from "../../components/widgets/Features.astro";
import PricingTable from "../../components/widgets/PricingTable.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import ZenamuCalendar from "../../components/widgets/ZenamuCalendar.astro";
import RelatedServices from "../../components/widgets/RelatedServices.astro";
import Schema from "../../components/seo/Schema.astro";
import coursPortrait from "../../assets/cours-portrait.webp";
import ambianceBis from "../../assets/ambiance-bis-repetita.webp";
import imageCta from "../../assets/image-cta.webp";

const metadata = {
    title: "Coaching Boxe à Domicile Genève",
    description:
        "Coaching de boxe à domicile à Genève. Technique, cardio et mental, chez vous. Matériel professionnel fourni. Réservez votre séance.",
};

const facts = [
    { k: "Lieu", v: "Chez vous, dans le canton de Genève" },
    { k: "Durée", v: "60 minutes" },
    { k: "Participants", v: "1 à 3 personnes" },
    { k: "Coach", v: "Nicolas de Boccard, 20 ans de pratique" },
    { k: "Matériel", v: "Apporté par le coach" },
];

const zones = [
    {
        title: "Eaux-Vives, Champel et Cologny",
        description: "Rive gauche résidentielle.",
    },
    {
        title: "Carouge et Plainpalais",
        description: "Centre-ville et alentours, pour une séance tôt le matin ou à la pause de midi.",
    },
    {
        title: "Sécheron, Nations et Pâquis",
        description: "Rive droite et quartier international. Séances en français ou en anglais.",
    },
    {
        title: "Grand Genève",
        description: "Communes limitrophes : Versoix, Meyrin, Lancy, Onex. Sur devis.",
    },
];

const features = [
    {
        title: "Pas de trajet",
        description:
            "On s'installe chez vous en quelques minutes. L'heure de séance reste une heure.",
        icon: "lucide:clock",
    },
    {
        title: "Discrétion",
        description:
            "Pas de salle partagée, pas de public. Vous vous entraînez chez vous.",
        icon: "lucide:lock",
    },
    {
        title: "Horaires souples",
        description:
            "Tôt le matin, à midi, le soir : le créneau suit votre agenda.",
        icon: "lucide:calendar",
    },
    {
        title: "Matériel fourni",
        description:
            "Gants, pattes d'ours, tapis, corde : le coach apporte tout. Il vous faut une tenue de sport et un peu d'espace.",
        icon: "lucide:package",
    },
    {
        title: "Toute la famille",
        description:
            "Une séance pour vous, une pour votre conjoint, une pour vos ados. Les séances s'enchaînent à la maison.",
        icon: "lucide:users",
    },
];

const tiers = [
    {
        name: "Séance unité",
        description: "Une séance complète de coaching de boxe chez vous.",
        price: "dès CHF 150.-",
        priceNote: "/ séance",
        features: [
            "60 minutes de coaching individuel",
            "Programme personnalisé",
            "Matériel fourni",
            "Déplacement inclus (canton GE)",
        ],
        cta: { text: "Réserver une séance", href: "#planning" },
    },
];

const faqs = [
    {
        question: "Quel espace faut-il prévoir chez soi ?",
        answer: "Un espace dégagé d'environ 6 à 8 m² suffit : salon, terrasse, garage, jardin. Nicolas évalue l'espace lors de la première séance et adapte les exercices en conséquence.",
    },
    {
        question: "Que fournissez-vous comme matériel ?",
        answer: "Tout le matériel professionnel est inclus : gants de boxe, pattes d'ours, tapis de sol, corde à sauter, bandes de protection. Vous n'avez besoin que d'une tenue de sport et d'une bouteille d'eau.",
    },
    {
        question: "Quelle différence avec une séance au studio ?",
        answer: "La qualité du coaching est identique. La différence : pas de ring ni de sacs de frappe, mais un travail technique aux pattes d'ours et une préparation physique tout aussi intense. Le format domicile est idéal pour le travail technique, le cardio et le renforcement. Pour l'expérience complète avec ring et équipements, découvrez nos <a href='/services/coaching-solo' class='link-line'>séances au studio</a>.",
    },
    {
        question: "Quelles zones couvrez-vous à Genève ?",
        answer: "Nous intervenons dans tout le canton de Genève : Eaux-Vives, Champel, Cologny, Carouge, Plainpalais, Sécheron, Nations, Pâquis, et communes limitrophes. Les zones hors canton sont disponibles sur devis.",
    },
    {
        question: "Peut-on être plusieurs pour une séance à domicile ?",
        answer: "Oui, les séances à domicile accueillent jusqu'à 3 personnes — couple, amis, famille. Le programme est adapté au groupe. Pour plus de 3 personnes, consultez nos formats <a href='/services/small-group-training' class='link-line'>small group</a> ou <a href='/services/corporate' class='link-line'>corporate</a>.",
    },
    {
        question: "Quels sont les tarifs du coaching à domicile ?",
        answer: "Le coaching à domicile est disponible à la séance ou en pack de 10 séances avec tarif préférentiel. Le déplacement dans le canton de Genève est inclus. Consultez nos <a href='/tarifs' class='link-line'>tarifs détaillés</a> ou <a href='/contact' class='link-line'>contactez-nous</a> pour un devis personnalisé.",
    },
    {
        question: "Comment réserver et annuler une séance ?",
        answer: "La réservation se fait via notre <a href='/contact' class='link-line'>formulaire de contact</a> ou par téléphone. L'annulation est gratuite jusqu'à 24 heures avant la séance. Au-delà, la séance est due.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Coaching de Boxe à Domicile à Genève",
                description: metadata.description,
                url: "https://bisrepetita.ch/services/coaching-boxe-domicile",
                serviceType: "Coaching sportif à domicile",
                parentService: { name: "Coaching Privé de Boxe", url: "https://bisrepetita.ch/services/coaching-prive" },
            }}
        />
        <Schema
            type="Person"
            data={{
                title: "Nicolas de Boccard",
                description: "Head Coach & Fondateur de Bis Repetita. Dans la boxe depuis 2002, entraineur agréé Swiss Boxing. Licencié SwissBoxing #102860.",
            }}
        />
        <Schema type="FAQPage" data={{ faqs: faqs.map(f => ({ question: f.question, answer: f.answer.replace(/<[^>]*>/g, '') })) }} />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Programmes", href: "/services" },
                    { name: "Coaching à Domicile", href: "/services/coaching-boxe-domicile" },
                ],
            }}
        />
    </Fragment>
    <Hero
        title={`Votre Ring, Vos Règles : <span class="text-primary">Coaching de Boxe à Domicile</span> à Genève`}
        description="Nicolas de Boccard se déplace chez vous avec le matériel. Un coaching de boxe sur mesure, sans trajet."
        image={imageCta}
        imageAlt="Travail aux pattes d'ours pendant une séance de coaching"
        actions={[
            { text: "Réserver une séance", href: "#planning" },
            { text: "Voir les tarifs", href: "/tarifs" },
        ]}
    />
    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            La même exigence qu'au studio, sans le trajet.
            <span class="soft">Un programme construit pour vous, chez vous.</span>
        </p>
        <dl class="facts">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>
        <SplitShowcase
            id="pourquoi-domicile"
            title="Le studio vient à vous"
            image={coursPortrait}
            imageAlt="Nicolas de Boccard tient les pattes d'ours face à une élève"
            items={[
                {
                    title: "Un programme sur mesure",
                    description: "Chaque séance part de vos objectifs, de votre niveau et de l'espace disponible : technique, cardio, tonification, concentration.",
                },
                {
                    title: "Le matériel est apporté",
                    description: "Gants, pattes d'ours, tapis, corde à sauter, bandes. Vous n'avez rien à acheter ni à ranger.",
                },
                {
                    title: "Le coaching Bis Repetita, chez vous",
                    description: "20 ans de pratique, entraîneur agréé Swiss Boxing. Le même coaching qu'au studio, dans votre salon.",
                },
            ]}
        />
        <ContentShowcase
            title="60 minutes, quatre phases"
            image={ambianceBis}
            imageAlt="Échauffement à la corde à sauter"
            items={[
                {
                    title: "Échauffement, 10 min",
                    description: "Mobilité, corde à sauter, shadow boxing, adaptés à votre espace.",
                },
                {
                    title: "Technique aux pattes d'ours, 20 à 25 min",
                    description: "Enchaînements, esquives, contre-attaques, avec le coach sur chacun de vos gestes. Les pattes d'ours remplacent le sac.",
                },
                {
                    title: "Renforcement et cardio, 15 à 20 min",
                    description: "Un circuit adapté à votre domicile : renforcement, explosivité, cardio. Aucun équipement encombrant.",
                },
                {
                    title: "Retour au calme, 5 min",
                    description: "Étirements, respiration, débrief. On prépare la séance suivante.",
                },
            ]}
        />
        <Features
            title="Pourquoi s'entraîner chez soi"
            features={features}
            columns={3}
            headlineAlign="left"
            bento="2-3"
        />
    <section class="section wrap zones" id="zones">
        <h2 class="t-title" data-split>Coaching à domicile dans tout le canton de Genève</h2>
        <dl class="zone-list">
            {zones.map((z) => (
                <div><dt>{z.title}</dt><dd>{z.description}</dd></div>
            ))}
        </dl>
    </section>
        <PricingTable
            title="Formules coaching à domicile"
            tiers={tiers}
        />
    <RelatedServices currentSlug="coaching-boxe-domicile" />
        <FAQ
            id="faq"
            title="Questions fréquentes"
            subtitle="Le coaching de boxe à domicile à Genève, en pratique."
            items={faqs}
        />
        <ZenamuCalendar id="planning" title="Réserver une séance à domicile" />
</BaseLayout>

<style>
    .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro-lead { max-width: 24ch; }
    .facts { border-top: 1px solid var(--line); }
    .facts div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
    .facts dt { color: var(--gray-2); }
    .facts dd { text-align: right; }
    @media (max-width: 860px) {
        .intro { grid-template-columns: 1fr; }
    }
    .zones { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 32px clamp(40px, 8vw, 160px); }
    .zone-list { border-top: 1px solid var(--ink); }
    .zone-list div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 8px 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
    .zone-list dt { font-weight: 500; }
    .zone-list dd { color: var(--gray-1); }
    @media (max-width: 860px) {
        .zones, .zone-list div { grid-template-columns: 1fr; }
    }
</style>
