---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/widgets/Hero.astro";
import Features from "../../components/widgets/Features.astro";
import ContentShowcase from "../../components/widgets/ContentShowcase.astro";
import SplitShowcase from "../../components/widgets/SplitShowcase.astro";
import PricingTable from "../../components/widgets/PricingTable.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import CTABanner from "../../components/widgets/CTABanner.astro";
import ProfileShowcase from "../../components/widgets/ProfileShowcase.astro";
import RelatedServices from "../../components/widgets/RelatedServices.astro";
import Schema from "../../components/seo/Schema.astro";
import coursLandscape from "../../assets/cours-2-landscape.webp";
import imageCta from "../../assets/image-cta.webp";
import nicolasPortrait from "../../assets/nicolas-de-boccard.webp";

const metadata = {
    title: "Boxe Corporate & Team Building Genève",
    description:
        "Boxe corporate à Genève : team building, gestion du stress, cohésion d'équipe. Coachs certifiés, déplacement dans le canton.",
};

const facts = [
    { k: "Lieu", v: "Dans vos locaux ou au studio" },
    { k: "Zone", v: "Canton de Genève" },
    { k: "Participants", v: "Jusqu'à 20 en entreprise, 12 au studio" },
    { k: "Contact", v: "Aucun par défaut" },
    { k: "Tarif", v: "Sur devis" },
];

const features = [
    {
        title: "Gestion du stress",
        description:
            "Un effort physique cadré et progressif, une heure où l'on pense au geste plutôt qu'aux dossiers. Beaucoup de participants disent repartir plus détendus.",
        icon: "lucide:shield-check",
    },
    {
        title: "Leadership & prise de décision",
        description:
            "Garder son calme sous l'effort, lire une situation, décider vite. Des réflexes que la boxe fait travailler et qui parlent à chacun au bureau.",
        icon: "lucide:target",
    },
    {
        title: "Cohésion d'équipe",
        description:
            "Un effort partagé rapproche. La boxe crée un moment commun entre collaborateurs, au-delà des hiérarchies.",
        icon: "lucide:users",
    },
    {
        title: "Marque employeur",
        description:
            "Proposer la boxe en entreprise montre un engagement concret pour le bien-être au travail.",
        icon: "lucide:award",
    },
];

const teamBuildingFormats = [
    {
        title: "Atelier découverte (1h)",
        description: "Initiation à la boxe sans contact pour 10 à 20 collaborateurs. Pour un afterwork, une journée d'intégration ou un team building ponctuel.",
    },
    {
        title: "Séminaire leadership (demi-journée)",
        description: "Atelier pratique et conférence interactive sur la prise de décision sous pression. Le parallèle entre le ring et le management.",
    },
    {
        title: "Programme récurrent (hebdomadaire)",
        description: "Des séances de boxe fitness intégrées au programme bien-être de votre entreprise. Tarifs dégressifs, suivi collectif.",
    },
    {
        title: "Défi d'équipe (compétition interne)",
        description: "Tournoi de shadow boxing ou circuit training par équipes. Sans contact, avec un classement à la clé.",
    },
];

const approches = [
    {
        title: "Boxe sans contact",
        description: "Le format le plus demandé en entreprise. Aucune opposition entre participants : tout le travail se fait au sac et aux pattes d'ours. Technique, cardio, renforcement.",
        items: [
            "Travail au sac de frappe et pattes d'ours",
            "Circuit training",
            "Shadow boxing et déplacements",
            "Aucun prérequis sportif",
        ],
        ideal: "Team building, bien-être au travail, découverte de la boxe",
    },
    {
        title: "Boxe avec contact",
        description: "En option, pour les équipes qui le souhaitent. Un contact léger, contrôlé et consenti, avec protections complètes et sous la supervision du coach. Personne n'y est obligé.",
        items: [
            "Exercices d'opposition légère avec protections",
            "Assauts éducatifs encadrés par le coach",
            "Progression par étapes",
            "Niveau intermédiaire recommandé",
        ],
        ideal: "Équipes déjà initiées, séminaires leadership",
    },
];

const tiers = [
    {
        name: "Séance découverte",
        description: "Un atelier d'initiation pour tester la boxe avec votre équipe.",
        price: "Sur devis",
        features: [
            "Atelier découverte de 60 min",
            "Jusqu'à 10 participants",
            "Matériel fourni",
            "Sans engagement",
        ],
        cta: { text: "Demander un devis", href: "/contact" },
    },
    {
        name: "Team Building",
        description: "Un atelier ponctuel pour réunir vos équipes.",
        price: "Sur devis",
        priceNote: "",
        features: [
            "Session de 60-90 min",
            "Jusqu'à 20 participants",
            "Matériel fourni",
            "En entreprise ou au studio",
            "Débriefing collectif",
        ],
        cta: { text: "Demander un devis", href: "/contact" },
    },
    {
        name: "Coaching Régulier",
        description: "Des séances hebdomadaires sur votre lieu de travail.",
        price: "Sur devis",
        priceNote: "",
        features: [
            "1 à 2 séances par semaine",
            "Programme évolutif",
            "Suivi des progrès",
            "Rapport trimestriel",
            "Tarif dégressif",
        ],
        cta: { text: "Demander un devis", href: "/contact" },
        highlighted: true,
    },
    {
        name: "Séminaires & Keynotes",
        description: "Le parallèle entre le ring et l'entreprise.",
        price: "Sur devis",
        priceNote: "",
        features: [
            "Conférence interactive",
            "Atelier pratique inclus",
            "Thèmes : leadership, prise de décision, effort",
            "Adapté aux séminaires d'entreprise",
        ],
        cta: { text: "Demander un devis", href: "/contact" },
    },
];

const faqs = [
    {
        question: "Faut-il du matériel ou de l'équipement ?",
        answer: "Tout est fourni : gants, pattes d'ours, tapis de sol. Vos collaborateurs viennent en tenue de sport confortable, nous nous occupons du reste.",
    },
    {
        question: "Est-ce dangereux ? Y a-t-il des contacts physiques ?",
        answer: "Par défaut, nos séances corporate reposent sur la boxe sans contact : zéro opposition directe, tout le travail se fait au sac et aux pattes d'ours, sous la supervision du coach. Pour les équipes qui le souhaitent, un format avec contact est possible en option : un contact léger, contrôlé et consenti, avec protections, toujours sous la supervision du coach.",
    },
    {
        question: "Quelle différence entre boxe sans contact et boxe avec contact ?",
        answer: "La boxe sans contact est accessible à tous : technique au sac, pattes d'ours, shadow boxing et circuit training. Aucune opposition entre participants. La boxe avec contact, en option, introduit un contact léger, contrôlé et consenti, avec protections complètes, pour les équipes qui cherchent une expérience plus immersive. Les deux approches sont combinables dans un même programme.",
    },
    {
        question: "Quel espace prévoir dans nos bureaux ?",
        answer: "Un minimum de 20m² avec un sol stable et dégagé suffit. Salle de réunion, open space, parking couvert — on s'adapte à votre configuration.",
    },
    {
        question: "Combien de participants par séance ?",
        answer: "Jusqu'à 20 personnes en déplacement, 12 au studio pour garantir un encadrement optimal sur le ring et les équipements.",
    },
    {
        question: "Quels sont les tarifs corporate ?",
        answer: "Les séances corporate sont facturées entre 400 et 600 CHF selon le format, la durée et le nombre de participants. Les formules mensuelles bénéficient de tarifs dégressifs. <a href='/contact' class='link-line'>Demandez un devis personnalisé</a> pour un tarif précis.",
    },
    {
        question: "Proposez-vous des contrats récurrents ?",
        answer: "Oui, nous proposons des formules mensuelles et trimestrielles avec des tarifs dégressifs. La solution idéale pour intégrer la boxe dans votre programme bien-être au travail.",
    },
    {
        question: "Comment fonctionne la facturation ?",
        answer: "Nous émettons une facture avec un délai de paiement de 30 jours. Le règlement par virement bancaire est privilégié pour les entreprises. <a href='/contact' class='link-line'>Contactez-nous</a> pour discuter des modalités.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Coaching de Boxe Corporate à Genève",
                description: metadata.description,
                url: "https://bisrepetita.ch/services/corporate",
                serviceType: "Boxe corporate et team building",
            }}
        />
        <Schema
            type="Person"
            data={{
                title: "Nicolas de Boccard",
                description: "Head Coach & Fondateur de Bis Repetita. Dans la boxe depuis 2002, entraineur agréé Swiss Boxing. Licencié SwissBoxing #102860.",
            }}
        />
        <Schema
            type="FAQPage"
            data={{
                faqs: faqs.map((f) => ({
                    question: f.question,
                    answer: f.answer.replace(/<[^>]*>/g, ""),
                })),
            }}
        />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Programmes", href: "/services" },
                    { name: "Corporate", href: "/services/corporate" },
                ],
            }}
        />
    </Fragment>

    <Hero
        title={`Boxe <span class="text-primary">Corporate</span> à Genève`}
        description="Bien-être et cohésion d'équipe. Des programmes de boxe sur mesure pour les entreprises genevoises, dans vos locaux ou au studio."
        image={coursLandscape}
        imageAlt="Séance de boxe en groupe au studio Bis Repetita à Genève"
        actions={[{ text: "Demander un devis", href: "/contact" }]}
    />

    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            La boxe en entreprise, encadrée par des coachs formés en compétition.
            <span class="soft">Sans contact par défaut, avec un contact léger en option. Le programme suit vos objectifs d'équipe.</span>
        </p>
        <dl class="rows">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>

    <Features
        id="pourquoi"
        title="Ce que la boxe apporte à vos équipes"
        features={features}
    />

    <section id="team-building" class="section wrap split">
        <div class="split-head">
            <h2 class="t-title" data-split>Team Building Boxe à Genève</h2>
            <p>
                De l'atelier découverte au programme annuel, la boxe réunit vos équipes autour d'un effort partagé, <a href="#faq" class="link-line">dans un cadre encadré</a>.
            </p>
            <p>Tous les formats sont combinables. <a href="/contact" class="link-line">Demandez un devis sur mesure</a>.</p>
        </div>
        <ul class="list">
            {teamBuildingFormats.map((f) => (
                <li>
                    <h3 class="t-subtitle">{f.title}</h3>
                    <p>{f.description}</p>
                </li>
            ))}
        </ul>
    </section>

    <SplitShowcase
        title="Une méthode, deux intensités"
        image={imageCta}
        imageAlt="Travail aux pattes d'ours entre un coach et un participant"
        items={[
            {
                title: "Sécurité d'abord",
                description:
                    "Sans contact ou avec un contact léger, la sécurité de vos collaborateurs passe d'abord : protections, supervision continue, intensité progressive.",
            },
            {
                title: "Adapté à tous les niveaux",
                description:
                    "Aucun prérequis sportif. Les exercices sont ajustés en temps réel selon la condition de chacun, du débutant au sportif confirmé.",
            },
            {
                title: "Méthode structurée",
                description:
                    "Chaque séance suit le même fil : échauffement, technique, circuit training, retour au calme.",
            },
        ]}
    />

    <section id="approches" class="section wrap">
        <div class="split-head approches-head">
            <h2 class="t-title" data-split>Avec ou sans contact : vous choisissez</h2>
            <p>Selon vos objectifs et le profil de vos équipes, nous ajustons l'intensité, de la découverte au contact léger encadré.</p>
        </div>
        <div class="approches">
            {approches.map((a) => (
                <div>
                    <h3 class="t-subtitle">{a.title}</h3>
                    <p class="approche-desc">{a.description}</p>
                    <ul class="rows">
                        {a.items.map((item) => <li>{item}</li>)}
                        <li><span class="soft">Pour</span> <span>{a.ideal}</span></li>
                    </ul>
                </div>
            ))}
        </div>
        <p class="approches-foot">
            Les deux formats se combinent dans un même programme. <a href="/contact" class="link-line">Discutons de vos besoins</a>.
        </p>
    </section>

    <PricingTable
        title="Quatre formats pour répondre à vos besoins"
        tiers={tiers}
    />

    <ProfileShowcase
        title="Nicolas de Boccard"
        image={nicolasPortrait}
        imageAlt="Portrait de Nicolas de Boccard, coach de boxe à Genève"
        items={[
            {
                title: "Compétiteur et formateur",
                description:
                    "Licencié SwissBoxing #102860, formé dans les clubs genevois historiques. Nicolas a adapté la rigueur de la compétition au monde de l'entreprise.",
            },
            {
                title: "Entraîneur agréé Swiss Boxing",
                description:
                    "Habitué à encadrer des publics non sportifs, avec une progression adaptée à chaque profil.",
            },
            {
                title: "20 ans de pratique",
                description:
                    "Nicolas connaît les contraintes logistiques et les attentes des entreprises.",
            },
            {
                title: "Ancré à Genève",
                description:
                    "Formé dans le tissu sportif genevois, Nicolas connaît les entreprises, les espaces et les rythmes du canton.",
            },
        ]}
    />

    <ContentShowcase
        title="La boxe vient à vous, partout dans le canton"
        items={[
            {
                title: "Genève centre & Plainpalais",
                description:
                    "Bureaux, espaces de coworking, salles de réunion : on s'adapte à votre espace.",
            },
            {
                title: "Organisations internationales & Nations",
                description:
                    "Habitués aux environnements internationaux. Séances en français ou en anglais.",
            },
            {
                title: "Plan-les-Ouates & zone industrielle",
                description:
                    "Intervention dans les zones d'activité du canton. Parking, accès livraison : on gère la logistique.",
            },
            {
                title: "Au studio, La Voie-Creuse 16",
                description:
                    "Accueillez vos équipes au studio : un ring, des sacs, des vestiaires et des douches.",
            },
        ]}
    />

    <RelatedServices currentSlug="corporate" />

    <FAQ
        id="faq"
        title="Questions fréquentes"
        subtitle="La boxe corporate à Genève, en pratique."
        items={faqs}
    />

    <CTABanner
        title="Un projet pour votre équipe ?"
        subtitle="Boxe corporate"
        cta={{ text: "Demander un devis", href: "/contact" }}
    />
</BaseLayout>

<style>
    .intro, .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); }
    .intro-lead { max-width: 24ch; }
    .split-head { display: grid; gap: 20px; align-content: start; }
    .split-head p { color: var(--gray-1); max-width: 42ch; }
    .list { border-top: 1px solid var(--line); }
    .list li { display: grid; gap: 8px; padding: clamp(24px, 3vw, 36px) 0; border-bottom: 1px solid var(--line); }
    .list p { color: var(--gray-1); max-width: 52ch; }
    .rows { border-top: 1px solid var(--line); font-size: 14px; }
    .rows > div, .rows > li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .rows dt, .rows .soft { color: var(--gray-2); }
    .rows dd, .rows li span:last-child { text-align: right; }
    .approches-head { margin-bottom: clamp(32px, 4vw, 56px); }
    .approches { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 4vw, 64px); }
    .approche-desc { margin: 12px 0 24px; color: var(--gray-1); max-width: 46ch; }
    .approches-foot { margin-top: 32px; color: var(--gray-1); font-size: 15px; }
    @media (max-width: 860px) {
        .intro, .split, .approches { grid-template-columns: 1fr; }
    }
</style>
