---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/widgets/Hero.astro";
import SplitShowcase from "../../components/widgets/SplitShowcase.astro";
import ContentShowcase from "../../components/widgets/ContentShowcase.astro";
import Features from "../../components/widgets/Features.astro";
import ProfileShowcase from "../../components/widgets/ProfileShowcase.astro";
import LocationMap from "../../components/widgets/LocationMap.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import ZenamuCalendar from "../../components/widgets/ZenamuCalendar.astro";
import RelatedServices from "../../components/widgets/RelatedServices.astro";
import Schema from "../../components/seo/Schema.astro";
import coursLandscape from "../../assets/cours-2-landscape.webp";
import ambianceBis from "../../assets/ambiance-bis-repetita.webp";
import imageCta from "../../assets/image-cta.webp";
import coachsPhoto from "../../assets/lionel-nicolas-boxe.webp";

const metadata = {
    title: "Cours de Boxe Genève | Round by Round",
    description:
        "Cours de boxe Round by Round à Genève. Technique, cardio et énergie du groupe, sans combat. 8 participants max, 1 coach, séances de 50 minutes.",
};

const facts = [
    { k: "Participants", v: "8 au plus" },
    { k: "Encadrement", v: "1 coach" },
    { k: "Durée", v: "50 minutes" },
    { k: "Format", v: "Rounds de 2 minutes, sans combat" },
    { k: "La séance", v: "CHF\u00a040" },
];

const features = [
    {
        title: "Technique de boxe anglaise",
        description:
            "Jab, direct, crochets, uppercuts, esquives, déplacements. Chaque round travaille la précision au sac et aux pattes d'ours, sous l'œil du coach.",
        icon: "lucide:zap",
    },
    {
        title: "Préparation physique intégrée",
        description:
            "Corde à sauter, burpees, gainage, renforcement, intégrés aux rounds. L'intensité monte progressivement, à votre rythme.",
        icon: "lucide:activity",
    },
    {
        title: "Force mentale",
        description:
            "Tenir un round quand les bras sont lourds, rester lucide sous la fatigue. Un travail qui sert aussi en dehors du studio.",
        icon: "lucide:brain",
    },
    {
        title: "Énergie collective",
        description:
            "Huit personnes au plus, un coach attentif à chaque round. Le groupe se connaît et se motive.",
        icon: "lucide:users",
    },
    {
        title: "Gestion du stress",
        description:
            "Le rythme des rounds occupe toute l'attention. Beaucoup de participants disent repartir plus calmes et plus concentrés.",
        icon: "lucide:heart-pulse",
    },
];

const faqs = [
    {
        question: "Les cours sont-ils accessibles aux débutants ?",
        answer: "Absolument. Les cours Round by Round sont conçus pour accueillir tous les niveaux, du grand débutant au pratiquant confirmé. Le coach adapte les exercices en temps réel — intensité, complexité des séquences techniques, temps de récupération — et chaque participant progresse à son rythme. Aucun prérequis : pas besoin de séances privées avant, vous pouvez commencer directement ici.",
    },
    {
        question: "Y a-t-il des contacts physiques entre participants ?",
        answer: "Non, jamais. Les cours Round by Round sont de la <strong>boxe sans combat</strong> : aucune opposition directe entre participants. Tout le travail technique se fait sur sac de frappe ou pattes d'ours avec le coach. Vous ne venez pas pour prendre des coups, mais pour apprendre à en donner au sac.",
    },
    {
        question: "Combien de participants par cours ?",
        answer: "8 maximum, toujours. C'est notre engagement pour garantir un encadrement de qualité et des corrections individuelles sur chaque geste technique. Un coach dédié à chaque séance pour un suivi personnalisé.",
    },
    {
        question: "Quelle est la durée d'un cours ?",
        answer: "Chaque cours dure 50 minutes, structuré en rounds de 2 minutes avec des temps de récupération active. Le format est calibré pour une intensité soutenue, sans surcharge.",
    },
    {
        question: "Que dois-je apporter pour ma première séance ?",
        answer: "Venez avec une tenue de sport confortable, des baskets réservées à l'intérieur et une bouteille d'eau. Le studio prête les gants (12 et 14 oz, désinfectés après chaque séance) et des sous-gants à chaque cours. Pas besoin de protège-dents. Par la suite, nous vous conseillerons sur l'équipement adapté à votre pratique.",
    },
    {
        question: "Où se situe le studio et comment y accéder ?",
        answer: "Le studio Bis Repetita se trouve <a href='#localisation' class='link-line'>La Voie-Creuse 16, 1202 Genève</a>. Accès en transports publics et places de stationnement à proximité.",
    },
    {
        question: "Comment réserver un cours et voir le planning ?",
        answer: "Vous pouvez réserver via notre <a href='/contact' class='link-line'>formulaire de contact</a> ou directement par téléphone. Les créneaux sont communiqués chaque semaine. Le planning en ligne, en bas de cette page, permet aussi de réserver directement. Votre première séance est offerte.",
    },
    {
        question: "Peut-on combiner Round by Round et coaching privé ?",
        answer: "C'est même recommandé. Le <a href='/services/coaching-prive' class='link-line'>coaching privé</a> approfondit la technique en tête-à-tête, les cours collectifs travaillent le cardio et le mental dans l'énergie du groupe. Découvrez nos <a href='/tarifs' class='link-line'>tarifs combinés</a> pour profiter des deux formats.",
    },
];

const tiers = [
    {
        name: "Séance unité",
        description: "Un cours collectif Round by Round à la carte. Première séance offerte ; packs et abonnements disponibles, voir les tarifs.",
        price: "CHF 40.-",
        priceNote: "/ séance",
        features: [
            "50 minutes de coaching",
            "8 participants max",
            "1 coach dédié",
            "Gants et sous-gants prêtés",
            "Sans engagement",
        ],
        cta: { text: "Réserver une séance", href: "#planning" },
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Round by Round — Cours Collectifs de Boxe",
                description: metadata.description,
                url: "https://bisrepetita.ch/services/round-by-round",
                serviceType: "Cours collectifs de boxe",
            }}
        />
        <Schema
            type="Person"
            data={{
                title: "Nicolas de Boccard",
                description: "Head Coach & Fondateur de Bis Repetita. Dans la boxe depuis 2002, entraineur agréé Swiss Boxing. Licencié SwissBoxing #102860.",
            }}
        />
        <Schema type="FAQPage" data={{ faqs: faqs.map(f => ({ question: f.question, answer: f.answer.replace(/<[^>]*>/g, '') })) }} />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Programmes", href: "/services" },
                    { name: "Round by Round", href: "/services/round-by-round" },
                ],
            }}
        />
    </Fragment>

    <Hero
        title={`Cours de Boxe <span class="text-primary">Round by Round</span> à Genève`}
        description="Le sac, le timer, l'énergie du groupe. 50 minutes de technique de boxe et de préparation physique, sans opposition entre participants."
        image={coursLandscape}
        imageAlt="Cours collectif de boxe Round by Round au studio Bis Repetita à Genève"
        locationBadge={{ text: "La Voie-Creuse 16, 1202 Genève" }}
        actions={[{ text: "Réserver une séance", href: "#planning" }]}
    />

    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            La discipline de la boxe anglaise et l'intensité du circuit training.
            <span class="soft">Dans un groupe de huit personnes au plus, avec un coach.</span>
        </p>
        <dl class="rows">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>

    <SplitShowcase
        id="methode"
        title="Un entraînement complet, accessible à tous"
        image={ambianceBis}
        imageAlt="Corde à sauter pendant l'échauffement d'un cours collectif"
        items={[
            {
                title: "Structure en rounds",
                description: "Le rythme d'un combat : rounds de 2 minutes, récupération active, intensité qui monte progressivement.",
            },
            {
                title: "Technique et physique intégrés",
                description: "Chaque round mêle séquences de boxe anglaise et préparation physique.",
            },
            {
                title: "Adapté à votre niveau",
                description: "Du grand débutant au pratiquant confirmé, le coach ajuste l'intensité et la complexité en temps réel.",
            },
        ]}
    />

    <Features
        id="benefices"
        title="Les piliers de la méthode Round by Round"
        features={features}
    />

    <section id="tarifs" class="section wrap price">
        <div class="price-head">
            <h2 class="t-title" data-split>Tarif Round by Round</h2>
            <p class="price-value">CHF&nbsp;40 <span class="soft">la séance</span></p>
            <p class="price-note">{tiers[0].description}</p>
            <a href="#planning" class="btn btn-solid">Réserver une séance</a>
        </div>
        <ul class="rows">
            {tiers[0].features.map((feature) => <li>{feature}</li>)}
        </ul>
    </section>

    <ContentShowcase
        id="securite"
        title="La puissance de la boxe, l'opposition en moins"
        image={imageCta}
        imageAlt="Travail aux pattes d'ours avec le coach, sans opposition entre participants"
        isReversed={true}
        items={[
            {
                title: "Zéro opposition",
                description: "Tout le travail se fait au sac et aux pattes d'ours avec le coach. Pas de sparring, aucun contact entre participants.",
            },
            {
                title: "Intensité adaptée",
                description: "Vous venez apprendre à frapper au sac. Chaque exercice s'adapte à votre condition physique et à votre coordination.",
            },
            {
                title: "Accessible dès la première séance",
                description: "Aucun prérequis technique ni physique. La boxe sans combat à Genève, dans un cadre structuré, dès votre premier round.",
            },
        ]}
        actions={[{ text: "Réserver une séance", href: "#planning" }]}
    />

    <ProfileShowcase
        id="coachs"
        title="Nicolas & Lionel de Boccard"
        image={coachsPhoto}
        imageAlt="Nicolas et Lionel de Boccard échangent au bord du ring"
        items={[
            {
                title: "20 ans de pratique",
                description: "Nicolas et Lionel se sont formés dans les clubs genevois historiques.",
            },
            {
                title: "Licence SwissBoxing #102860",
                description: "Nicolas est licencié SwissBoxing et entraîneur agréé Swiss Boxing.",
            },
            {
                title: "Champion Suisse Romand 2013",
                description: "Lionel a boxé en compétition en Suisse romande.",
            },
            {
                title: "Un coach par cours",
                description: "Chaque cours Round by Round est encadré par un coach, du début à la fin.",
            },
        ]}
    />

    <RelatedServices currentSlug="round-by-round" />

    <section id="localisation">
        <div class="wrap loc-head">
            <h2 class="t-title" data-split>Rejoignez la communauté Round by Round à Genève</h2>
            <p>La Voie-Creuse 16, 1202 Genève. Venez faire votre premier round.</p>
        </div>
        <LocationMap />
    </section>

    <FAQ
        id="faq"
        title="Questions fréquentes"
        subtitle="Les cours collectifs de boxe à Genève, en pratique."
        items={faqs}
    />

    <ZenamuCalendar id="planning" title="Réserver un cours Round by Round" />

    <div id="sticky-cta-mobile" class="sticky-cta md:hidden translate-y-full">
        <a href="#planning" class="btn btn-solid">Réserver une séance</a>
    </div>
</BaseLayout>

<style>
    .intro, .price { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro-lead { max-width: 24ch; }
    .rows { border-top: 1px solid var(--line); font-size: 14px; }
    .rows > div, .rows > li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .rows dt { color: var(--gray-2); }
    .rows dd { text-align: right; }
    .price-head { display: grid; gap: 20px; justify-items: start; }
    .price-value { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 500; letter-spacing: var(--track-title); line-height: 1; }
    .price-value .soft { font-size: 17px; letter-spacing: 0; }
    .price-note { color: var(--gray-1); }
    .loc-head { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 24px clamp(40px, 8vw, 160px); align-items: end; padding-top: var(--section); }
    .loc-head p { color: var(--gray-1); max-width: 40ch; }
    .sticky-cta {
        position: fixed;
        inset: auto 0 0 0;
        z-index: 50;
        padding: 12px var(--gutter);
        background: var(--bg);
        border-top: 1px solid var(--line);
        transition: translate 0.3s, transform 0.3s;
    }
    .sticky-cta .btn { width: 100%; }
    @media (max-width: 860px) {
        .intro, .price, .loc-head { grid-template-columns: 1fr; }
    }
</style>

<script>
    function initStickyCta() {
        const stickyCta = document.getElementById("sticky-cta-mobile");
        const footer = document.querySelector("footer");
        if (!stickyCta) return;

        let heroPassed = false;
        let footerVisible = false;

        const heroObserver = new IntersectionObserver(
            ([entry]) => {
                heroPassed = !entry.isIntersecting;
                updateVisibility();
            },
            { threshold: 0 },
        );

        const footerObserver = new IntersectionObserver(
            ([entry]) => {
                footerVisible = entry.isIntersecting;
                updateVisibility();
            },
            { threshold: 0 },
        );

        function updateVisibility() {
            if (heroPassed && !footerVisible) {
                stickyCta!.classList.remove("translate-y-full");
                stickyCta!.classList.add("translate-y-0");
            } else {
                stickyCta!.classList.add("translate-y-full");
                stickyCta!.classList.remove("translate-y-0");
            }
        }

        const heroSection = document.querySelector("section");
        if (heroSection) heroObserver.observe(heroSection);
        if (footer) footerObserver.observe(footer);
    }

    initStickyCta();
    document.addEventListener("astro:page-load", initStickyCta);
</script>
