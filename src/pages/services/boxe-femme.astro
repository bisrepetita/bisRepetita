---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/widgets/Hero.astro";
import Features from "../../components/widgets/Features.astro";
import SplitShowcase from "../../components/widgets/SplitShowcase.astro";
import ContentShowcase from "../../components/widgets/ContentShowcase.astro";
import PricingTable from "../../components/widgets/PricingTable.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import CTABanner from "../../components/widgets/CTABanner.astro";
import RelatedServices from "../../components/widgets/RelatedServices.astro";
import Schema from "../../components/seo/Schema.astro";
import coursPortrait from "../../assets/cours-portrait.webp";
import cours2Landscape from "../../assets/cours-2-landscape.webp";
import ambianceBis from "../../assets/ambiance-bis-repetita.webp";

const metadata = {
    title: "Cours de Boxe Femme à Genève — Studio Privé",
    description:
        "Cours de boxe femme à Genève en studio privé. Coaching personnalisé, cadre bienveillant, sans contact obligatoire, toutes formules. Séance d'essai gratuite.",
};

const facts = [
    { k: "Cadre", v: "Studio privé" },
    { k: "Coaching privé", v: "1 à 3 personnes" },
    { k: "Contact", v: "Aucun contact imposé" },
    { k: "Intensité", v: "Ajustée à chaque séance" },
    { k: "Niveau requis", v: "Aucun" },
];

const features = [
    {
        title: "Se tonifier",
        description:
            "Bras, épaules, sangle abdominale, jambes : la boxe sollicite tout le corps. Le travail au sac et aux pattes tonifie sans charges lourdes.",
        icon: "lucide:flame",
    },
    {
        title: "Cardio et énergie",
        description:
            "Les rounds alternent effort et récupération. Le souffle s'améliore avec la régularité.",
        icon: "lucide:heart-pulse",
    },
    {
        title: "Coordination",
        description:
            "Les poings, les appuis, la garde travaillent ensemble. Le geste devient plus précis, séance après séance.",
        icon: "lucide:hand",
    },
    {
        title: "Confiance dans le geste",
        description:
            "Se placer, frapper avec intention, occuper l'espace. La confiance suit la technique.",
        icon: "lucide:shield-check",
    },
    {
        title: "À votre rythme",
        description:
            "Le coach suit vos progrès en technique et en endurance, et ajuste le programme.",
        icon: "lucide:trending-up",
    },
];

const phases = [
    { k: "Règles", v: "Séance plus technique : précision, garde, déplacements. L'intensité reste à votre choix." },
    { k: "Phase folliculaire", v: "L'énergie remonte souvent : enchaînements plus longs, cardio qui augmente progressivement." },
    { k: "Ovulation", v: "Phase haute pour beaucoup : rounds plus explosifs, travail de vitesse et de cardio." },
    { k: "Phase lutéale", v: "Retour vers la technique et une endurance modérée, selon vos sensations du jour." },
];

const tiers = [
    {
        name: "Coaching Solo",
        description: "Pour débuter avec toute l'attention du coach.",
        price: "CHF 120.-",
        priceNote: "/ séance",
        features: [
            "60 min de coaching individuel",
            "Programme personnalisé",
            "Sans contact",
            "Matériel fourni",
        ],
        cta: { text: "Réserver une séance", href: "/#planning" },
    },
    {
        name: "Coaching Duo",
        description: "Venez avec une amie, le prix se partage.",
        price: "CHF 140.-",
        priceNote: "/ séance (pour 2)",
        features: [
            "60 min de coaching partagé",
            "Programme adapté aux deux",
            "Sans contact",
            "Matériel fourni",
        ],
        cta: { text: "Réserver une séance", href: "/#planning" },
        highlighted: true,
    },
    {
        name: "Round by Round",
        description: "Le cours collectif, 8 personnes au plus.",
        price: "CHF 40.-",
        priceNote: "/ séance",
        features: [
            "50 min, technique et cardio",
            "8 participants maximum",
            "1 coach",
            "Sans contact",
            "Matériel fourni",
        ],
        cta: { text: "Réserver une séance", href: "/#planning" },
    },
];

const faqs = [
    {
        question: "Comment se passe la première séance pour une femme débutante ?",
        answer: "On commence par un échauffement en douceur (corde, shadow boxing, mobilité), puis on passe aux fondamentaux : position de garde, déplacements, premiers coups sur les pattes d'ours tenues par Nicolas. Tout est adapté à votre rythme. Vous repartez fatiguée, avec les bases en main. Pour aller plus loin, lisez nos <a href='/blog/boxe-femme-geneve-guide-complet' class='link-line'>conseils pour bien débuter quand on n'a jamais boxé</a>.",
    },
    {
        question: "Quel équipement apporter ?",
        answer: "Une tenue de sport confortable et des baskets propres suffisent. Gants, bandes et tout le matériel technique sont fournis par le studio. Si vous souhaitez acheter vos propres gants par la suite, on vous conseille sur la taille et la marque adaptées à vos mains.",
    },
    {
        question: "Y a-t-il du contact physique ?",
        answer: "Non. Nos séances sont sans contact par défaut. Vous frappez le sac et les pattes d'ours, jamais une autre personne. Le sparring n'est introduit que bien plus tard, sur demande explicite, après une progression technique validée par le coach.",
    },
    {
        question: "Faut-il être en bonne condition physique pour commencer ?",
        answer: "Non. La boxe s'adapte à votre condition actuelle. L'intensité est ajustée en temps réel — chaque exercice a une version accessible et une version avancée. Nos élèves vont du profil sédentaire complet à la sportive confirmée.",
    },
    {
        question: "À quelle fréquence s'entraîner pour voir des résultats ?",
        answer: "Deux séances par semaine est un bon rythme pour débuter. Les progrès (énergie, tonus, aisance dans le geste) dépendent de chacune et de la régularité ; le coach les suit avec vous, séance après séance.",
    },
    {
        question: "Comment s'habiller pour un cours de boxe ?",
        answer: "Un legging ou short confortable, un t-shirt ou brassière de sport, des baskets propres à semelle plate de préférence. Nous fournissons serviettes et vestiaires avec douches. Une tenue dans laquelle vous bougez librement suffit.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Cours de Boxe pour Femmes à Genève",
                description: metadata.description,
                url: "https://bisrepetita.ch/services/boxe-femme",
                serviceType: "Cours de boxe pour femmes",
            }}
        />
        <Schema
            type="Person"
            data={{
                title: "Nicolas de Boccard",
                description: "Head Coach & Fondateur de Bis Repetita. Dans la boxe depuis 2002, entraineur agréé Swiss Boxing. Licencié SwissBoxing #102860.",
            }}
        />
        <Schema
            type="FAQPage"
            data={{
                faqs: faqs.map((f) => ({
                    question: f.question,
                    answer: f.answer.replace(/<[^>]*>/g, ""),
                })),
            }}
        />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Programmes", href: "/services" },
                    { name: "Boxe Femme", href: "/services/boxe-femme" },
                ],
            }}
        />
    </Fragment>

    <Hero
        title={`Boxe <span class="text-primary">Femme</span> à Genève`}
        description="Un coaching de boxe pensé pour les femmes. Cadre privé, intensité ajustée, aucun contact imposé. Que vous n'ayez jamais mis de gants ou que vous boxiez déjà."
        image={coursPortrait}
        imageAlt="Nicolas de Boccard tient les pattes d'ours face à une élève au studio"
        locationBadge={{ text: "La Voie-Creuse 16, 1202 Genève" }}
        actions={[
            { text: "Réserver une séance", href: "/#planning" },
            { text: "Voir les tarifs", href: "#tarifs" },
        ]}
    />

    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            Se tonifier, gagner en souffle, apprendre un vrai geste technique.
            <span class="soft">Dans un studio privé, avec un coach qui ajuste la séance à vous, et à votre forme du jour.</span>
        </p>
        <dl class="facts">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>

    <Features
        id="pourquoi"
        title="Ce que la boxe apporte aux femmes"
        features={features}
        columns={3}
        headlineAlign="left"
        bento="2-3"
    />

    <SplitShowcase
        title="60 minutes pensées pour vous"
        image={cours2Landscape}
        imageAlt="Cours de boxe au studio Bis Repetita, une élève au premier plan"
        items={[
            {
                title: "Échauffement et mobilité",
                description: "Corde, shadow boxing, mobilité. Le corps se prépare progressivement.",
            },
            {
                title: "Technique aux pattes d'ours",
                description: "Le cœur de la séance. Le coach tient les pattes et corrige chaque geste : jab, direct, crochet, les fondamentaux de la boxe anglaise.",
            },
            {
                title: "Circuit et retour au calme",
                description: "Tonification (abdos, bras, jambes), cardio, puis étirements et débrief.",
            },
        ]}
    />

    <section class="section wrap cycle" id="cycle">
        <div class="cycle-head">
            <h2 class="t-title" data-split>Selon les phases du cycle</h2>
            <p>Si vous le souhaitez, le coach adapte la séance à la phase de votre cycle : plus explosive et cardio en phase haute, plus technique en phase basse. C'est une proposition, pas une règle. Votre ressenti du jour passe en premier.</p>
            <a href="/blog/boxe-regles-cycle-menstruel" class="link-line">Boxer pendant ses règles : ce qu'il faut savoir</a>
        </div>
        <dl class="cycle-list">
            {phases.map((ph) => (
                <div><dt>{ph.k}</dt><dd>{ph.v}</dd></div>
            ))}
        </dl>
    </section>

    <ContentShowcase
        title="Les questions qu'on se pose avant de commencer"
        image={ambianceBis}
        imageAlt="Échauffement à la corde à sauter au studio"
        isReversed={true}
        items={[
            {
                title: "Le contact",
                description: "Aucun contact n'est imposé. Vous frappez le sac et les pattes d'ours, pas une autre personne. Le contact ne vient que si vous le demandez, après des mois de pratique.",
            },
            {
                title: "Être observée",
                description: "Studio privé, coaching de 1 à 3 personnes. Vous vous concentrez sur votre séance.",
            },
            {
                title: "Prendre du volume",
                description: "Le volume musculaire demande un entraînement de force et une alimentation spécifiques. La boxe travaille surtout l'endurance, la tonicité et la coordination.",
            },
            {
                title: "La douleur",
                description: "Les courbatures des premiers jours passent. Les gants et les bandes protègent mains et poignets. L'intensité monte progressivement, selon votre condition.",
            },
        ]}
    />

    <PricingTable id="tarifs" title="Quelle formule choisir ?" tiers={tiers} />

    <RelatedServices currentSlug="boxe-femme" />

    <FAQ
        title="Questions fréquentes"
        subtitle="La boxe pour les femmes à Genève, en pratique."
        items={faqs}
    />

    <CTABanner
        variant="brushed-full"
        title="Prête à essayer ?"
        cta={{ text: "Réserver une séance", href: "/#planning" }}
    />
</BaseLayout>

<style>
    .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro-lead { max-width: 24ch; }
    .facts { border-top: 1px solid var(--line); }
    .facts div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
    .facts dt { color: var(--gray-2); }
    .facts dd { text-align: right; }
    @media (max-width: 860px) {
        .intro { grid-template-columns: 1fr; }
    }
    .cycle { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 40px clamp(40px, 8vw, 160px); align-items: start; }
    .cycle-head { display: grid; gap: 20px; justify-items: start; }
    .cycle-head p { color: var(--gray-1); max-width: 42ch; }
    .cycle-list { border-top: 1px solid var(--ink); }
    .cycle-list div { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 8px 24px; padding: 22px 0; border-bottom: 1px solid var(--line); }
    .cycle-list dt { font-weight: 500; }
    .cycle-list dd { color: var(--gray-1); }
    @media (max-width: 860px) {
        .cycle, .cycle-list div { grid-template-columns: 1fr; }
    }
</style>
