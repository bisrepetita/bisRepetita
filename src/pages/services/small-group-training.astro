---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/widgets/Hero.astro";
import SplitShowcase from "../../components/widgets/SplitShowcase.astro";
import ContentShowcase from "../../components/widgets/ContentShowcase.astro";
import Features from "../../components/widgets/Features.astro";
import PricingTable from "../../components/widgets/PricingTable.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import ZenamuCalendar from "../../components/widgets/ZenamuCalendar.astro";
import RelatedServices from "../../components/widgets/RelatedServices.astro";
import Schema from "../../components/seo/Schema.astro";
import cours2Landscape from "../../assets/cours-2-landscape.webp";
import coursPortrait from "../../assets/cours-portrait.webp";
import ambianceBis from "../../assets/ambiance-bis-repetita.webp";

const metadata = {
    title: "Cours Boxe Petit Groupe Genève",
    description:
        "Cours de boxe en petit groupe à Genève, de 2 à 8 personnes. Encadrement sur mesure par Nicolas de Boccard dans un studio privé, près des Nations.",
};

const facts = [
    { k: "Effectif", v: "2 à 8 personnes, groupe stable" },
    { k: "Durée", v: "60 minutes" },
    { k: "Coach", v: "Nicolas de Boccard" },
    { k: "Niveau requis", v: "Aucun" },
    { k: "Matériel", v: "Gants et sous-gants prêtés" },
];

const features = [
    {
        title: "Un petit groupe",
        description:
            "Pas de file d'attente, pas de machines. De 2 à 8 personnes, avec un coach qui connaît chacun.",
        icon: "lucide:shield",
    },
    {
        title: "L'énergie du groupe",
        description:
            "Le groupe porte l'effort, round après round.",
        icon: "lucide:flame",
    },
    {
        title: "Corrections individuelles",
        description:
            "Le coach corrige les gestes de chacun et adapte l'intensité à chaque profil.",
        icon: "lucide:eye",
    },
    {
        title: "Des visages connus",
        description:
            "On se retrouve d'une séance à l'autre, on se connaît, on se motive.",
        icon: "lucide:heart-handshake",
    },
    {
        title: "Tarif partagé",
        description:
            "Le prix est celui du groupe, à partager : par personne, moins cher qu'en solo.",
        icon: "lucide:wallet",
    },
];

const tiers = [
    {
        name: "Séance unité",
        description: "Un cours small group à la carte.",
        price: "CHF 200.-",
        priceNote: "/ séance",
        features: [
            "60 minutes de coaching",
            "Prix du groupe, à partager",
            "Programme structuré",
            "Matériel fourni",
        ],
        cta: { text: "Réserver une séance", href: "#planning" },
    },
    {
        name: "Pack 10 séances",
        description: "Pour un suivi régulier.",
        price: "CHF 1'800.-",
        priceNote: "/ 10 séances",
        highlighted: true,
        features: [
            "10 × 60 minutes",
            "Prix du groupe, à partager",
            "Suivi de progression",
            "Matériel fourni",
            "Tarif préférentiel",
        ],
        cta: { text: "Réserver une séance", href: "#planning" },
    },
];

const faqs = [
    {
        question: "Pourquoi 8 personnes maximum ?",
        answer: "C'est le seuil au-delà duquel la qualité du coaching se dégrade. De 2 à 8, Nicolas peut corriger chaque geste, adapter l'intensité à chacun et garder une ambiance de club privé.",
    },
    {
        question: "Quelle est la différence avec les cours Round by Round ?",
        answer: "Le <a href='/services/round-by-round' class='link-line'>Round by Round</a> accueille jusqu'à 8 participants avec 1 coach et suit un format très structuré en rounds chronométrés. Le small group training offre plus de flexibilité dans le programme.",
    },
    {
        question: "Faut-il venir avec son propre groupe ?",
        answer: "Non. Vous pouvez vous inscrire seul et rejoindre un groupe existant. Nicolas compose les groupes en fonction des niveaux et des disponibilités. Vous pouvez aussi réserver un créneau privé avec votre propre groupe, par exemple entre amies ou entre collègues. Dans tous les cas, le groupe est stable : on s'engage à venir régulièrement.",
    },
    {
        question: "Le small group convient-il aux débutants ?",
        answer: "Oui. Nicolas adapte les exercices au niveau de chacun au sein du même groupe. Si vous préférez commencer dans un format plus intimiste, <a href='/services/coaching-prive' class='link-line'>découvrez nos autres formats de coaching privé</a> (solo ou duo).",
    },
    {
        question: "Quels sont les tarifs du small group training ?",
        answer: "Le small group est notre format privé le plus accessible par personne : CHF 200 la séance pour le groupe, à partager, à l'unité ou en pack de 10 avec tarif préférentiel. Le prix par personne est nettement inférieur au coaching solo. Consultez nos <a href='/tarifs' class='link-line'>tarifs détaillés</a> ou <a href='/contact' class='link-line'>contactez-nous</a>.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Cours de Boxe Petit Groupe à Genève",
                description: metadata.description,
                url: "https://bisrepetita.ch/services/small-group-training",
                serviceType: "Coaching sportif petit groupe",
                parentService: { name: "Coaching Privé de Boxe", url: "https://bisrepetita.ch/services/coaching-prive" },
            }}
        />
        <Schema
            type="Person"
            data={{
                title: "Nicolas de Boccard",
                description: "Head Coach & Fondateur de Bis Repetita. Dans la boxe depuis 2002, entraineur agréé Swiss Boxing. Licencié SwissBoxing #102860.",
            }}
        />
        <Schema type="FAQPage" data={{ faqs: faqs.map(f => ({ question: f.question, answer: f.answer.replace(/<[^>]*>/g, '') })) }} />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Programmes", href: "/services" },
                    { name: "Coaching Privé", href: "/services/coaching-prive" },
                    { name: "Small Group Training", href: "/services/small-group-training" },
                ],
            }}
        />
    </Fragment>
    <Hero
        title={`<span class="text-primary">Small Group</span> Training à Genève`}
        description="L'énergie d'un groupe, la précision d'un cours privé. De 2 à 8 personnes, un coach, un programme structuré, dans un studio privé au cœur de Genève."
        image={cours2Landscape}
        imageAlt="Cours de boxe en petit groupe au studio Bis Repetita"
        locationBadge={{ text: "La Voie-Creuse 16, 1202 Genève" }}
        actions={[
            { text: "Réserver une séance", href: "#planning" },
            { text: "Voir les tarifs", href: "/tarifs" },
        ]}
    />
    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            Le coaching privé, avec l'énergie d'un groupe.
            <span class="soft">Un groupe volontairement réduit et stable, de 2 à 8 personnes.</span>
        </p>
        <dl class="facts">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>
        <SplitShowcase
            id="pourquoi-6"
            title="Pourquoi un petit groupe"
            image={coursPortrait}
            imageAlt="Nicolas de Boccard corrige une élève aux pattes d'ours"
            items={[
                {
                    title: "Corrections individuelles",
                    description: "Dans un petit groupe, Nicolas observe et corrige les gestes de chacun pendant la séance.",
                },
                {
                    title: "Intensité adaptée",
                    description: "Chacun travaille à son rythme au sein du même groupe. Les exercices sont modulés en intensité et en complexité selon les niveaux.",
                },
                {
                    title: "Ambiance de club privé",
                    description: "On se connaît, on se retrouve, on se motive d'une séance à l'autre.",
                },
            ]}
        />
        <PricingTable
            title="Formules small group training"
            tiers={tiers}
            columns={2}
        />
        <Features
            id="avantages"
            title="Ce que change le small group"
            features={features}
            bento="2-3"
        />
        <ContentShowcase
            title="Méthode Round by Round appliquée au petit groupe"
            image={ambianceBis}
            imageAlt="Échauffement à la corde à sauter pendant un cours"
            isReversed={true}
            items={[
                {
                    title: "Structure en rounds",
                    description: "Chaque séance suit le format Round by Round : rounds chronométrés, récupération active, intensité qui monte progressivement.",
                },
                {
                    title: "Technique et physique fusionnés",
                    description: "Chaque round mêle boxe anglaise et préparation physique.",
                },
                {
                    title: "L'énergie du groupe en plus",
                    description: "Le groupe porte l'effort. On se pousse mutuellement, round après round.",
                },
            ]}
            actions={[
                {
                    text: "Découvrir le Round by Round",
                    href: "/services/round-by-round",
                    variant: "secondary",
                },
            ]}
        />
    <RelatedServices currentSlug="small-group-training" />
        <FAQ
            id="faq"
            title="Questions fréquentes"
            subtitle="Le small group training à Genève, en pratique."
            items={faqs}
        />
        <ZenamuCalendar id="planning" title="Réserver une séance en petit groupe" />
</BaseLayout>

<style>
    .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro-lead { max-width: 24ch; }
    .facts { border-top: 1px solid var(--line); }
    .facts div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
    .facts dt { color: var(--gray-2); }
    .facts dd { text-align: right; }
    @media (max-width: 860px) {
        .intro { grid-template-columns: 1fr; }
    }
</style>
