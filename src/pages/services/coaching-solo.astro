---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/widgets/Hero.astro";
import SplitShowcase from "../../components/widgets/SplitShowcase.astro";
import ContentShowcase from "../../components/widgets/ContentShowcase.astro";
import EquipmentPanels from "../../components/widgets/EquipmentPanels.astro";
import PricingTable from "../../components/widgets/PricingTable.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import ZenamuCalendar from "../../components/widgets/ZenamuCalendar.astro";
import RelatedServices from "../../components/widgets/RelatedServices.astro";
import Schema from "../../components/seo/Schema.astro";
import nicolasPortrait from "../../assets/nicolas-portrait.webp";
import ambianceBis from "../../assets/ambiance-bis-repetita.webp";
import lionelNicolas from "../../assets/lionel-nicolas-boxe.webp";
import salle1 from "../../assets/salle-1.webp";
import imageCta from "../../assets/image-cta.webp";
import cours2Landscape from "../../assets/cours-2-landscape.webp";
import homepage from "../../assets/homepage.webp";

const metadata = {
    title: "Coach Personnel Boxe Genève",
    description:
        "Votre coach personnel de boxe à Genève. Séances individuelles sur mesure avec Nicolas de Boccard : technique, physique et mental. Séance d'essai gratuite.",
};

const facts = [
    { k: "Participants", v: "1 personne" },
    { k: "Durée", v: "60 minutes" },
    { k: "Coach", v: "Nicolas de Boccard, 20 ans de pratique" },
    { k: "Niveau requis", v: "Aucun" },
    { k: "Matériel", v: "Gants et bandes fournis" },
];

const pourQuiPanels = [
    {
        title: "Cadres et dirigeants",
        description:
            "Concentration, discipline, une heure où l'on ne pense qu'au geste. Dans un cadre confidentiel.",
        image: salle1,
        alt: "Serviettes pliées au vestiaire du studio Bis Repetita",
    },
    {
        title: "Reprise après une pause",
        description:
            "Retour au sport après une blessure ou une longue pause. Une progression adaptée à vos contraintes, en lien avec votre médecin si nécessaire.",
        image: ambianceBis,
        alt: "Corde à sauter et échauffement au studio",
    },
    {
        title: "Sportifs d'autres disciplines",
        description:
            "Un complément de préparation physique : explosivité, coordination, cardio.",
        image: imageCta,
        alt: "Travail aux pattes d'ours entre deux boxeurs",
    },
    {
        title: "Condition physique",
        description:
            "Se tonifier, gagner en cardio, retrouver de l'énergie. Le programme suit votre objectif, séance après séance.",
        image: cours2Landscape,
        alt: "Séance de coaching de boxe au studio",
    },
];

const tiers = [
    {
        name: "À la séance",
        description: "Une séance de coaching individuel, sans engagement.",
        price: "CHF 120.-",
        priceNote: "/ séance",
        features: [
            "60 minutes de coaching individuel",
            "Bilan personnalisé",
            "Matériel fourni (gants, bandes)",
            "Sans engagement",
        ],
        cta: { text: "Réserver une séance", href: "#planning" },
    },
    {
        name: "Pack 10 séances",
        description: "Pour un suivi régulier, avec un programme qui se construit d'une séance à l'autre.",
        price: "CHF 1'100.-",
        priceNote: "/ 10 séances",
        highlighted: true,
        features: [
            "10 × 60 minutes de coaching",
            "Programme personnalisé",
            "Suivi de progression",
            "Matériel fourni",
            "Tarif préférentiel",
        ],
        cta: { text: "Réserver une séance", href: "#planning" },
    },
];

const faqs = [
    {
        question: "Quelle est la différence entre le coaching solo et les autres formats ?",
        answer: "Le coaching solo est un face-à-face exclusif avec Nicolas : 100% de l'attention, 100% de la personnalisation. D'autres formats existent (duo, trio, petit groupe) avec des dynamiques différentes. <a href='/services/coaching-prive' class='link-line'>Découvrez nos autres formats de coaching privé</a> pour trouver celui qui vous correspond.",
    },
    {
        question: "Le coaching solo est-il adapté aux débutants complets ?",
        answer: "Absolument. C'est même le format idéal pour débuter : Nicolas construit les bases techniques à votre rythme, sans pression du groupe. Posture, garde, déplacements — tout est enseigné progressivement.",
    },
    {
        question: "Puis-je combiner le coaching solo avec d'autres formats ?",
        answer: "C'est même recommandé. Le solo approfondit la technique, les <a href='/services/round-by-round' class='link-line'>cours collectifs Round by Round</a> travaillent le cardio et le mental dans l'énergie du groupe. Les deux se complètent parfaitement.",
    },
    {
        question: "À quelle fréquence faut-il s'entraîner en solo ?",
        answer: "Deux à trois séances par semaine permettent une progression régulière. Une séance hebdomadaire suffit déjà pour avancer. Nicolas adapte le programme à votre rythme de vie.",
    },
    {
        question: "Quels sont les tarifs du coaching solo ?",
        answer: "Le coaching solo est disponible à la séance ou en pack de 10 séances avec tarif préférentiel. Les packs offrent un meilleur rapport qualité-prix et un suivi de progression structuré. Consultez nos <a href='/tarifs' class='link-line'>tarifs détaillés</a> ou <a href='/contact' class='link-line'>contactez-nous</a>.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Coach Personnel de Boxe à Genève",
                description: metadata.description,
                url: "https://bisrepetita.ch/services/coaching-solo",
                serviceType: "Coaching sportif individuel",
                parentService: { name: "Coaching Privé de Boxe", url: "https://bisrepetita.ch/services/coaching-prive" },
            }}
        />
        <Schema
            type="Person"
            data={{
                title: "Nicolas de Boccard",
                description: "Head Coach & Fondateur de Bis Repetita. Dans la boxe depuis 2002, entraineur agréé Swiss Boxing. Licencié SwissBoxing #102860.",
            }}
        />
        <Schema type="FAQPage" data={{ faqs: faqs.map(f => ({ question: f.question, answer: f.answer.replace(/<[^>]*>/g, '') })) }} />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Programmes", href: "/services" },
                    { name: "Coaching Privé", href: "/services/coaching-prive" },
                    { name: "Coaching Solo", href: "/services/coaching-solo" },
                ],
            }}
        />
    </Fragment>

    <Hero
        title={`Coaching Sportif <span class="text-primary">Solo</span> à Genève`}
        description="Un coach, une personne. Nicolas de Boccard construit chaque séance autour de vos objectifs, dans un studio privé au cœur de Genève."
        locationBadge={{ text: "La Voie-Creuse 16, 1202 Genève" }}
        image={homepage}
        imageAlt="Travail aux pattes d'ours avec Nicolas de Boccard au studio"
        actions={[
            { text: "Réserver une séance", href: "#planning" },
            { text: "Voir les tarifs", href: "/tarifs" },
        ]}
    />

    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            Le coaching solo est le format le plus direct.
            <span class="soft">Toute l'attention du coach, un programme construit pour vous seul.</span>
        </p>
        <dl class="facts">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>

    <SplitShowcase
        id="approche"
        title="Un coaching complet : technique, physique, mental"
        image={nicolasPortrait}
        imageAlt="Nicolas de Boccard, coach personnel de boxe à Genève"
        isReversed={true}
        items={[
            {
                title: "Technique de boxe anglaise",
                description: "Jab, direct, crochets, esquives, déplacements. Les fondamentaux, enseignés avec précision et adaptés à votre niveau.",
            },
            {
                title: "Préparation physique intégrée",
                description: "Renforcement, explosivité, cardio. Technique et physique se travaillent dans la même séance.",
            },
            {
                title: "Concentration",
                description: "Rester attentif au geste, gérer l'effort, garder son calme sous la fatigue. Ce travail sert aussi en dehors du studio.",
            },
        ]}
    />

    <PricingTable title="Formules coaching solo" tiers={tiers} columns={2} />

    <ContentShowcase
        title="60 minutes, quatre phases"
        image={lionelNicolas}
        imageAlt="Deux coachs font le point au bord du ring"
        items={[
            {
                title: "Échauffement, 10 min",
                description: "Mobilité, corde à sauter, shadow boxing. Le corps se prépare, le cardio monte progressivement.",
            },
            {
                title: "Technique, 20 à 25 min",
                description: "Pattes d'ours et sac de frappe. Enchaînements, esquives, contre-attaques, avec le coach sur chacun de vos gestes.",
            },
            {
                title: "Préparation physique, 15 à 20 min",
                description: "Un circuit ciblé : renforcement, explosivité, cardio, dosés selon votre condition du jour.",
            },
            {
                title: "Bilan, 5 min",
                description: "Retour au calme, étirements, débrief. On prépare la séance suivante.",
            },
        ]}
    />

    <EquipmentPanels
        id="pour-qui"
        title="Pour qui ?"
        panels={pourQuiPanels}
    />

    <RelatedServices currentSlug="coaching-solo" />

    <FAQ
        id="faq"
        title="Questions fréquentes"
        subtitle="Le coaching solo à Genève, en pratique."
        items={faqs}
    />

    <ZenamuCalendar id="planning" title="Réserver une séance solo" />
</BaseLayout>

<style>
    .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro-lead { max-width: 24ch; }
    .facts { border-top: 1px solid var(--line); }
    .facts div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
    .facts dt { color: var(--gray-2); }
    .facts dd { text-align: right; }
    @media (max-width: 860px) {
        .intro { grid-template-columns: 1fr; }
    }
</style>
