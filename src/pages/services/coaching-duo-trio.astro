---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/widgets/Hero.astro";
import SplitShowcase from "../../components/widgets/SplitShowcase.astro";
import ContentShowcase from "../../components/widgets/ContentShowcase.astro";
import Features from "../../components/widgets/Features.astro";
import PricingTable from "../../components/widgets/PricingTable.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import ZenamuCalendar from "../../components/widgets/ZenamuCalendar.astro";
import RelatedServices from "../../components/widgets/RelatedServices.astro";
import Schema from "../../components/seo/Schema.astro";
import ambianceBis from "../../assets/ambiance-bis-repetita.webp";
import imageCta from "../../assets/image-cta.webp";
import lionelNicolas from "../../assets/lionel-nicolas-boxe.webp";

const metadata = {
    title: "Boxe en Duo & Trio à Genève",
    description:
        "Boxe en duo ou trio à Genève. Entre amis, en couple ou entre collègues. Tarif partagé, coaching intact.",
};

const facts = [
    { k: "Participants", v: "2 ou 3 personnes" },
    { k: "Durée", v: "60 minutes" },
    { k: "Tarif", v: "Prix par séance, partagé" },
    { k: "Niveau requis", v: "Aucun, niveaux mélangés possibles" },
    { k: "Matériel", v: "Gants et sous-gants prêtés" },
];

const features = [
    {
        title: "Émulation naturelle",
        description:
            "À deux ou trois, on se motive l'un l'autre, round après round.",
        icon: "lucide:flame",
    },
    {
        title: "Coaching toujours personnalisé",
        description:
            "Même à deux ou trois, les exercices sont adaptés au niveau de chacun.",
        icon: "lucide:settings",
    },
    {
        title: "Tarif partagé",
        description:
            "Le prix de la séance se partage. L'exigence du coaching reste la même.",
        icon: "lucide:wallet",
    },
    {
        title: "Un moment partagé",
        description:
            "On partage l'effort et les progrès. L'entraînement devient un rendez-vous commun.",
        icon: "lucide:smile",
    },
];

const tiers = [
    {
        name: "Séance duo",
        description: "S'entraîner à deux avec un coaching personnalisé.",
        price: "CHF 140.-",
        priceNote: "/ séance (prix total)",
        features: [
            "60 minutes de coaching",
            "2 participants",
            "Programme adapté à chacun",
            "Matériel fourni",
        ],
        cta: { text: "Réserver une séance", href: "#planning" },
    },
    {
        name: "Séance trio",
        description: "S'entraîner à trois avec un coaching personnalisé.",
        price: "CHF 160.-",
        priceNote: "/ séance (prix total)",
        highlighted: true,
        features: [
            "60 minutes de coaching",
            "3 participants",
            "Programme adapté au groupe",
            "Matériel fourni",
        ],
        cta: { text: "Réserver une séance", href: "#planning" },
    },
];

const faqs = [
    {
        question: "Faut-il être du même niveau pour s'entraîner en duo ou trio ?",
        answer: "Pas du tout. Les exercices sont adaptés au niveau de chacun au sein du même groupe. Un débutant et un pratiquant confirmé peuvent très bien s'entraîner ensemble — chacun progresse à son rythme.",
    },
    {
        question: "Avec qui puis-je venir ?",
        answer: "Avec qui vous voulez : conjoint, ami, collègue, membre de la famille. Le format duo & trio fonctionne avec n'importe quelle combinaison — l'essentiel est l'envie de progresser ensemble.",
    },
    {
        question: "Quelle est la différence avec les autres formats de coaching privé ?",
        answer: "Le duo & trio offre une dimension d'émulation et de partage, avec un tarif par personne plus accessible que le solo. D'autres formats existent selon vos besoins. <a href='/services/coaching-prive' class='link-line'>Comparez les 3 formats de coaching privé</a> pour choisir le vôtre.",
    },
    {
        question: "Comment se déroule une séance duo ou trio ?",
        answer: "Le format est le même que le solo — échauffement, technique, physique, bilan — mais enrichi par des exercices à deux (travail de réaction, enchaînements croisés). La séance dure 60 minutes.",
    },
    {
        question: "Quels sont les tarifs du coaching duo & trio ?",
        answer: "Le duo est facturé par séance (prix global, pas par personne), ce qui rend le coaching partagé très accessible. Packs de séances disponibles avec tarif dégressif. Consultez nos <a href='/tarifs' class='link-line'>tarifs détaillés</a> ou <a href='/contact' class='link-line'>contactez-nous</a>.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Boxe en Duo & Trio à Genève",
                description: metadata.description,
                url: "https://bisrepetita.ch/services/coaching-duo-trio",
                serviceType: "Coaching sportif duo et trio",
                parentService: { name: "Coaching Privé de Boxe", url: "https://bisrepetita.ch/services/coaching-prive" },
            }}
        />
        <Schema
            type="Person"
            data={{
                title: "Nicolas de Boccard",
                description: "Head Coach & Fondateur de Bis Repetita. Dans la boxe depuis 2002, entraineur agréé Swiss Boxing. Licencié SwissBoxing #102860.",
            }}
        />
        <Schema type="FAQPage" data={{ faqs: faqs.map(f => ({ question: f.question, answer: f.answer.replace(/<[^>]*>/g, '') })) }} />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Programmes", href: "/services" },
                    { name: "Coaching Privé", href: "/services/coaching-prive" },
                    { name: "Coaching Duo & Trio", href: "/services/coaching-duo-trio" },
                ],
            }}
        />
    </Fragment>
    <Hero
        title={`Coaching <span class="text-primary">Duo & Trio</span> à Genève`}
        description="La boxe anglaise à deux ou trois, avec un coaching sur mesure. Dans un studio privé au cœur de Genève."
        locationBadge={{ text: "La Voie-Creuse 16, 1202 Genève" }}
        image={imageCta}
        imageAlt="Deux boxeurs travaillent aux pattes d'ours au studio"
        actions={[
            { text: "Réserver une séance", href: "#planning" },
            { text: "Voir les tarifs", href: "/tarifs" },
        ]}
    />
    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            Un coaching sur mesure, partagé avec votre partenaire d'entraînement.
            <span class="soft">Le suivi reste individuel, le prix de la séance se partage.</span>
        </p>
        <dl class="facts">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>
        <SplitShowcase
            id="deroulement"
            title="Une séance structurée, enrichie par le groupe"
            image={ambianceBis}
            imageAlt="Échauffement à la corde à sauter au studio Bis Repetita"
            items={[
                {
                    title: "Échauffement collectif",
                    description: "Mobilité, corde à sauter, shadow boxing. On démarre ensemble.",
                },
                {
                    title: "Technique à deux",
                    description: "Travail de réaction, enchaînements croisés, exercices en miroir. Le partenaire apporte ce que le solo n'a pas.",
                },
                {
                    title: "Challenge physique partagé",
                    description: "Circuit en binôme, défis chronométrés. Chacun à son niveau, sans esprit de compétition.",
                },
            ]}
        />
        <PricingTable
            title="Formules duo & trio"
            tiers={tiers}
            columns={2}
        />
        <Features
            id="avantages"
            title="Pourquoi à deux ou à trois ?"
            features={features}
            columns={3}
        />
        <ContentShowcase
            title="Entre le cours collectif et le solo"
            image={lionelNicolas}
            imageAlt="Deux coachs échangent au bord du ring"
            isReversed={true}
            items={[
                {
                    title: "Plus qu'un cours collectif",
                    description: "Le coach connaît chacun : son niveau, ses points forts, ce qu'il doit travailler.",
                },
                {
                    title: "Plus accessible que le solo",
                    description: "Le tarif par personne est plus bas qu'en coaching individuel. L'encadrement reste sur mesure.",
                },
                {
                    title: "L'engagement mutuel",
                    description: "À deux, on annule moins. Le partenaire aide à tenir le rythme.",
                },
            ]}
        />
    <RelatedServices currentSlug="coaching-duo-trio" />
        <FAQ
            id="faq"
            title="Questions fréquentes"
            subtitle="Le coaching duo & trio à Genève, en pratique."
            items={faqs}
        />
        <ZenamuCalendar id="planning" title="Réserver une séance duo ou trio" />
</BaseLayout>

<style>
    .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro-lead { max-width: 24ch; }
    .facts { border-top: 1px solid var(--line); }
    .facts div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
    .facts dt { color: var(--gray-2); }
    .facts dd { text-align: right; }
    @media (max-width: 860px) {
        .intro { grid-template-columns: 1fr; }
    }
</style>
