---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/widgets/Hero.astro";
import SplitShowcase from "../../components/widgets/SplitShowcase.astro";
import FAQ from "../../components/widgets/FAQ.astro";
import RelatedArticles from "../../components/widgets/RelatedArticles.astro";
import CTABanner from "../../components/widgets/CTABanner.astro";
import Schema from "../../components/seo/Schema.astro";
import coursPortrait from "../../assets/cours-portrait.webp";
import cours2Landscape from "../../assets/cours-2-landscape.webp";

const metadata = {
    title: "Coach Boxe Genève — Coaching Privé",
    description:
        "Votre coach boxe à Genève. Nicolas de Boccard propose 4 formats de coaching privé : solo, duo, petit groupe ou domicile. Séance d'essai offerte.",
};

const facts = [
    { k: "Effectif", v: "1 à 8 personnes" },
    { k: "Durée", v: "60 minutes" },
    { k: "Coach", v: "Nicolas de Boccard, 20 ans de pratique" },
    { k: "Niveau requis", v: "Aucun" },
    { k: "Lieu", v: "Studio privé ou à domicile" },
];

const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;

const formats = [
    {
        title: "Coaching solo",
        description: "Un coach, une personne. Le contenu suit vos objectifs.",
        href: "/services/coaching-solo",
        people: "1 personne",
        ideal: "Progression individuelle, confidentialité",
        price: "CHF 120",
    },
    {
        title: "Duo & Trio",
        description: "À deux ou trois : le coût se partage, le suivi reste individuel.",
        href: "/services/coaching-duo-trio",
        people: "2 à 3 personnes",
        ideal: "Entre amis, en couple, entre collègues",
        price: "dès CHF 140",
    },
    {
        title: "Small Group",
        description: "L'énergie d'un groupe, la précision d'un cours privé.",
        href: "/services/small-group-training",
        people: "4 à 8 personnes",
        ideal: "Dynamique de groupe, tarif partagé",
        price: "Prix par personne",
    },
    {
        title: "À domicile",
        description: "Le coach et le matériel viennent chez vous, partout à Genève.",
        href: "/services/coaching-boxe-domicile",
        people: "1 à 3 personnes",
        ideal: "Gain de temps, confort, discrétion",
        price: "dès CHF 150",
    },
];

const faqs = [
    {
        question: "Quelle est la différence entre coaching solo, duo et small group ?",
        answer: "Le <a href='/services/coaching-solo' class='link-line'>coaching solo</a> est un face-à-face exclusif avec Nicolas, 100% personnalisé. Le <a href='/services/coaching-duo-trio' class='link-line'>coaching duo & trio</a> permet de s'entraîner à 2 ou 3 avec un programme adapté au groupe. Le <a href='/services/small-group-training' class='link-line'>small group training</a> réunit 4 à 8 personnes pour une dynamique collective avec un encadrement sur mesure. Et pour ceux qui préfèrent s'entraîner chez eux, le <a href='/services/coaching-boxe-domicile' class='link-line'>coaching à domicile</a> apporte le studio directement à votre porte.",
    },
    {
        question: "Faut-il un niveau minimum pour commencer ?",
        answer: "Aucun niveau n'est requis. Que vous choisissiez le <a href='/services/coaching-solo' class='link-line'>solo</a>, le <a href='/services/coaching-duo-trio' class='link-line'>duo</a> ou le <a href='/services/small-group-training' class='link-line'>small group</a>, le programme est entièrement adapté à votre niveau — du débutant complet au boxeur confirmé.",
    },
    {
        question: "Comment se déroule la première séance ?",
        answer: "La première séance commence par un échange sur vos objectifs et votre condition physique. On passe ensuite aux fondamentaux : posture, garde, déplacements et premiers enchaînements. L'objectif est de vous donner un aperçu concret du coaching.",
    },
    {
        question: "Dois-je apporter mon propre matériel ?",
        answer: "Non, tout le matériel est fourni : gants, bandes, protections. Venez simplement en tenue de sport avec une bouteille d'eau.",
    },
    {
        question: "À quelle fréquence faut-il s'entraîner ?",
        answer: "Nous recommandons 2 à 3 séances par semaine pour une progression régulière. Une séance hebdomadaire suffit déjà pour avancer. Vous pouvez aussi combiner le coaching privé avec nos <a href='/services/round-by-round' class='link-line'>cours collectifs Round by Round</a> pour varier les formats.",
    },
    {
        question: "Quels sont les tarifs du coaching privé ?",
        answer: "Les tarifs varient selon le format choisi : solo (séances individuelles), duo/trio (prix global par séance) et small group (prix par personne, 4 à 8 personnes). Consultez nos <a href='/tarifs' class='link-line'>tarifs détaillés</a> ou <a href='/contact' class='link-line'>contactez-nous</a> pour un devis personnalisé.",
    },
];
---

<BaseLayout {metadata}>
    <Fragment slot="head">
        <Schema
            type="Service"
            data={{
                title: "Coaching Privé de Boxe à Genève",
                description: metadata.description,
                url: "https://bisrepetita.ch/services/coaching-prive",
                serviceType: "Coach boxe privé à Genève",
                childServices: [
                    { name: "Coaching Solo", url: "https://bisrepetita.ch/services/coaching-solo" },
                    { name: "Coaching Duo & Trio", url: "https://bisrepetita.ch/services/coaching-duo-trio" },
                    { name: "Small Group Training", url: "https://bisrepetita.ch/services/small-group-training" },
                    { name: "Coaching à Domicile", url: "https://bisrepetita.ch/services/coaching-boxe-domicile" },
                ],
            }}
        />
        <Schema type="FAQPage" data={{ faqs: faqs.map(f => ({ question: f.question, answer: f.answer.replace(/<[^>]*>/g, '') })) }} />
        <Schema
            type="BreadcrumbList"
            data={{
                breadcrumbs: [
                    { name: "Accueil", href: "/" },
                    { name: "Programmes", href: "/services" },
                    { name: "Coaching Privé", href: "/services/coaching-prive" },
                ],
            }}
        />
    </Fragment>

    <Hero
        title={`Coaching Privé de <span class="text-primary">Boxe</span> à Genève`}
        description="Votre coach de boxe à Genève, Nicolas de Boccard. Du solo au petit groupe, un coaching de boxe anglaise construit autour de vos objectifs, dans un studio privé au cœur de Genève."
        locationBadge={{ text: "La Voie-Creuse 16, 1202 Genève" }}
        image={cours2Landscape}
        imageAlt="Cours de boxe en petit groupe au studio Bis Repetita"
        actions={[
            { text: "Réserver une séance", href: "/#planning" },
            { text: "Voir les tarifs", href: "/tarifs" },
        ]}
    />

    <section class="section wrap intro">
        <p class="t-lead intro-lead">
            Un programme construit autour de vos objectifs.
            <span class="soft">Que vous débutiez ou que vous boxiez depuis des années, le contenu suit votre niveau.</span>
        </p>
        <dl class="facts">
            {facts.map((f) => (
                <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
        </dl>
    </section>

    <SplitShowcase
        id="methode"
        title="Une méthode suivie, séance après séance"
        image={coursPortrait}
        imageAlt="Nicolas de Boccard tient les pattes d'ours face à une élève"
        items={[
            {
                title: "Un bilan pour commencer",
                description: "Objectifs, condition physique, contraintes. Le programme part de là.",
            },
            {
                title: "Une progression suivie",
                description: "Technique, physique, concentration : chaque séance prolonge la précédente. Vous savez d'où vous partez et où vous allez.",
            },
            {
                title: "Un cadre discret",
                description: "Studio privé, créneaux dédiés, vestiaires. Vous vous entraînez sans public.",
            },
        ]}
    />

    <section id="formats" class="section wrap">
        <div class="formats-head">
            <h2 class="t-title" data-split>Les 4 formats de coaching privé</h2>
            <p>Solo, duo, petit groupe ou à domicile. Chaque format répond à un besoin précis.</p>
        </div>
        <ul class="fmt-list">
            {formats.map((f) => (
                <li>
                    <a href={f.href} class="fmt-row">
                        <span class="fmt-t">{f.title}</span>
                        <span class="fmt-d">{f.description}<span class="fmt-ideal">Idéal pour : {f.ideal}</span></span>
                        <span class="fmt-m">{f.people}<br />{f.price}</span>
                        <span class="fmt-a" set:html={arrow} />
                    </a>
                </li>
            ))}
        </ul>
        <p class="fmt-note"><a href="/tarifs" class="link-line">Tous les tarifs</a></p>
    </section>

    <FAQ
        id="faq"
        title="Questions fréquentes"
        subtitle="Votre coach de boxe à Genève, en pratique."
        items={faqs}
    />

    <RelatedArticles title="Pourquoi choisir un studio privé pour votre coaching ?" />

    <CTABanner
        variant="brushed-full"
        title="Commencer votre coaching privé"
        cta={{ text: "Réserver une séance", href: "/#planning" }}
    />
</BaseLayout>

<style>
    .intro { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 160px); align-items: start; }
    .intro-lead { max-width: 24ch; }
    .facts { border-top: 1px solid var(--line); }
    .facts div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
    .facts dt { color: var(--gray-2); }
    .facts dd { text-align: right; }

    .formats-head { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 24px clamp(40px, 8vw, 160px); align-items: end; margin-bottom: clamp(32px, 4vw, 56px); }
    .formats-head p { color: var(--gray-1); max-width: 38ch; }
    .fmt-list { border-top: 1px solid var(--ink); }
    .fmt-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 0.7fr) 20px;
        gap: 24px;
        align-items: baseline;
        padding: 24px 0;
        border-bottom: 1px solid var(--line);
        transition: padding 0.6s var(--ease-out-expo);
    }
    .fmt-t { font-size: clamp(1.375rem, 2.2vw, 2rem); font-weight: 500; letter-spacing: var(--track-title); line-height: 1.1; }
    .fmt-d { color: var(--gray-1); font-size: 15px; }
    .fmt-ideal { display: block; margin-top: 6px; color: var(--gray-2); font-size: 14px; }
    .fmt-m { color: var(--gray-2); font-size: 14px; text-align: right; font-variant-numeric: tabular-nums; }
    .fmt-a { justify-self: end; opacity: 0; transition: opacity 0.4s; }
    .fmt-row:hover, .fmt-row:focus-visible { padding-left: 14px; }
    .fmt-row:hover .fmt-a, .fmt-row:focus-visible .fmt-a { opacity: 1; }
    .fmt-note { margin-top: 24px; font-size: 14px; }

    @media (max-width: 860px) {
        .intro, .formats-head { grid-template-columns: 1fr; }
        .fmt-row { grid-template-columns: minmax(0, 1fr) auto; gap: 8px 16px; }
        .fmt-d { grid-column: 1 / -1; grid-row: 2; }
        .fmt-a { display: none; }
    }
</style>
