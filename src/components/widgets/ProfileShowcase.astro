---
import ContentShowcase from "./ContentShowcase.astro";

// Photo N&B à gauche, profils en lignes à filet à droite. tagline ignoré.
interface Props {
    tagline?: string;
    title?: string;
    image: ImageMetadata;
    imageAlt?: string;
    items: Array<{ title: string; description: string }>;
    id?: string;
}

const { title, image, imageAlt = "", items = [], id } = Astro.props;
---

<ContentShowcase {id} {title} {image} {imageAlt} {items} isReversed />
