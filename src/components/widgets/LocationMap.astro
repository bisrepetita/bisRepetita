---
import WidgetWrapper from "./WidgetWrapper.astro";
import { siteConfig } from "../../config/site";

// Carte Google en niveaux de gris + coordonnées en lignes à filet. isDark ignoré.
interface Props {
    id?: string;
    isDark?: boolean;
    classes?: Record<string, string>;
    bg?: string;
}

const { id, classes = {}, bg } = Astro.props;
const { address, phone, email } = siteConfig.contact;
---

<WidgetWrapper id={id} bg={bg} classes={classes}>
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] md:gap-[clamp(32px,5vw,96px)]">
        <div class="aspect-[4/3] overflow-hidden bg-surface md:aspect-[16/10]">
            <iframe
                src={siteConfig.maps.embedUrl}
                class="block h-full w-full border-0 grayscale"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Localisation du studio Bis Repetita à Genève"
            ></iframe>
        </div>
        <div class="md:self-end">
            <dl class="border-t border-line text-[15px]">
                <div class="flex justify-between gap-6 border-b border-line py-4">
                    <dt class="text-gray-2">Adresse</dt>
                    <dd class="text-right">{address}</dd>
                </div>
                <div class="flex justify-between gap-6 border-b border-line py-4">
                    <dt class="text-gray-2">Téléphone</dt>
                    <dd class="text-right"><a href={`tel:${phone.replace(/\s/g, "")}`} class="hover:text-gray-1">{phone}</a></dd>
                </div>
                <div class="flex justify-between gap-6 border-b border-line py-4">
                    <dt class="text-gray-2">E-mail</dt>
                    <dd class="min-w-0 break-all text-right"><a href={`mailto:${email}`} class="hover:text-gray-1">{email}</a></dd>
                </div>
            </dl>
        </div>
    </div>
</WidgetWrapper>
