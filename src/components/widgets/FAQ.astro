---
import WidgetWrapper from "./WidgetWrapper.astro";
import type { FAQProps } from "../../types/types";

// Accordéon natif <details> à filets. Le widget n'émet aucun JSON-LD : le FAQPage vient des pages (<Schema>).
// tagline et isDark sont ignorés.
const { items = [], title, subtitle, id, classes = {}, bg } = Astro.props as FAQProps;
---

<WidgetWrapper id={id} bg={bg} classes={classes}>
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-[clamp(40px,8vw,160px)]">
        {(title || subtitle) && (
            <div class="md:sticky md:top-[calc(var(--nav-h)+32px)] md:self-start">
                {title && <h2 class="t-title" data-split set:html={title} />}
                {subtitle && <p class="mt-5 max-w-[38ch] text-[17px] text-gray-1" set:html={subtitle} />}
            </div>
        )}
        <div class:list={["faq border-t border-line", !(title || subtitle) && "md:col-start-2"]}>
            {items.map((item) => (
                <details class="border-b border-line">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-[17px] font-medium leading-snug tracking-[-0.015em] md:text-[19px]">
                        <span>{item.question}</span>
                        <span class="faq-sign" aria-hidden="true"></span>
                    </summary>
                    <div class="faq-answer max-w-[62ch] pb-7 text-[16px] leading-relaxed text-gray-1">
                        <Fragment set:html={item.answer} />
                    </div>
                </details>
            ))}
        </div>
    </div>
</WidgetWrapper>

<style>
    .faq { interpolate-size: allow-keywords; }
    summary::-webkit-details-marker { display: none; }
    summary:hover { color: var(--gray-1); }

    /* Signe + / − en deux traits fins */
    .faq-sign { position: relative; flex: none; width: 14px; height: 14px; margin-top: 0.4em; }
    .faq-sign::before,
    .faq-sign::after {
        content: "";
        position: absolute;
        inset: 50% 0 auto 0;
        height: 1px;
        background: currentColor;
        transition: transform 0.45s var(--ease-out-expo);
    }
    .faq-sign::after { transform: rotate(90deg); }
    details[open] .faq-sign::after { transform: rotate(0deg); }

    .faq-answer :global(a) { color: var(--ink); text-decoration: underline; }

    /* Hauteur animée là où ::details-content existe ; ailleurs, ouverture instantanée. */
    details::details-content {
        block-size: 0;
        overflow: hidden;
        transition: block-size 0.45s var(--ease-out-expo), content-visibility 0.45s allow-discrete;
    }
    details[open]::details-content { block-size: auto; }
</style>
