---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Bande claire (titre + pilule), ou bande photo N&B plein cadre si `image` est fourni.
// subtitle servait de surtitre : ignoré. variant est accepté pour compatibilité.
interface Props {
    title: string;
    subtitle?: string;
    description?: string;
    cta: {
        text: string;
        href: string;
    };
    image?: ImageMetadata;
    imageAlt?: string;
    id?: string;
    variant?: "default" | "brushed-full";
    classes?: Record<string, string>;
}

const { title, description, cta, image, imageAlt = "", id, classes = {} } = Astro.props;
const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
---

{image ? (
    <section {id} class:list={["cta-photo nb relative overflow-hidden bg-ink text-white", classes.container]}>
        <Image src={image} alt={imageAlt} widths={[1024, 1600, 2400]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
        <div class="wrap relative z-[1] flex min-h-[min(80vh,56vw)] flex-col justify-end gap-6 pb-[clamp(24px,4vw,56px)] pt-40 md:flex-row md:items-end md:justify-between">
            <div class="max-w-[22ch]">
                <h2 class="t-title" data-split set:html={title} />
                {description && <p class="mt-4 max-w-[44ch] text-[17px] text-white/85">{description}</p>}
            </div>
            <a href={cta.href} class="btn btn-light">{cta.text} <Fragment set:html={arrow} /></a>
        </div>
    </section>
) : (
    <section {id} class:list={["wrap scroll-mt-[72px] py-[var(--section)]", classes.container]}>
        <div class="grid gap-8 border-t border-line pt-[clamp(40px,5vw,72px)] md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:items-end md:gap-[clamp(40px,6vw,120px)]">
            <h2 class="t-title max-w-[18ch]" data-split set:html={title} />
            <div class="grid justify-items-start gap-6">
                {description && <p class="max-w-[42ch] text-[17px] text-gray-1">{description}</p>}
                <a href={cta.href} class="btn btn-solid">{cta.text} <Fragment set:html={arrow} /></a>
            </div>
        </div>
    </section>
)}

<style>
    /* Lisibilité du texte blanc : voile en bas de photo, comme la bande studio de l'accueil. */
    .cta-photo::after {
        content: "";
        position: absolute;
        inset: 40% 0 0 0;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    }
</style>
