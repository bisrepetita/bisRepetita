---
import WidgetWrapper from "./WidgetWrapper.astro";
import Headline from "../ui/Headline.astro";

interface Props {
    id?: string;
    title?: string;
    subtitle?: string;
    tagline?: string;
    isDark?: boolean;
}

const {
    id = "reservation",
    title = "Réservez votre créneau",
    subtitle = "Consultez les disponibilités et réservez directement votre séance.",
    tagline = "Réservation",
    isDark = false,
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark}>
    <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        titleAs="h2"
        classes={{
            container: "mb-12 text-center",
            title: "text-4xl md:text-5xl font-medium tracking-tight font-display",
            subtitle: "text-lg text-muted-foreground max-w-2xl mx-auto",
        }}
    />
    <div class="zenamu-calendar-wrapper">
        <iframe
            id="br-planning-iframe"
            src="https://app.bisrepetita.ch/embed/planning"
            style="width:100%; border:none; min-height:400px; display:block;"
            scrolling="no"
        ></iframe>
    </div>
</WidgetWrapper>

<script>
    window.addEventListener("message", (event) => {
        if (event.origin !== "https://app.bisrepetita.ch") return;
        const data = event.data;
        if (data && data.type === "br-embed-resize" && typeof data.height === "number") {
            const iframe = document.getElementById("br-planning-iframe");
            if (iframe instanceof HTMLIFrameElement) {
                iframe.style.height = `${data.height}px`;
            }
        }
    });
</script>
