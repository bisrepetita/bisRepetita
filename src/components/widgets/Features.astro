---
import WidgetWrapper from "./WidgetWrapper.astro";
import type { FeaturesProps } from "../../types/types";

// Titre à gauche, items en lignes à filet à droite. icon, iconClass, tagline, columns,
// headlineAlign, isDark et bento sont acceptés pour compatibilité mais ignorés.
interface Props extends FeaturesProps {
    bento?: "2-3";
}

const {
    features = [],
    title,
    subtitle,
    id,
    classes = {},
    bg = await Astro.slots.render("bg"),
} = Astro.props as Props;

const { container: containerClassProp = "" } = classes;
---

<WidgetWrapper id={id} containerClass={containerClassProp} bg={bg}>
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-[clamp(40px,8vw,160px)]">
        {(title || subtitle) && (
            <div class="md:sticky md:top-[calc(var(--nav-h)+32px)] md:self-start">
                {title && <h2 class="t-title" data-split set:html={title} />}
                {subtitle && <p class="mt-5 max-w-[42ch] text-[17px] text-gray-1" set:html={subtitle} />}
            </div>
        )}
        <div class:list={[!(title || subtitle) && "md:col-start-2"]}>
            <ul class="border-t border-line">
                {features.map((f) => (
                    <li class="grid gap-x-8 gap-y-2 border-b border-line py-6 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
                        <h3 class="text-[19px] font-medium leading-snug tracking-[-0.02em]">{f.title}</h3>
                        <p class="text-[15px] text-gray-1" set:html={f.description} />
                    </li>
                ))}
            </ul>
            <slot />
        </div>
    </div>
</WidgetWrapper>
