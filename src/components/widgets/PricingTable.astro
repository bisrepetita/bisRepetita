---
import WidgetWrapper from "./WidgetWrapper.astro";
import type { PricingTableProps } from "../../types/types";

// Carte de prix : une ligne par formule, séparée par un filet.
// tagline, highlighted, popularLabel et columns sont acceptés mais ignorés (pas de carte mise en avant).
const { tiers, title, subtitle, id, classes = {}, bg } = Astro.props as PricingTableProps;
---

<WidgetWrapper id={id} bg={bg} classes={classes}>
    <div class="pt-grid">
        {(title || subtitle) && (
            <div class="pt-head">
                {title && <h2 class="t-title" data-split set:html={title} />}
                {subtitle && <p class="pt-sub" set:html={subtitle} />}
            </div>
        )}
        <ul class="pt-list">
            {tiers.map((tier) => (
                <li class="pt-row">
                    <div class="pt-name">
                        <h3 class="t-subtitle">{tier.name}</h3>
                        {tier.description && <p class="pt-desc">{tier.description}</p>}
                    </div>
                    <p class="pt-price">
                        <span class="pt-amount">{tier.price}</span>
                        {tier.priceNote && <span class="pt-note">{tier.priceNote}</span>}
                    </p>
                    {tier.features.length > 0 && <p class="pt-features">{tier.features.join(" · ")}</p>}
                    {tier.cta && <a href={tier.cta.href} class="link-line pt-cta">{tier.cta.text}</a>}
                </li>
            ))}
        </ul>
    </div>
</WidgetWrapper>

<style>
    .pt-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 40px clamp(40px, 7vw, 140px); align-items: start; }
    .pt-head { display: grid; gap: 18px; max-width: 32rem; }
    .pt-sub { color: var(--gray-1); font-size: 17px; }
    .pt-list { border-top: 1px solid var(--ink); }
    .pt-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px 24px;
        padding: 24px 0;
        border-bottom: 1px solid var(--line);
    }
    .pt-desc { margin-top: 6px; color: var(--gray-1); font-size: 15px; }
    .pt-price { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .pt-amount { display: block; font-size: clamp(1.375rem, 2vw, 1.75rem); font-weight: 500; letter-spacing: -0.025em; }
    .pt-note { display: block; font-size: 13px; color: var(--gray-2); }
    .pt-features { grid-column: 1 / -1; font-size: 14px; color: var(--gray-2); max-width: 60ch; }
    .pt-cta { grid-column: 1 / -1; justify-self: start; font-size: 14px; }

    @media (max-width: 860px) {
        .pt-grid { grid-template-columns: 1fr; }
    }
</style>
