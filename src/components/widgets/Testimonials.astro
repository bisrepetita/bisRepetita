---
import WidgetWrapper from "./WidgetWrapper.astro";
import type { TestimonialsProps } from "../../types/types";

// Citations en grand, nom en méta, séparées par des filets. N'affiche que ce que la page fournit.
// `rating` n'est pas affiché : note et nombre d'avis non vérifiés (règles de contenu) ; tagline et isDark ignorés.
const { testimonials = [], title, subtitle, id, classes = {}, bg } = Astro.props as TestimonialsProps;
---

{testimonials.length > 0 && (
    <WidgetWrapper id={id} bg={bg} classes={classes}>
        {(title || subtitle) && (
            <div class="mb-[clamp(32px,4vw,56px)]">
                {title && <h2 class="t-title max-w-[20ch]" data-split set:html={title} />}
                {subtitle && <p class="mt-5 max-w-[46ch] text-[17px] text-gray-1" set:html={subtitle} />}
            </div>
        )}
        <ul class="border-t border-line">
            {testimonials.map((t) => (
                <li class="grid gap-6 border-b border-line py-[clamp(32px,4vw,56px)] md:grid-cols-[minmax(0,1fr)_minmax(0,2.4fr)] md:gap-[clamp(40px,6vw,120px)]">
                    <blockquote class="t-lead max-w-[32ch] md:order-2">«&nbsp;{t.quote}&nbsp;»</blockquote>
                    <p class="t-meta md:order-1 md:pt-2">
                        <span class="text-ink">{t.name}</span>
                        {t.role && <><br />{t.role}</>}
                    </p>
                </li>
            ))}
        </ul>
    </WidgetWrapper>
)}
