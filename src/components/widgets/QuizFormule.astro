---
import WidgetWrapper from "./WidgetWrapper.astro";

const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
const q1 = [
  { value: "solo", label: "Un programme sur mesure, rien que pour moi" },
  { value: "duo-trio", label: "M'entraîner avec quelqu'un" },
  { value: "small-group", label: "L'énergie d'un petit groupe, avec des corrections" },
  { value: "boxe-groupe", label: "Me défouler sur les sacs" },
  { value: "corporate", label: "La cohésion de mon équipe" },
];
---

<WidgetWrapper id="quiz">
  <div class="quiz-grid">
    <div class="quiz-head">
      <h2 class="t-title" data-split>Quel programme est fait pour vous ?</h2>
      <p>Deux questions pour trouver la formule qui vous correspond.</p>
    </div>

    <div id="quiz-container" class="quiz-body" aria-live="polite">
      <div id="quiz-step-1" class="quiz-step">
        <p class="quiz-q" tabindex="-1"><span class="t-meta">1 / 2</span> Quelle est votre priorité ?</p>
        <div class="quiz-options">
          {q1.map((o) => (
            <button class="quiz-option" data-value={o.value} type="button">{o.label}</button>
          ))}
        </div>
      </div>

      <div id="quiz-step-2" class="quiz-step" hidden>
        <p class="quiz-q" tabindex="-1"><span class="t-meta">2 / 2</span> Combien de personnes participent ?</p>
        <div class="quiz-options" id="quiz-step-2-options"></div>
        <button id="quiz-back" type="button" class="quiz-text-btn link-line">Retour</button>
      </div>

      <div id="quiz-result" class="quiz-step" hidden>
        <p class="t-meta">Votre formule</p>
        <h3 id="quiz-result-title" class="t-subtitle quiz-result-title" tabindex="-1"></h3>
        <p id="quiz-result-tagline" class="quiz-result-tagline"></p>
        <ul id="quiz-result-highlights" class="quiz-highlights"></ul>
        <div class="quiz-actions">
          <a id="quiz-result-cta" href="#" class="btn btn-solid">Voir les tarifs <Fragment set:html={arrow} /></a>
          <button id="quiz-restart" type="button" class="quiz-text-btn link-line">Recommencer</button>
        </div>
      </div>
    </div>
  </div>
</WidgetWrapper>

<script>
  function initQuiz() {
    const container = document.getElementById("quiz-container");
    if (!container || container.hasAttribute("data-quiz-init")) return;
    container.setAttribute("data-quiz-init", "true");

    const step1 = document.getElementById("quiz-step-1")!;
    const step2 = document.getElementById("quiz-step-2")!;
    const step2Options = document.getElementById("quiz-step-2-options")!;
    const result = document.getElementById("quiz-result")!;
    const resultTitle = document.getElementById("quiz-result-title")!;
    const resultTagline = document.getElementById("quiz-result-tagline")!;
    const resultHighlights = document.getElementById("quiz-result-highlights")!;
    const resultCta = document.getElementById("quiz-result-cta") as HTMLAnchorElement;
    const backBtn = document.getElementById("quiz-back")!;
    const restartBtn = document.getElementById("quiz-restart")!;

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    type ProfileKey = "solo" | "duo-trio" | "small-group" | "boxe-groupe" | "corporate";

    const profiles: Record<ProfileKey, { title: string; tagline: string; highlights: string[]; anchorId: string }> = {
      solo: {
        title: "Coaching solo",
        tagline: "Nicolas vous accompagne en tête-à-tête, avec un programme adapté à vos objectifs, à votre niveau et à votre rythme.",
        highlights: [
          "Programme sur mesure, ajusté à chaque séance",
          "L'attention du coach pendant 60 minutes",
          "Une progression suivie d'une séance à l'autre",
        ],
        anchorId: "solo",
      },
      "duo-trio": {
        title: "Duo & Trio",
        tagline: "La qualité d'un coaching privé, l'effort partagé. Avec un ami, une collègue ou en couple.",
        highlights: [
          "Le même suivi qu'en solo, à prix partagé",
          "Programme adapté au duo ou au trio",
          "Une motivation entre partenaires",
        ],
        anchorId: "duo-trio",
      },
      "small-group": {
        title: "Small Group",
        tagline: "De 4 à 8 personnes, pour que Nicolas puisse corriger chaque mouvement. L'énergie du groupe, l'attention du privé.",
        highlights: [
          "4 à 8 participants",
          "Tarif avantageux par rapport au coaching individuel",
          "Programme structuré, progression régulière",
        ],
        anchorId: "small-group",
      },
      "boxe-groupe": {
        title: "Round by Round",
        tagline: "Le cours collectif, structuré en rounds. Un coach, 50 minutes, 8 personnes au plus. Ouvert à tous les niveaux, sans combat.",
        highlights: [
          "Aucune expérience requise, pas de contact",
          "Cardio, technique et renforcement dans la même séance",
          "CHF 40 la séance",
        ],
        anchorId: "boxe-groupe",
      },
      corporate: {
        title: "Corporate",
        tagline: "Un programme construit pour vos collaborateurs : team building, bien-être et cohésion d'équipe.",
        highlights: [
          "Au studio ou dans vos locaux à Genève",
          "Ponctuel ou récurrent",
          "Matériel fourni, devis sur mesure",
        ],
        anchorId: "corporate",
      },
    };

    const q2Map: Record<string, { label: string; result: ProfileKey }[]> = {
      solo: [
        { label: "Juste moi", result: "solo" },
        { label: "À deux ou trois", result: "duo-trio" },
      ],
      "duo-trio": [
        { label: "2 personnes", result: "duo-trio" },
        { label: "3 personnes", result: "duo-trio" },
        { label: "4 à 8 personnes", result: "small-group" },
      ],
      "small-group": [
        { label: "2 ou 3 personnes", result: "duo-trio" },
        { label: "4 à 8 personnes", result: "small-group" },
        { label: "Plus de 8", result: "boxe-groupe" },
      ],
      "boxe-groupe": [
        { label: "Seul ou entre amis", result: "boxe-groupe" },
        { label: "Mon équipe (entreprise)", result: "corporate" },
      ],
      corporate: [
        { label: "5 à 15 collaborateurs", result: "corporate" },
        { label: "Plus de 15 collaborateurs", result: "corporate" },
      ],
    };

    function showStep(show: HTMLElement) {
      [step1, step2, result].forEach((el) => (el.hidden = el !== show));
      if (!prefersReduced) show.animate([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 300, easing: "ease-out" });
      show.querySelector<HTMLElement>("[tabindex='-1']")?.focus({ preventScroll: true });
    }

    function showResult(key: ProfileKey) {
      const profile = profiles[key];
      resultTitle.textContent = profile.title;
      resultTagline.textContent = profile.tagline;
      resultHighlights.replaceChildren(
        ...profile.highlights.map((h) => {
          const li = document.createElement("li");
          li.textContent = h;
          return li;
        })
      );
      resultCta.href = `#${profile.anchorId}`;
      resultCta.onclick = (e) => {
        e.preventDefault();
        document.getElementById(profile.anchorId)?.scrollIntoView({ behavior: prefersReduced ? "auto" : "smooth", block: "start" });
      };
      showStep(result);
    }

    step1.querySelectorAll<HTMLButtonElement>(".quiz-option").forEach((btn) => {
      btn.addEventListener("click", () => {
        const options = q2Map[btn.dataset.value as string];
        if (!options) return;
        step2Options.replaceChildren(
          ...options.map((opt) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "quiz-option";
            b.textContent = opt.label;
            b.addEventListener("click", () => showResult(opt.result));
            return b;
          })
        );
        showStep(step2);
      });
    });

    backBtn.addEventListener("click", () => showStep(step1));
    restartBtn.addEventListener("click", () => showStep(step1));
  }

  initQuiz();
  document.addEventListener("astro:page-load", initQuiz);
</script>

<style>
  .quiz-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 40px clamp(40px, 7vw, 140px); align-items: start; }
  .quiz-head { display: grid; gap: 18px; max-width: 30rem; }
  .quiz-head p { color: var(--gray-1); font-size: 17px; }
  .quiz-body { border-top: 1px solid var(--ink); padding-top: 28px; min-height: 280px; }
  .quiz-q { display: flex; align-items: baseline; gap: 16px; font-size: clamp(1.25rem, 1.8vw, 1.5rem); font-weight: 500; letter-spacing: -0.02em; outline: none; }
  .quiz-options { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .quiz-step :global(.quiz-option) {
    min-height: 46px;
    padding: 10px 20px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: 15px;
    text-align: left;
    line-height: 1.3;
    transition: background-color 0.35s var(--ease-out-expo), color 0.35s var(--ease-out-expo);
  }
  .quiz-step :global(.quiz-option:hover) { background: var(--ink); color: var(--bg); }
  .quiz-text-btn { margin-top: 20px; font-size: 14px; color: var(--gray-1); }
  .quiz-result-title { margin-top: 10px; outline: none; }
  .quiz-result-tagline { margin-top: 12px; color: var(--gray-1); max-width: 52ch; }
  .quiz-highlights { margin-top: 24px; border-top: 1px solid var(--line); font-size: 15px; }
  .quiz-highlights :global(li) { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .quiz-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; margin-top: 28px; }
  .quiz-actions .quiz-text-btn { margin-top: 0; }

  @media (max-width: 860px) {
    .quiz-grid { grid-template-columns: 1fr; }
  }
</style>
