---
import { getCollection } from "astro:content";
import WidgetWrapper from "./WidgetWrapper.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import PostItem from "../blog/PostItem.astro";
import { isPublished } from "../../utils/blog";

interface Props {
    maxItems?: number;
    filterCategory?: string;
    excludePostId?: string;
    excludePostIds?: string[];
    id?: string;
    title?: string;
    badge?: string;
}

const {
    maxItems = 3,
    filterCategory,
    excludePostId,
    excludePostIds = [],
    id = "articles",
    title = "Nos derniers articles",
    badge = "Blog",
} = Astro.props;

const excludedIds = new Set<string>([
    ...(excludePostId ? [excludePostId] : []),
    ...excludePostIds,
]);

const allPosts = (await getCollection("blog", isPublished))
    .filter((p) => !excludedIds.has(p.id))
    .filter((p) => !filterCategory || p.data.category === filterCategory)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, maxItems);

---

{
    allPosts.length > 0 && (
        <WidgetWrapper id={id}>
            <div class="flex items-end justify-between gap-6 mb-10 md:mb-14">
                <SectionTitle badge={badge} title={title} />
                <a href="/blog" class="link-line text-sm shrink-0">Tous les articles</a>
            </div>
            <div class="grid gap-x-[clamp(16px,2vw,32px)] gap-y-14 md:grid-cols-3 gsap-stagger-cards">
                {allPosts.map((post) => (
                    <PostItem post={post} />
                ))}
            </div>
        </WidgetWrapper>
    )
}
