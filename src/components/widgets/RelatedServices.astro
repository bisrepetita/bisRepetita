---
import { servicePages } from "../../config/site";
import WidgetWrapper from "./WidgetWrapper.astro";

// Liste en lignes, style « index » de l'accueil.
interface Props {
    currentSlug: string;
    maxItems?: number;
    id?: string;
}

const { currentSlug, maxItems = 3, id = "programmes" } = Astro.props;

const current = servicePages.find((s) => s.slug === currentSlug);
const others = servicePages.filter((s) => s.slug !== currentSlug);
// Même catégorie d'abord, puis les autres.
const related = [
    ...others.filter((s) => s.category === current?.category),
    ...others.filter((s) => s.category !== current?.category),
].slice(0, maxItems);
const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
---

<WidgetWrapper id={id}>
    <div class="mb-[clamp(32px,4vw,56px)] flex items-end justify-between gap-6">
        <h2 class="t-title" data-split>Découvrez nos autres programmes</h2>
        <a href="/services" class="link-line shrink-0 text-[14px]">Tous les cours</a>
    </div>
    <ul class="rs-list border-t border-ink">
        {related.map((s) => (
            <li>
                <a href={s.href} class="rs-row">
                    <span class="rs-t">{s.title}</span>
                    <span class="rs-d">{s.shortDescription}</span>
                    <span class="rs-a" set:html={arrow} />
                </a>
            </li>
        ))}
    </ul>
</WidgetWrapper>

<style>
    .rs-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) 20px;
        gap: 24px;
        align-items: baseline;
        padding: 22px 0;
        border-bottom: 1px solid var(--line);
        transition: padding 0.6s var(--ease-out-expo), color 0.4s;
    }
    .rs-t { font-size: clamp(1.375rem, 2.2vw, 2rem); font-weight: 500; letter-spacing: var(--track-title); line-height: 1.1; }
    .rs-d { color: var(--gray-1); font-size: 15px; }
    .rs-a { justify-self: end; opacity: 0; transform: translateX(-6px); transition: opacity 0.4s, transform 0.5s var(--ease-out-expo); }
    .rs-row:hover, .rs-row:focus-visible { padding-left: 14px; }
    .rs-row:hover .rs-a, .rs-row:focus-visible .rs-a { opacity: 1; transform: none; }
    .rs-list:has(.rs-row:hover) .rs-row:not(:hover),
    .rs-list:has(.rs-row:hover) .rs-row:not(:hover) .rs-d { color: var(--gray-3); }

    @media (max-width: 860px) {
        .rs-row { grid-template-columns: minmax(0, 1fr); gap: 6px; }
        .rs-a { display: none; }
    }
</style>
