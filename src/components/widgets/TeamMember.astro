---
import { Image } from "astro:assets";
import WidgetWrapper from "./WidgetWrapper.astro";
import type { TeamMemberProps } from "../../types/types";

// Portrait N&B, nom, rôle en méta, bio, qualifications en lignes à filet. isDark ignoré.
const { member, id, classes = {}, bg } = Astro.props as TeamMemberProps;
const img = member.image;
---

<WidgetWrapper id={id} bg={bg} classes={classes}>
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] md:gap-[clamp(40px,7vw,128px)]">
        {img && (
            <div class="nb aspect-[3/4] overflow-hidden bg-surface" data-photo-reveal>
                {typeof img === "string" ? (
                    <img src={img} alt={member.name} class="h-full w-full object-cover" loading="lazy" />
                ) : (
                    <Image src={img} alt={member.name} widths={[600, 900, 1200]} sizes="(max-width: 768px) 100vw, 42vw" class="h-full w-full object-cover" loading="lazy" />
                )}
            </div>
        )}
        <div class:list={[!img && "md:col-start-2"]}>
            <h2 class="t-title" data-split>{member.name}</h2>
            <p class="t-meta mt-3">{member.role}</p>
            <div class="mt-8 grid gap-4 text-[17px] text-gray-1">
                {member.bio.map((p) => <p set:html={p} />)}
            </div>
            {member.credentials && member.credentials.length > 0 && (
                <ul class="mt-10 border-t border-line text-[15px]">
                    {member.credentials.map((c) => <li class="border-b border-line py-3.5">{c}</li>)}
                </ul>
            )}
        </div>
    </div>
</WidgetWrapper>
