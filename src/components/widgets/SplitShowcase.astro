---
import ContentShowcase from "./ContentShowcase.astro";
import type { ImageMetadata } from "astro";

// Même composition que ContentShowcase avec image : grande photo N&B + lignes à filet. tagline ignoré.
interface Props {
    tagline?: string;
    title?: string;
    image: ImageMetadata;
    imageAlt?: string;
    items?: Array<{ title: string; description: string }>;
    isReversed?: boolean;
    id?: string;
}

const { title, image, imageAlt = "", items = [], isReversed = false, id } = Astro.props;
---

<ContentShowcase {id} {title} {image} {imageAlt} {items} {isReversed} />
