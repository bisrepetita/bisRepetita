---
import type { Widget } from "../../types/types";

// isDark est ignoré : le site est clair ; le noir est réservé à la photo.
const { id, containerClass = "", bg = "", classes = {}, fullBleed = false } = Astro.props as Widget;
const container = (classes as Record<string, string>).container ?? containerClass;
---

<section id={id} class:list={["relative not-prose scroll-mt-[72px]", bg]}>
    <div class:list={[fullBleed ? "" : "wrap", "section", container]}>
        <slot />
    </div>
</section>
