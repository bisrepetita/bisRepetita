---
import type { HeroProps } from "../../types/types";
import { Image } from "astro:assets";

// Héros des pages intérieures : titre H1 à gauche, texte et actions à droite,
// puis une bande photo N&B bord à bord. tagline / socialProof / ctaStyle sont ignorés.
const {
    title = await Astro.slots.render("title"),
    description = await Astro.slots.render("description"),
    actions = [],
    id,
    image,
    imageAlt = "",
    locationBadge,
    videoSrc,
} = Astro.props as HeroProps;

const list = Array.isArray(actions) ? actions.filter(Boolean) : [];
const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
---

<section id={id} class="hero">
    <div class="wrap hero-grid">
        <h1 class="t-display hero-title" data-split set:html={title} />
        <div class="hero-side">
            {locationBadge && <p class="t-meta">{locationBadge.text}</p>}
            {description && <p class="hero-desc" set:html={description} />}
            {list.length > 0 && (
                <div class="hero-actions">
                    {list.map((a, i) => (
                        <a
                            href={a.href}
                            class={i === 0 ? "btn btn-solid" : "btn btn-line"}
                            aria-label={a.ariaLabel}
                            target={a.target}
                        >
                            {a.text}
                            {i === 0 && <Fragment set:html={arrow} />}
                        </a>
                    ))}
                </div>
            )}
        </div>
    </div>

    {(videoSrc || image) && (
        <div class="hero-media nb" data-photo-reveal>
            {videoSrc ? (
                <video autoplay muted loop playsinline preload="metadata" src={videoSrc} />
            ) : typeof image === "string" ? (
                <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" />
            ) : (
                <Image src={image!} alt={imageAlt} widths={[800, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
            )}
        </div>
    )}
</section>

<style>
    .hero { padding-top: clamp(48px, 7vw, 112px); }
    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        gap: 32px clamp(32px, 6vw, 120px);
        align-items: end;
        padding-bottom: clamp(48px, 6vw, 96px);
    }
    .hero-title { max-width: 14ch; }
    .hero-side { display: flex; flex-direction: column; gap: 20px; max-width: 440px; }
    .hero-desc { font-size: 17px; line-height: 1.5; color: var(--gray-1); }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
    .hero-media { aspect-ratio: 16 / 7; overflow: hidden; background: var(--surface); }
    .hero-media :global(img), .hero-media video { width: 100%; height: 100%; object-fit: cover; display: block; }

    @media (max-width: 860px) {
        .hero-grid { grid-template-columns: 1fr; align-items: start; }
        .hero-media { aspect-ratio: 4 / 5; }
    }
</style>
