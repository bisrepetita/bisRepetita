---
import type { PricingNavProps } from "../../types/types";

const { items } = Astro.props as PricingNavProps;
---

<nav id="pricing-nav" class="pnav" aria-label="Navigation tarifs">
  <ul class="wrap pnav-list scrollbar-hide">
    {items.map((item) => (
      <li>
        <a href={`#${item.anchorId}`} class="pnav-link" data-target={item.anchorId}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  function initPricingNav() {
    const nav = document.getElementById("pricing-nav");
    if (!nav || nav.dataset.ready) return;
    nav.dataset.ready = "1";

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".pnav-link"));
    const list = nav.querySelector("ul")!;
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        const target = document.getElementById(link.dataset.target!);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: prefersReduced ? "auto" : "smooth", block: "start" });
        history.replaceState(null, "", `#${target.id}`);
      });
    });

    function setActive(id: string) {
      links.forEach((link) => {
        const isActive = link.dataset.target === id;
        if (isActive) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
        // Ne pas utiliser scrollIntoView ici : il ferait défiler la page (nav sticky).
        if (isActive) {
          list.scrollTo({ left: link.offsetLeft - list.offsetWidth / 2 + link.offsetWidth / 2, behavior: "smooth" });
        }
      });
    }

    const observer = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting && setActive(entry.target.id)),
      { rootMargin: "-140px 0px -55% 0px", threshold: 0 }
    );
    links
      .map((l) => document.getElementById(l.dataset.target!))
      .forEach((section) => section && observer.observe(section));
  }

  initPricingNav();
  document.addEventListener("astro:page-load", initPricingNav);
</script>

<style>
  .pnav {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: var(--bg);
    border-block: 1px solid var(--line);
    transition: top 0.6s var(--ease-out-expo);
  }
  /* La barre principale se masque au défilement vers le bas : la sous-nav prend sa place. */
  :global(body:has(#site-nav[data-hidden="true"])) .pnav { top: 0; }
  .pnav-list { display: flex; gap: clamp(20px, 3vw, 40px); overflow-x: auto; }
  .pnav-link {
    display: block;
    padding: 14px 0 13px;
    font-size: 14px;
    color: var(--gray-2);
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    transition: color 0.3s, border-color 0.3s;
  }
  .pnav-link:hover { color: var(--ink); }
  .pnav-link[aria-current="true"] { color: var(--ink); border-bottom-color: var(--ink); }
</style>
