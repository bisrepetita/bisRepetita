---
import type { StatsProps } from "../../types/types";

// Rendu en lignes à filet « valeur — libellé — description ». variant et cta sont ignorés.
interface Props extends StatsProps {
    variant?: "default" | "wide";
    cta?: { text: string; href: string };
}

const { stats = [], id, badge, badgeHref, intro } = Astro.props as Props;

// Claims non vérifiables retirés du site (règles de contenu) : jamais affichés, même si une page les passe.
const BANNED = /^(100\s*\+|9[89]\s*%|10\s*K\s*\+)$/i;
const rows = stats.filter((s) => !BANNED.test(s.value.trim()));
---

<section id={id} class="section wrap scroll-mt-[72px]">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-[clamp(40px,8vw,160px)]">
        <div>
            {intro && <p class="t-subtitle max-w-[24ch]">{intro}</p>}
            {badge && badgeHref && (
                <a href={badgeHref} class="link-line mt-6 inline-block text-[15px]">{badge}</a>
            )}
        </div>
        <ul class="border-t border-line">
            {rows.map((s) => (
                <li class="grid grid-cols-[minmax(0,5.5rem)_minmax(0,1fr)] gap-x-6 gap-y-1 border-b border-line py-5 sm:grid-cols-[minmax(0,7rem)_minmax(0,0.8fr)_minmax(0,1.2fr)]">
                    <span class="text-[clamp(1.375rem,2vw,1.75rem)] font-medium leading-tight tracking-[-0.025em] tabular-nums">{s.value}</span>
                    <span class="pt-1.5 text-[15px] font-medium">{s.label}</span>
                    {s.description && <p class="col-start-2 pt-1.5 text-[15px] text-gray-1 sm:col-start-3">{s.description}</p>}
                </li>
            ))}
        </ul>
    </div>
</section>
