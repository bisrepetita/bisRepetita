---
import { Image } from "astro:assets";
import type { ServiceCardData } from "../../types/types";

// Grande photo N&B 4:5, titre et texte dessous. index et linkText acceptés pour compatibilité, non affichés.
interface Props {
    service: ServiceCardData;
    index?: number;
    linkText?: string;
}

const { service } = Astro.props;
const img = service.image;
const arrowUp = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
---

<a href={service.href} class="sc group block">
    {img && (
        <div class="nb aspect-[4/5] overflow-hidden bg-surface">
            {typeof img === "string" ? (
                <img src={img} alt="" class="h-full w-full object-cover" loading="lazy" />
            ) : (
                <Image src={img} alt="" widths={[400, 700, 1000]} sizes="(max-width: 768px) 100vw, 33vw" class="h-full w-full object-cover" loading="lazy" />
            )}
        </div>
    )}
    <div class="mt-5 flex items-center justify-between gap-4">
        <h3 class="t-subtitle">{service.title}</h3>
        <span class="sc-arrow" set:html={arrowUp} />
    </div>
    <p class="mt-2 max-w-[46ch] text-[15px] text-gray-1">{service.description}</p>
</a>

<style>
    .sc :global(img) { transition: transform 1.4s var(--ease-out-expo); }
    .sc:hover :global(img) { transform: scale(1.035); }
    .sc-arrow { transition: transform 0.5s var(--ease-out-expo); }
    .sc:hover .sc-arrow { transform: translate(3px, -3px); }
</style>
