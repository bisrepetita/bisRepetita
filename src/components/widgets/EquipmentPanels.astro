---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Grandes photos N&B côte à côte, texte dessous. tagline ignoré.
interface Panel {
    title: string;
    description: string;
    image: ImageMetadata;
    alt: string;
    ctaText?: string;
    ctaHref?: string;
}

interface Props {
    tagline?: string;
    title?: string;
    subtitle?: string;
    panels: Panel[];
    id?: string;
}

const { title, subtitle, panels = [], id } = Astro.props;
const cols = panels.length >= 4 ? "lg:grid-cols-4" : panels.length === 3 ? "lg:grid-cols-3" : "";
---

<section id={id} class="section wrap scroll-mt-[72px]">
    {(title || subtitle) && (
        <div class="mb-[clamp(32px,4vw,56px)] grid gap-5 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:items-end md:gap-[clamp(40px,6vw,120px)]">
            {title && <h2 class="t-title" data-split set:html={title} />}
            {subtitle && <p class="max-w-[42ch] text-[17px] text-gray-1" set:html={subtitle} />}
        </div>
    )}
    <ul class:list={["grid gap-x-[clamp(16px,2vw,32px)] gap-y-12 sm:grid-cols-2", cols]}>
        {panels.map((p) => (
            <li>
                <div class="nb aspect-[4/5] overflow-hidden bg-surface" data-photo-reveal>
                    <Image src={p.image} alt={p.alt} widths={[400, 700, 1000]} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw" class="h-full w-full object-cover" loading="lazy" />
                </div>
                <h3 class="mt-5 text-[19px] font-medium leading-snug tracking-[-0.02em]">{p.title}</h3>
                <p class="mt-2 max-w-[42ch] text-[15px] text-gray-1">{p.description}</p>
                {p.ctaHref && p.ctaText && (
                    <a href={p.ctaHref} class="link-line mt-4 inline-block text-[15px]">{p.ctaText}</a>
                )}
            </li>
        ))}
    </ul>
</section>
