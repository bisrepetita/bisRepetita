---
import { Image } from "astro:assets";
import { getAuthor } from "../../config/authors";

interface Props {
  authorName: string;
}

const { authorName } = Astro.props;
const author = getAuthor(authorName);
---

{
  author && (
    <aside class="not-prose author" aria-label="À propos de l'auteur">
      <div class="author-photo nb">
        <Image src={author.image} alt={author.imageAlt} widths={[96, 192]} sizes="96px" />
      </div>
      <div>
        <p class="author-name">{author.name}</p>
        <p class="author-job">{author.jobTitle} · Bis Repetita, Genève</p>
        <p class="author-bio">{author.shortBio}</p>
        <p class="author-links">
          <a href={author.pageUrl} class="link-line">Voir le profil</a>
          {author.socialLinks.linkedin && (
            <a href={author.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="link-line" aria-label={`LinkedIn de ${author.name}`}>LinkedIn</a>
          )}
          {author.socialLinks.instagram && (
            <a href={author.socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="link-line" aria-label="Instagram du studio Bis Repetita">Instagram</a>
          )}
        </p>
      </div>
    </aside>
  )
}

<style>
  .author {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .author-photo { width: 96px; aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); }
  .author-photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .author-name { font-size: 19px; font-weight: 500; letter-spacing: -0.02em; }
  .author-job { margin-top: 2px; font-size: 13px; color: var(--gray-2); }
  .author-bio { margin-top: 12px; font-size: 15px; line-height: 1.55; color: var(--gray-1); }
  .author-links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 16px; font-size: 14px; }
</style>
