---
interface Props {
  title?: string;
}

const { title = "L'essentiel en bref" } = Astro.props;
---

<aside class="not-prose tldr" aria-label={title}>
  <p class="tldr-label">{title}</p>
  <div class="tldr-body"><slot /></div>
</aside>

<style>
  .tldr {
    margin: 0 0 48px;
    padding: 20px 0 24px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .tldr-label { font-size: 13px; color: var(--gray-2); margin-bottom: 12px; }
  .tldr-body { font-size: 17px; line-height: 1.55; color: var(--ink); }
  .tldr-body :global(ul) { list-style: none; padding: 0; margin: 0; }
  .tldr-body :global(li) { padding: 10px 0; border-top: 1px solid var(--line); }
  .tldr-body :global(li:first-child) { border-top: 0; padding-top: 0; }
  .tldr-body :global(p + p) { margin-top: 12px; }
</style>
