---
import { slugify } from "../../utils/slugify";

export interface Props {
  title?: string;
  subtitle?: string;
  categories?: string[];
  activeCategory?: string;
}

const {
  title = "Nos Publications",
  subtitle = "Actualités, conseils et articles sur la boxe, le bien-être et la performance.",
  categories = [],
  activeCategory,
} = Astro.props;

const uniqueCategories = [...new Set(categories)].sort();
const label = (c: string) => c.charAt(0).toUpperCase() + c.slice(1);
---

<section class="blog-hero">
  <div class="wrap bh-grid">
    <h1 class="t-display bh-title" data-split>{title}</h1>
    <p class="bh-sub">{subtitle}</p>
  </div>

  {
    uniqueCategories.length > 0 && (
      <nav class="wrap bh-filters" aria-label="Filtrer par catégorie">
        <a href="/blog" class="pill" aria-current={!activeCategory ? "page" : undefined}>Tous</a>
        {uniqueCategories.map((cat) => (
          <a
            href={`/blog/category/${slugify(cat)}`}
            class="pill"
            aria-current={activeCategory === cat ? "page" : undefined}
          >
            {label(cat)}
          </a>
        ))}
      </nav>
    )
  }
</section>

<style>
  .blog-hero { padding-top: clamp(48px, 7vw, 112px); padding-bottom: clamp(40px, 5vw, 72px); }
  .bh-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 24px clamp(32px, 6vw, 120px);
    align-items: end;
  }
  .bh-title { max-width: 14ch; }
  .bh-sub { font-size: 17px; line-height: 1.5; color: var(--gray-1); max-width: 440px; }
  .bh-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: clamp(32px, 4vw, 56px); }
  .pill {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    color: var(--gray-1);
    transition: border-color 0.3s, color 0.3s;
  }
  .pill:hover { border-color: var(--ink); color: var(--ink); }
  .pill[aria-current="page"] { border-color: var(--ink); color: var(--ink); }

  @media (max-width: 860px) {
    .bh-grid { grid-template-columns: 1fr; align-items: start; }
  }
</style>
