---
import { type CollectionEntry, render } from "astro:content";
import { slugify } from "../../utils/slugify";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { remarkPluginFrontmatter } = await render(post);

const readingTime = remarkPluginFrontmatter?.minutesRead
  ? `${Math.ceil(remarkPluginFrontmatter.minutesRead)} min de lecture`
  : "";

const formattedDate = post.data.pubDate.toLocaleDateString("fr-CH", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const categoryLabel = post.data.category
  ? post.data.category.charAt(0).toUpperCase() + post.data.category.slice(1)
  : "";
---

<article class="post-item group flex flex-col">
  <a href={`/blog/${post.id}`} class="block overflow-hidden bg-surface nb" tabindex="-1" aria-hidden="true">
    {
      post.data.image ? (
        <img
          src={post.data.image}
          alt=""
          loading="lazy"
          class="aspect-video w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.035]"
        />
      ) : (
        <div class="aspect-video w-full bg-surface"></div>
      )
    }
  </a>

  <div class="flex flex-1 flex-col pt-5">
    <div class="flex items-center gap-2 text-[13px] text-gray-2">
      {categoryLabel && (
        <a href={`/blog/category/${slugify(post.data.category)}`} class="hover:text-ink transition-colors">{categoryLabel}</a>
      )}
      {categoryLabel && readingTime && <span aria-hidden="true">·</span>}
      {readingTime && <span>{readingTime}</span>}
    </div>

    <a href={`/blog/${post.id}`} class="block flex-1 mt-3">
      <h3 class="t-subtitle">
        <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-700 ease-[var(--ease-out-expo)] group-hover:bg-[length:100%_1px]">{post.data.title}</span>
      </h3>
      <p class="mt-3 text-[15px] text-gray-1 line-clamp-2">{post.data.description}</p>
    </a>

    <time datetime={post.data.pubDate.toISOString()} class="mt-4 text-[13px] text-gray-2">{formattedDate}</time>
  </div>
</article>
