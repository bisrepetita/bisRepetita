---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2);
---

{filteredHeadings.length > 0 && (
  <>
    <details class="not-prose toc toc-mobile">
      <summary>
        Sommaire
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
      </summary>
      <ol>{filteredHeadings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </details>
    <nav class="not-prose toc toc-desktop" aria-label="Sommaire">
      <p class="toc-label">Sommaire</p>
      <ol>{filteredHeadings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </nav>
  </>
)}

<style>
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc li { border-top: 1px solid var(--line); }
  .toc a {
    display: block;
    padding: 10px 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--gray-1);
    transition: color 0.3s;
  }
  .toc a:hover { color: var(--ink); }
  .toc-label { font-size: 13px; color: var(--gray-2); padding-bottom: 12px; }

  .toc-desktop { display: none; }
  .toc-mobile { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: 40px; }
  .toc-mobile summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .toc-mobile summary::-webkit-details-marker { display: none; }
  .toc-mobile summary svg { transition: transform 0.3s; }
  .toc-mobile[open] summary svg { transform: rotate(180deg); }

  @media (min-width: 1024px) {
    .toc-mobile { display: none; }
    .toc-desktop { display: block; }
  }
</style>
