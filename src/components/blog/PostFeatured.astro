---
import { type CollectionEntry, render } from "astro:content";
import { slugify } from "../../utils/slugify";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { remarkPluginFrontmatter } = await render(post);

const readingTime = remarkPluginFrontmatter?.minutesRead
  ? `${Math.ceil(remarkPluginFrontmatter.minutesRead)} min de lecture`
  : "";

const formattedDate = post.data.pubDate.toLocaleDateString("fr-CH", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const categoryLabel = post.data.category
  ? post.data.category.charAt(0).toUpperCase() + post.data.category.slice(1)
  : "";
const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
---

<article class="featured group">
  <a href={`/blog/${post.id}`} class="f-media nb" tabindex="-1" aria-hidden="true" data-photo-reveal>
    {
      post.data.image ? (
        <img src={post.data.image} alt="" loading="eager" width="1376" height="768" />
      ) : (
        <div class="f-empty"></div>
      )
    }
  </a>

  <div class="f-body">
    <div class="f-meta">
      {categoryLabel && (
        <a href={`/blog/category/${slugify(post.data.category!)}`} class="hover:text-ink transition-colors">{categoryLabel}</a>
      )}
      {categoryLabel && readingTime && <span aria-hidden="true">·</span>}
      {readingTime && <span>{readingTime}</span>}
    </div>

    <h2 class="t-title f-title">
      <a href={`/blog/${post.id}`}>{post.data.title}</a>
    </h2>

    <p class="f-desc">{post.data.description}</p>

    <div class="f-foot">
      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      <a href={`/blog/${post.id}`} class="link-line f-link" aria-label={`Lire l'article : ${post.data.title}`}>
        Lire l'article <Fragment set:html={arrow} />
      </a>
    </div>
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 32px clamp(32px, 5vw, 96px);
    align-items: end;
  }
  .f-media { display: block; overflow: hidden; background: var(--surface); }
  .f-media img, .f-empty {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out-expo);
  }
  .group:hover .f-media img { transform: scale(1.025); }
  .f-meta { display: flex; gap: 8px; font-size: 13px; color: var(--gray-2); }
  .f-title { margin-top: 16px; max-width: 18ch; }
  .f-desc { margin-top: 20px; font-size: 17px; line-height: 1.5; color: var(--gray-1); max-width: 44ch; }
  .f-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--gray-2);
  }
  .f-link { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 500; color: var(--ink); }

  @media (max-width: 860px) {
    .featured { grid-template-columns: 1fr; }
  }
</style>
