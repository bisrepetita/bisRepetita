---
import { getAuthor } from "../../config/authors";

interface Props {
  authorName: string;
}

const { authorName } = Astro.props;
const author = getAuthor(authorName);
---

{
  author ? (
    <a href={author.pageUrl} class="text-ink hover:text-gray-1 transition-colors" rel="author">
      {author.name}
    </a>
  ) : (
    <span>{authorName}</span>
  )
}
