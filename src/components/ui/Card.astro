---
// Bloc plat à filet, angles droits.
interface Props {
    class?: string;
    href?: string;
}

const { class: className, href, ...rest } = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag
    href={href}
    class:list={["block border border-line bg-background p-8", href && "transition-colors duration-300 hover:bg-surface", className]}
    {...rest}
>
    <slot />
</Tag>
