---
import type { HeadlineProps } from "../../types/types";
import SectionTitle from "./SectionTitle.astro";

const {
    title = await Astro.slots.render("title"),
    subtitle = await Astro.slots.render("subtitle"),
    tagline,
    classes = {},
    titleAs = "h2",
    align = "left",
} = Astro.props as HeadlineProps;

// Les anciennes classes de taille de titre sont ignorées : l'échelle typo vient de .t-title.
const { container: containerClass = "" } = classes;
const resolvedTitleClass = "";
---

{
    (title || subtitle || tagline) && (
        <div class={`mb-12 md:mb-16 ${containerClass}`}>
            <SectionTitle
                badge={tagline}
                title={title}
                subtitle={subtitle}
                align={align}
                as={titleAs as "h1" | "h2" | "h3"}
                titleClass={resolvedTitleClass}
            />
        </div>
    )
}
