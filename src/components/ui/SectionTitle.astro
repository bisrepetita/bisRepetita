---
// `badge` est accepté pour compatibilité mais jamais affiché (pas de surtitre).
interface Props {
    title: string;
    badge?: string;
    subtitle?: string;
    align?: "center" | "left";
    as?: "h1" | "h2" | "h3";
    class?: string;
    titleClass?: string;
}

const { title, subtitle, align = "left", as: Tag = "h2", class: className = "", titleClass = "" } = Astro.props;
---

<div class:list={["section-title", align === "center" ? "text-center mx-auto max-w-4xl" : "max-w-5xl", className]}>
    <Tag class:list={["t-title", titleClass]} data-split set:html={title} />
    {subtitle && (
        <p
            class:list={["mt-5 text-[17px] leading-relaxed text-gray-1 max-w-[560px]", align === "center" && "mx-auto"]}
            set:html={subtitle}
        />
    )}
</div>
