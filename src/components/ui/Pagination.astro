---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
    page: Page<CollectionEntry<"blog">>;
    class?: string;
}

const { page, class: className } = Astro.props;
const { currentPage, lastPage, url } = page;
const { prev, next } = url;
const arrow = (d: string) =>
    `<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`;
---

{
    (prev || next) && (
        <nav aria-label="Pagination" class:list={["mt-12 grid grid-cols-3 items-center border-t border-line pt-6 text-[15px]", className]}>
            {prev ? (
                <a href={prev} rel="prev" class="inline-flex items-center gap-2 justify-self-start hover:text-gray-1">
                    <Fragment set:html={arrow("M13 7H1M6 2 1 7l5 5")} />
                    Précédent
                </a>
            ) : (
                <span />
            )}
            <span class="t-meta justify-self-center">Page {currentPage} sur {lastPage}</span>
            {next ? (
                <a href={next} rel="next" class="inline-flex items-center gap-2 justify-self-end hover:text-gray-1">
                    Suivant
                    <Fragment set:html={arrow("M1 7h12M8 2l5 5-5 5")} />
                </a>
            ) : (
                <span />
            )}
        </nav>
    )
}
