---
import { slugify } from "../../utils/slugify";

export interface Props {
    tags: string[];
    class?: string;
}

const { tags, class: className = "text-sm" } = Astro.props;
---

{
    tags && Array.isArray(tags) && (
        <ul class:list={["flex flex-wrap gap-2", className]}>
            {tags.map((tag) => (
                <li>
                    <a
                        href={`/blog/tags/${slugify(tag)}`}
                        class="inline-block rounded-full border border-line px-3 py-1 text-gray-1 transition-colors duration-200 hover:border-ink hover:text-ink"
                    >
                        {tag}
                    </a>
                </li>
            ))}
        </ul>
    )
}
