---
// Étiquette discrète à filet (jamais en surtitre).
interface Props {
    variant?: "pill" | "circle";
    class?: string;
}

const { variant = "pill", class: className = "" } = Astro.props;

const variants = {
    pill: "px-3 py-1",
    circle: "w-8 h-8 justify-center",
};
---

<span class:list={["inline-flex items-center rounded-full border border-line text-[13px] text-gray-1", variants[variant], className]}>
    <slot />
</span>
