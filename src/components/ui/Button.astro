---
interface Props {
    variant?: "primary" | "secondary" | "tertiary" | "ghost";
    size?: "sm" | "md" | "lg";
    href?: string;
    type?: "button" | "submit" | "reset";
    class?: string;
    "aria-label"?: string;
    [key: string]: unknown;
}

const {
    variant = "primary",
    size = "md",
    href,
    type = "button",
    class: className = "",
    "aria-label": ariaLabel,
    ...rest
} = Astro.props;

// primary = pilule pleine, secondary = pilule contour, tertiary/ghost = lien souligné.
const variants = {
    primary: "btn btn-solid",
    secondary: "btn btn-line",
    tertiary: "link-line inline-flex items-center gap-2",
    ghost: "link-line inline-flex items-center gap-2",
};
const sizes = { sm: "btn-sm", md: "", lg: "" };
const isPill = variant === "primary" || variant === "secondary";
const Tag = href ? "a" : "button";
---

<Tag
    type={href ? undefined : type}
    href={href}
    class:list={[variants[variant], isPill && sizes[size], "disabled:opacity-40 disabled:pointer-events-none", className]}
    aria-label={ariaLabel}
    {...rest}
>
    <slot />
</Tag>
