---
import { siteConfig } from "../../config/site";
const { contact, socialLinks, footerLinks } = siteConfig;
const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="wrap footer-top">
        <div class="footer-intro">
            <p class="t-subtitle">Une boxe technique, exigeante et accessible, au cœur de Genève.</p>
            <a href="/#planning" class="btn btn-solid">
                Réserver une séance
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
            </a>
        </div>

        <nav class="footer-cols" aria-label="Pied de page">
            <div>
                <p class="t-meta">Cours</p>
                <ul>{footerLinks.services.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
            </div>
            <div>
                <p class="t-meta">Bis Repetita</p>
                <ul>{footerLinks.infos.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
            </div>
            <div>
                <p class="t-meta">Studio</p>
                <ul>
                    <li><a href="https://maps.google.com/?q=La+Voie-Creuse+16,+1202+Genève" target="_blank" rel="noopener">{contact.address}</a></li>
                    <li><a href={`tel:${contact.phone.replace(/\s/g, "")}`}>{contact.phone}</a></li>
                    <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
                    <li><a href={socialLinks.instagram} target="_blank" rel="noopener">Instagram</a></li>
                    <li><a href={socialLinks.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
                </ul>
            </div>
        </nav>
    </div>

    <div class="wrap footer-legal t-meta">
        <span>© {year} {siteConfig.name}, Genève</span>
        <a href="/cgv">Conditions générales</a>
        <a href="/contact">Contact</a>
    </div>

    <div class="wrap footer-mark" aria-hidden="true">
        <img src="/logo-black.svg" alt="" width="1600" height="234" loading="lazy" />
    </div>
</footer>

<style>
    .footer { border-top: 1px solid var(--line); padding-top: clamp(64px, 8vw, 120px); overflow: hidden; }
    .footer-top {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
        gap: clamp(48px, 6vw, 120px);
    }
    .footer-intro { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; max-width: 420px; }
    .footer-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
    .footer-cols ul { margin-top: 14px; display: grid; gap: 8px; font-size: 14px; }
    .footer-cols a { transition: color 0.3s; }
    .footer-cols a:hover { color: var(--gray-2); }
    .footer-legal {
        display: flex;
        gap: 24px;
        margin-top: clamp(64px, 8vw, 112px);
        padding-block: 18px;
        border-top: 1px solid var(--line);
    }
    .footer-legal span { margin-right: auto; }
    .footer-legal a:hover { color: var(--ink); }
    .footer-mark { padding-bottom: clamp(16px, 2vw, 32px); }
    .footer-mark img { width: 100%; height: auto; display: block; }

    @media (max-width: 860px) {
        .footer-top { grid-template-columns: 1fr; }
        .footer-cols { grid-template-columns: 1fr 1fr; }
        .footer-cols > div:last-child { grid-column: 1 / -1; }
        .footer-legal { flex-wrap: wrap; gap: 8px 20px; }
        .footer-legal span { width: 100%; }
    }
</style>
