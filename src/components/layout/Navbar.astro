---
import { siteConfig } from "../../config/site";
import { Image } from "astro:assets";

import nicolasPortrait from "../../assets/nicolas-portrait.webp";
import lionelNicolas from "../../assets/lionel-nicolas-boxe.webp";
import cours2Landscape from "../../assets/cours-2-landscape.webp";
import ambianceBis from "../../assets/ambiance-bis-repetita.webp";
import imageCta from "../../assets/image-cta.webp";

const panelImages: Record<string, ImageMetadata> = {
    "nicolas-portrait.webp": nicolasPortrait,
    "lionel-nicolas-boxe.webp": lionelNicolas,
    "cours-2-landscape.webp": cours2Landscape,
    "ambiance-bis-repetita.webp": ambianceBis,
    "image-cta.webp": imageCta,
};

const { navCours, navLinks, navCta } = siteConfig;
const allItems = navCours.doors.flatMap((d) => d.items);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => href !== "/#planning" && (path === href || (href !== "/" && path.startsWith(href + "/")));
const coursActive = path.startsWith("/services");
---

<header id="site-nav" class="nav" data-open="false">
    <div class="nav-bar wrap">
        <a href="/" class="nav-logo" aria-label="Bis Repetita — accueil">
            <img src="/logo-black.svg" alt="" width="140" height="20" />
        </a>

        <nav class="nav-links" aria-label="Navigation principale">
            <button
                type="button"
                class="nav-link nav-cours-btn"
                aria-expanded="false"
                aria-controls="cours-panel"
                aria-current={coursActive ? "page" : undefined}
            >
                Cours
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
            </button>
            {navLinks.map((l) => (
                <a href={l.href} class="nav-link" aria-current={isCurrent(l.href) ? "page" : undefined}>{l.text}</a>
            ))}
        </nav>

        <div class="nav-actions">
            <a href={navCta.href} class="btn btn-solid btn-sm nav-cta">{navCta.text}</a>
            <button type="button" class="nav-menu-btn" aria-expanded="false" aria-controls="mobile-menu">
                <span class="nav-menu-label">Menu</span>
            </button>
        </div>
    </div>

    <!-- Panneau Cours (desktop) -->
    <div id="cours-panel" class="cours-panel" hidden>
        <div class="wrap cours-grid">
            {navCours.doors.map((door) => (
                <div class="cours-col">
                    <a href={door.href} class="cours-door" data-preview={door.items[0].image}>
                        {door.label}
                        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
                    </a>
                    <ul>
                        {door.items.map((item) => (
                            <li>
                                <a href={item.href} class="cours-item" data-preview={item.image}>
                                    <span>{item.text}</span>
                                    <span class="t-meta">{item.meta}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
            <div class="cours-preview nb" aria-hidden="true">
                {[...new Set(allItems.map((i) => i.image))].map((key, i) => (
                    <Image
                        src={panelImages[key]}
                        alt=""
                        widths={[480, 720]}
                        sizes="24vw"
                        data-key={key}
                        class:list={[{ "is-on": i === 0 }]}
                        loading="lazy"
                    />
                ))}
            </div>
        </div>
        <div class="wrap cours-foot">
            <div class="cours-more">
                {navCours.more.map((m) => <a href={m.href} class="link-line">{m.text}</a>)}
            </div>
            <a href={navCours.href} class="t-meta cours-all">Tous les cours</a>
        </div>
    </div>

    <!-- Menu mobile -->
    <div id="mobile-menu" class="mobile-menu" hidden>
        <div class="wrap mobile-inner">
            <p class="t-meta">Cours</p>
            <ul class="mobile-cours">
                {navCours.doors.map((door) => (
                    <li>
                        <a href={door.href} class="mobile-door">{door.label}</a>
                        <ul>
                            {door.items.map((item) => (
                                <li><a href={item.href}>{item.text}</a></li>
                            ))}
                        </ul>
                    </li>
                ))}
            </ul>
            <ul class="mobile-main">
                {navLinks.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
                {navCours.more.map((m) => <li><a href={m.href} class="mobile-small">{m.text}</a></li>)}
            </ul>
            <div class="mobile-foot">
                <a href={navCta.href} class="btn btn-solid">{navCta.text}</a>
                <a href={`tel:${siteConfig.contact.phone.replace(/\s/g, "")}`} class="t-meta">{siteConfig.contact.phone}</a>
            </div>
        </div>
    </div>
</header>
<div class="nav-scrim" aria-hidden="true"></div>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--bg);
        transition: transform 0.6s var(--ease-out-expo), box-shadow 0.3s;
    }
    .nav[data-scrolled="true"] { box-shadow: 0 1px 0 var(--line); }
    .nav[data-hidden="true"]:not([data-open="true"]) { transform: translateY(-100%); }

    .nav-bar {
        height: var(--nav-h);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 24px;
    }
    .nav-logo img { height: 19px; width: auto; display: block; }

    .nav-links { display: flex; align-items: center; gap: 30px; }
    .nav-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        color: var(--ink);
        padding: 8px 0;
        cursor: pointer;
    }
    .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 2px;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.5s var(--ease-out-expo);
    }
    .nav-link:hover::after,
    .nav-link[aria-current="page"]::after,
    .nav-cours-btn[aria-expanded="true"]::after { transform: scaleX(1); transform-origin: left; }
    .nav-cours-btn svg { transition: transform 0.4s var(--ease-out-expo); }
    .nav-cours-btn[aria-expanded="true"] svg { transform: rotate(180deg); }

    .nav-actions { display: flex; justify-content: flex-end; align-items: center; gap: 16px; }
    .nav-menu-btn { display: none; font-size: 14px; padding: 8px 0; }

    /* Panneau */
    .cours-panel {
        position: absolute;
        inset: 100% 0 auto 0;
        background: var(--bg);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        clip-path: inset(0 0 100% 0);
        transition: clip-path 0.7s var(--ease-out-expo);
    }
    .cours-panel[data-shown="true"] { clip-path: inset(0 0 0 0); }
    .cours-grid {
        display: grid;
        grid-template-columns: 1fr 1fr minmax(220px, 0.8fr);
        gap: var(--gutter);
        padding-block: 40px 32px;
    }
    .cours-door {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: clamp(1.75rem, 2.6vw, 2.5rem);
        font-weight: 500;
        letter-spacing: var(--track-title);
        line-height: 1;
        margin-bottom: 28px;
    }
    .cours-door svg { transition: transform 0.5s var(--ease-out-expo); }
    .cours-door:hover svg { transform: translate(3px, -3px); }
    .cours-col ul { border-top: 1px solid var(--line); }
    .cours-item {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
        font-size: 17px;
        letter-spacing: -0.02em;
        transition: padding 0.5s var(--ease-out-expo), color 0.3s;
    }
    .cours-item:hover, .cours-item:focus-visible { padding-left: 10px; }
    .cours-col:has(.cours-item:hover) .cours-item:not(:hover) { color: var(--gray-3); }

    .cours-preview { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); }
    .cours-preview :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.04);
        transition: opacity 0.6s var(--ease-out-expo), transform 1.2s var(--ease-out-expo);
    }
    .cours-preview :global(img.is-on) { opacity: 1; transform: scale(1); }

    .cours-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-block: 18px 22px;
        border-top: 1px solid var(--line);
        font-size: 14px;
    }
    .cours-more { display: flex; gap: 28px; }
    .cours-all:hover { color: var(--ink); }

    .nav-scrim {
        position: fixed;
        inset: 0;
        z-index: 40;
        background: rgba(10, 10, 10, 0.18);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s var(--ease-out-expo);
    }
    :global(body[data-nav-open="true"]) .nav-scrim { opacity: 1; pointer-events: auto; }

    /* Mobile */
    .mobile-menu {
        position: fixed;
        inset: var(--nav-h) 0 0 0;
        background: var(--bg);
        overflow-y: auto;
        border-top: 1px solid var(--line);
    }
    .mobile-inner { padding-block: 28px 40px; display: flex; flex-direction: column; gap: 32px; min-height: 100%; }
    .mobile-cours { display: grid; gap: 22px; margin-top: -18px; }
    .mobile-door { font-size: 34px; font-weight: 500; letter-spacing: var(--track-title); line-height: 1.1; }
    .mobile-cours ul { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 8px; color: var(--gray-1); font-size: 15px; }
    .mobile-main { border-top: 1px solid var(--line); }
    .mobile-main a { display: block; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 20px; letter-spacing: -0.02em; }
    .mobile-main a.mobile-small { font-size: 16px; color: var(--gray-1); }
    .mobile-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; }

    @media (max-width: 960px) {
        .nav-bar { grid-template-columns: 1fr auto; }
        .nav-links, .cours-panel { display: none; }
        .nav-menu-btn { display: inline-flex; }
    }
    @media (max-width: 420px) {
        .nav-cta { display: none; }
    }
</style>

<script>
    function setupNav() {
        const nav = document.getElementById("site-nav");
        if (!nav || nav.dataset.ready) return;
        nav.dataset.ready = "1";

        const coursBtn = nav.querySelector<HTMLButtonElement>(".nav-cours-btn");
        const panel = document.getElementById("cours-panel");
        const menuBtn = nav.querySelector<HTMLButtonElement>(".nav-menu-btn");
        const menu = document.getElementById("mobile-menu");
        const menuLabel = nav.querySelector(".nav-menu-label");
        const scrim = document.querySelector<HTMLElement>(".nav-scrim");
        let closeTimer: number | undefined;

        const setOpen = (open: boolean) => {
            nav.dataset.open = String(open);
            document.body.dataset.navOpen = String(open);
        };

        const openPanel = () => {
            if (!panel || !coursBtn) return;
            window.clearTimeout(closeTimer);
            panel.hidden = false;
            requestAnimationFrame(() => (panel.dataset.shown = "true"));
            coursBtn.setAttribute("aria-expanded", "true");
            setOpen(true);
        };
        const closePanel = () => {
            if (!panel || !coursBtn || coursBtn.getAttribute("aria-expanded") === "false") return;
            panel.dataset.shown = "false";
            coursBtn.setAttribute("aria-expanded", "false");
            setOpen(false);
            closeTimer = window.setTimeout(() => (panel.hidden = true), 500);
        };

        coursBtn?.addEventListener("click", () =>
            coursBtn.getAttribute("aria-expanded") === "true" ? closePanel() : openPanel(),
        );
        // Survol souris : ouverture directe, fermeture avec un court délai.
        const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
        if (fine.matches) {
            coursBtn?.addEventListener("mouseenter", openPanel);
            nav.addEventListener("mouseleave", () => {
                closeTimer = window.setTimeout(closePanel, 180);
            });
            panel?.addEventListener("mouseenter", () => window.clearTimeout(closeTimer));
        }
        scrim?.addEventListener("click", () => {
            closePanel();
            closeMenu();
        });

        // Photo de prévisualisation
        const imgs = panel?.querySelectorAll<HTMLImageElement>(".cours-preview img") ?? [];
        panel?.querySelectorAll<HTMLElement>("[data-preview]").forEach((a) => {
            const show = () => imgs.forEach((img) => img.classList.toggle("is-on", img.dataset.key === a.dataset.preview));
            a.addEventListener("mouseenter", show);
            a.addEventListener("focus", show);
        });

        // Mobile
        const openMenu = () => {
            if (!menu || !menuBtn) return;
            menu.hidden = false;
            menuBtn.setAttribute("aria-expanded", "true");
            if (menuLabel) menuLabel.textContent = "Fermer";
            document.documentElement.style.overflow = "hidden";
            nav.dataset.open = "true";
        };
        function closeMenu() {
            if (!menu || !menuBtn) return;
            menu.hidden = true;
            menuBtn.setAttribute("aria-expanded", "false");
            if (menuLabel) menuLabel.textContent = "Menu";
            document.documentElement.style.overflow = "";
            nav!.dataset.open = "false";
        }
        menuBtn?.addEventListener("click", () => (menu?.hidden ? openMenu() : closeMenu()));
        menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));

        document.addEventListener("keydown", (e) => {
            if (e.key !== "Escape") return;
            if (coursBtn?.getAttribute("aria-expanded") === "true") {
                closePanel();
                coursBtn.focus();
            }
            if (menu && !menu.hidden) {
                closeMenu();
                menuBtn?.focus();
            }
        });

        // Se cache en descendant, revient en remontant.
        let lastY = window.scrollY;
        window.addEventListener(
            "scroll",
            () => {
                const y = window.scrollY;
                nav.dataset.scrolled = String(y > 8);
                if (Math.abs(y - lastY) > 6) {
                    nav.dataset.hidden = String(y > lastY && y > 240);
                    if (y > lastY) closePanel();
                    lastY = y;
                }
            },
            { passive: true },
        );
    }
    setupNav();
    document.addEventListener("astro:page-load", setupNav);
</script>
