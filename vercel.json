{
  "trailingSlash": false,
  "redirects": [
    { "source": "/cours-gratuit", "destination": "/services/round-by-round", "permanent": true },
    { "source": "/about", "destination": "/equipe/nicolas-de-boccard", "permanent": true },
    { "source": "/nicolas-de-boccard", "destination": "/equipe/nicolas-de-boccard", "permanent": true },
    { "source": "/blog/cours-de-boxe-geneve-guide-debutant", "destination": "/cours-de-boxe-geneve", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ]
}
